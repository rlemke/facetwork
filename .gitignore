# AgentFlow runtime config — ignore ALL .env* (may hold secrets, incl. the
# fleet-agent's decrypted-cred temp files .env.fleet-agent.*), except the
# committed template/preset files that are meant to be tracked.
.env*
!.env.example
!.env.fleet.example
!.env.fleet.override.example
!.env.fleet.preset
!.env.full-stack.example
