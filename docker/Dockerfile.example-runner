# Generic per-example Facetwork runner.
#
# One image; the example to run is passed via AFL_EXAMPLE_NAME. The
# example's source (one of the fwh_* repos) is bind-mounted at
# /handlers/$AFL_EXAMPLE_REPO and pip-installed at container start by
# entrypoint-example-runner.sh.
#
# Why bind-mount + install at start, instead of baking the example
# into the image? Two reasons:
#   1. Each runner stays in lockstep with the developer's local checkout
#      under ~/fw_handlers — no rebuild needed for handler edits.
#   2. One image works for all 8+ examples — compose just picks the
#      name via env var. New examples added to the registry need no
#      Dockerfile change.

FROM python:3.12-slim

WORKDIR /app

# Build-time system packages.  osmium-tool is needed by the OSM
# example pipelines; git is needed only if the entrypoint falls back
# to `git clone` for an example whose source dir isn't bind-mounted.
RUN apt-get update && apt-get install -y --no-install-recommends \
        osmium-tool \
        git \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# tippecanoe — builds the vector tiles for osm.Tiles.BuildVectorTiles.
# It is NOT packaged in Debian apt, so build the pinned release from
# source, then drop the build toolchain (keeping only the runtime libs
# tippecanoe links: libsqlite3-0, zlib1g) to keep the image slim.
#
# This MUST live in the image, not be hand-installed in a container:
# the OSM runner is scaled to N replicas that race the same task list,
# so a tippecanoe missing from any replica makes tile-build tasks
# dead-letter when they happen to land there (pet-vs-cattle trap).
ARG TIPPECANOE_VERSION=2.53.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential libsqlite3-dev zlib1g-dev \
    && git clone --depth 1 --branch "${TIPPECANOE_VERSION}" \
        https://github.com/felt/tippecanoe.git /tmp/tippecanoe \
    && make -C /tmp/tippecanoe -j"$(nproc)" \
    && make -C /tmp/tippecanoe install \
    && rm -rf /tmp/tippecanoe \
    && apt-get purge -y build-essential libsqlite3-dev zlib1g-dev \
    && apt-get install -y --no-install-recommends libsqlite3-0 zlib1g \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && tippecanoe --version

# pmtiles CLI — converts tippecanoe's .mbtiles output into the .pmtiles
# archives the MapLibre viewers Range-fetch (osm.viz.RenderTiledMap via
# osm.Tiles.BuildVectorTiles). Like tippecanoe it is NOT in Debian apt;
# without it BuildVectorTiles silently falls back to .mbtiles and the
# browser's PMTiles client cannot read the layer (routes/lines vanish).
# Same pet-vs-cattle reason it must be in the image, not hand-installed.
# Pinned prebuilt release from protomaps/go-pmtiles.
ARG PMTILES_VERSION=1.30.3
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
         amd64) PM_ARCH=x86_64 ;; \
         arm64) PM_ARCH=arm64 ;; \
         *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/pmtiles.tar.gz \
        "https://github.com/protomaps/go-pmtiles/releases/download/v${PMTILES_VERSION}/go-pmtiles_${PMTILES_VERSION}_Linux_${PM_ARCH}.tar.gz" \
    && tar -xzf /tmp/pmtiles.tar.gz -C /usr/local/bin pmtiles \
    && rm /tmp/pmtiles.tar.gz \
    && chmod +x /usr/local/bin/pmtiles \
    && pmtiles version

# GraphHopper routing-graph builds (osm.ops.GraphHopper.BuildGraph) shell out
# to `java -jar graphhopper-web.jar import`. Both a JRE (17+) and the pinned
# GraphHopper 8.0 server jar MUST live in the image: the osm runners are scaled
# to N replicas racing the same task list, so a runner missing Java or the jar
# would dead-letter every state graph-build that lands on it (same pet-vs-cattle
# reason as tippecanoe/pmtiles above). The version MUST match GRAPHHOPPER_VERSION
# in fwh_osm tools/_osm_tools/graphhopper_build.py. default-jre-headless on
# bookworm is OpenJDK 17.
ARG GRAPHHOPPER_VERSION=8.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends default-jre-headless \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/graphhopper \
    && curl -fsSL -o /opt/graphhopper/graphhopper-web.jar \
        "https://repo1.maven.org/maven2/com/graphhopper/graphhopper-web/${GRAPHHOPPER_VERSION}/graphhopper-web-${GRAPHHOPPER_VERSION}.jar" \
    && java -version
ENV GRAPHHOPPER_JAR=/opt/graphhopper/graphhopper-web.jar

# Install facetwork from the build context.  Optional extras commonly
# needed across examples (folium / pyshp / osm2geojson / requests)
# come along for free. The `s3` extra (boto3) MUST be baked in: the OSM
# runners write their cache + output to MinIO/S3, and scaled replicas all
# race the same task list — a replica without boto3 would dead-letter every
# storage write (same pet-vs-cattle reason as tippecanoe/pmtiles above).
COPY pyproject.toml .
COPY facetwork/ ./facetwork/
RUN pip install --no-cache-dir -e ".[mongodb,s3]" \
    && pip install --no-cache-dir requests pyshp folium osm2geojson

# Bake the osm-geocoder example (fwh_osm) INTO the image so handler code ships
# via `fleet set --image` — the one deploy channel that reaches every fleet
# server without SSH/git-pull. The entrypoint prefers this baked copy over any
# (possibly stale) bind-mount for examples listed in /etc/afl-baked-examples, so
# a rollout alone updates handler code fleet-wide. Editable install keeps the
# source tree on disk (the _osm_tools shim adds it to sys.path) and pulls
# fwh_osm's own deps at build time. Pin a specific commit with
# --build-arg FWH_OSM_REF=<branch|tag>.
# FWH_OSM_REF is a branch, tag, OR commit SHA. It is referenced in the RUN below,
# so changing it busts BuildKit's layer cache — pass the exact commit you want
# baked (e.g. --build-arg FWH_OSM_REF=<sha>) to guarantee a fresh clone of that
# revision rather than a cache-reused older one. A full clone (no --depth) is used
# so an arbitrary SHA can be checked out.
ARG FWH_OSM_REF=main
RUN git clone https://github.com/rlemke/fwh_osm.git /opt/fwh_osm \
    && git -C /opt/fwh_osm checkout --quiet "${FWH_OSM_REF}" \
    && pip install --no-cache-dir -e /opt/fwh_osm \
    && (cd /opt/fwh_osm && git rev-parse HEAD > /opt/fwh_osm.commit && rm -rf .git) \
    && echo "osm-geocoder" > /etc/afl-baked-examples \
    && echo "baked fwh_osm @ $(cat /opt/fwh_osm.commit)"

# Entrypoint installs the named example then starts the runner.
COPY docker/entrypoint-example-runner.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV PYTHONUNBUFFERED=1
ENV AFL_HANDLERS_ROOT=/handlers

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
