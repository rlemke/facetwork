# AgentFlow Sample Agent
FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[mongodb]" || \
    pip install --no-cache-dir lark pymongo

# Copy application code. The package is `facetwork`, not `afl`; copying it to
# ./facetwork/ matches the editable-install search path (the prior ./afl/ rename
# was a relic and broke `import facetwork` in addone_agent → crash-loop).
COPY facetwork/ ./facetwork/
COPY docker/agents/ ./agents/

ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "agents.addone_agent"]
