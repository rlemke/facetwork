# .env.worker.fleet — READY-TO-USE worker config for joining THIS fleet.
# Copy to .env.worker on each new server:  cp .env.worker.fleet .env.worker
#
# Shared MinIO + MongoDB run on the INFRA HOST below (this is the machine you
# started the full stack on). If its LAN IP changed, re-derive it on that host
# with `ipconfig getifaddr en0` (macOS) / `hostname -I` (Linux) and update the
# two URLs here — or, better, add an /etc/hosts entry on each server:
#     192.168.68.75  afl-mongodb afl-minio
# and use mongodb://afl-mongodb:27017 + http://afl-minio:9000 (survives IP changes).
#
# Infra host as of 2026-06-11: server3.local @ 192.168.68.75

# --- shared MongoDB (fleet coordinator) ---
AFL_MONGODB_URL=mongodb://192.168.68.75:27017
AFL_MONGODB_DATABASE=facetwork

# --- shared MinIO (durable cache + outputs) ---
AFL_S3_ENDPOINT=http://192.168.68.75:9000
AFL_S3_ACCESS_KEY=minioadmin
AFL_S3_SECRET_KEY=minioadmin
AFL_S3_BUCKET=afl-cache

# --- THIS server's large LOCAL scratch disk (staging stays local) ---
#   macOS: /Volumes/afl_data   Linux: e.g. /var/lib/afl_data (must exist, big)
AFL_DATA_DIR=/Volumes/afl_data

# --- runners to start on this server ---
AFL_OSM_REPLICAS=2
