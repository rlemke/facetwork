#!/usr/bin/env bash
# fw — Facetwork front-door CLI. `fw <group> <command> [args…]`.
#
# Commands are real files under scripts/lib/<group>/<command> (one nested level
# supported, e.g. `fw db postgis vacuum`). The filesystem IS the registry —
# there is nothing to keep in sync. Each command file carries a one-line
# `# fw-summary: …` comment used for listings.
set -uo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/scripts/lib/_helpers/_bootstrap.sh"

# Service URLs name shared services by their afl-* aliases. Containers map those
# through extra_hosts; a HOST resolves them only via /etc/hosts, which the fleet
# stopped pinning. Bash commands fall back to the server catalog in _env.sh, but
# Python commands read the URL straight from the environment -- so e.g.
# `fw maint workflow-stats` could not reach MongoDB from a machine where every
# bash command could. Resolve once here, for every command. Only runs when a URL
# actually names an afl-* host; a name the system resolves is left untouched.
_fw_resolve_service_urls() {
    local v urls=() out i=0 fromfile
    for v in FW_MONGODB_URL FW_S3_ENDPOINT; do
        # Same precedence as _env.sh / _dotenv.py: the environment wins, else .env.
        if [ -z "${!v:-}" ] && [ -f "$FW_ROOT/.env" ]; then
            fromfile="$(sed -nE "s/^(export[[:space:]]+)?$v=[\"']?([^\"'#[:space:]]*).*/\\2/p" "$FW_ROOT/.env" | tail -1)"
            [ -n "$fromfile" ] && export "$v=$fromfile"
        fi
        urls+=("${!v:-}")
    done
    case "${urls[*]}" in *afl-*) ;; *) return 0 ;; esac
    local py="$FW_ROOT/.venv/bin/python3"; [ -x "$py" ] || py=python3
    out="$(PYTHONPATH="$FW_ROOT${PYTHONPATH:+:$PYTHONPATH}" "$py" -m facetwork.servers \
           --resolve-url "${urls[0]:-none://}" "${urls[1]:-none://}" 2>/dev/null)" || return 0
    for v in FW_MONGODB_URL FW_S3_ENDPOINT; do
        i=$((i + 1))
        local val; val="$(printf '%s\n' "$out" | sed -n "${i}p")"
        [ -n "${!v:-}" ] && [ -n "$val" ] && export "$v=$val"
    done
    return 0
}
_fw_resolve_service_urls

# --- helpers --------------------------------------------------------------
_fw_summary() {  # $1 = file -> prints its one-line blurb
    local f="$1" s
    s="$(grep -m1 -E '^# fw-summary:' "$f" 2>/dev/null | sed 's/^# fw-summary:[[:space:]]*//')"
    [ -z "$s" ] && s="$(grep -m1 -E '^#[^!]' "$f" 2>/dev/null | sed 's/^#[[:space:]]*//' | cut -c1-72)"
    printf '%s' "$s"
}

_fw_is_listable() { case "$(basename "$1")" in _*) return 1;; *) return 0;; esac; }

_fw_list_groups() {
    echo "Facetwork CLI — fw <group> <command> [args…]"
    echo
    echo "Groups:"
    local d name
    for d in "$FW_LIB"/*/; do
        name="$(basename "$d")"
        _fw_is_listable "$d" || continue
        printf '  %-9s %s\n' "$name" "$(_fw_group_blurb "$name")"
    done
    echo
    echo "Run 'fw <group>' to list its commands, e.g. 'fw fleet'."
}

_fw_group_blurb() {  # static one-liners per group
    case "$1" in
        install) echo "install/bootstrap the toolchain, venv, examples" ;;
        single)  echo "single-machine dev stack: up/down/rebuild/reset" ;;
        db)      echo "mongo / postgres / import-pg / checks / postgis" ;;
        runner)  echo "runner lifecycle: start/stop/drain/list/scale" ;;
        fleet)   echo "multi-machine fleet: status/rollout/scale/agent" ;;
        mode)    echo "day-cluster / night-local switch: status/local/cluster/join/leave" ;;
        ffl)     echo "FFL workflows: compile/run/publish/seed/catalog" ;;
        maint)   echo "ops & maintenance: disk-guard/repair/purge/vacuum" ;;
        svc)     echo "services: dashboard / mcp / grafana" ;;
        util)    echo "misc utilities: doc-link check / map serve / pdf" ;;
        *)       echo "" ;;
    esac
}

_fw_list_group() {  # $1 = group dir
    local gdir="$1" gname; gname="$(basename "$gdir")"
    echo "fw $gname <command> [args…]"
    echo
    local e name
    for e in "$gdir"/*; do
        name="$(basename "$e")"
        _fw_is_listable "$e" || continue
        if [ -d "$e" ]; then
            printf '  %-18s (subgroup — run: fw %s %s)\n' "$name" "$gname" "$name"
        elif [ -f "$e" ]; then
            printf '  %-18s %s\n' "$name" "$(_fw_summary "$e")"
        fi
    done
}

_fw_suggest() {  # $1 = bad token, $2 = search dir — print nearest candidates
    local bad="$1" dir="$2" c name p3 hits=0
    p3="$(printf '%s' "$bad" | cut -c1-3)"
    echo "Did you mean:" >&2
    for c in "$dir"/*; do
        _fw_is_listable "$c" || continue
        name="$(basename "$c")"
        # match: substring either way, or shared 3-char prefix
        case "$name" in
            "$bad"*|*"$bad"*|"$p3"*) printf '  %s\n' "$name"; hits=$((hits+1));;
        esac
    done
    [ "$hits" -eq 0 ] && { echo "  (run 'fw $(basename "$dir")' to list commands)"; }
}

# --- dispatch -------------------------------------------------------------
case "${1:-}" in
    ""|help|-h|--help) _fw_list_groups; exit 0 ;;
    --completion-path)  echo "$FW_LIB/_helpers/fw-completion.bash"; exit 0 ;;
esac

group="$1"; shift
gdir="$FW_LIB/$group"
if [ ! -d "$gdir" ]; then
    echo "fw: unknown group '$group'" >&2
    echo "Groups: $(cd "$FW_LIB" && ls -d */ 2>/dev/null | grep -v '^_' | tr -d / | tr '\n' ' ')" >&2
    exit 2
fi

if [ $# -eq 0 ] || [ "${1:-}" = "help" ]; then
    _fw_list_group "$gdir"; exit 0
fi

sub="$1"
target="$gdir/$sub"

# nested subgroup (e.g. db postgis vacuum)
if [ -d "$target" ]; then
    shift
    if [ $# -eq 0 ] || [ "${1:-}" = "help" ]; then _fw_list_group "$target"; exit 0; fi
    sub2="$1"; nested="$target/$sub2"
    if [ -x "$nested" ]; then shift; exec "$nested" "$@"; fi
    echo "fw: unknown command '$group $sub $sub2'" >&2
    _fw_suggest "$sub2" "$target" >&2; exit 2
fi

if [ -x "$target" ]; then shift; exec "$target" "$@"; fi

echo "fw: unknown command '$group $sub'" >&2
_fw_suggest "$sub" "$gdir" >&2
exit 2
