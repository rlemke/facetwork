    {"id": "other-name", "task": {"name": "ns.Other", "task_list_name": "ns", "state": "pending"}, "claimed": false},
    {"id": "other-list", "task": {"name": "ns.Facet", "task_list_name": "elsewhere", "state": "pending"}, "claimed": false},
    {"id": "suffixed-name", "task": {"name": "ns.Facet:extra", "task_list_name": "ns", "state": "pending"}, "claimed": true},
    {"id": "regex-literal", "task": {"name": "nsXFacet:extra", "task_list_name": "ns", "state": "pending"}, "claimed": false},
    {"id": "cooldown-future", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "pending", "next_retry_after": {"rel_ms": 60000}}, "claimed": false},
    {"id": "cooldown-past", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "pending", "next_retry_after": {"rel_ms": -1000}}, "claimed": true},
    {"id": "cooldown-zero", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "pending", "next_retry_after": 0}, "claimed": true},
    {"id": "memory-fits", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "pending", "requires": {"memory_gb": 6}, "requires_dims": ["memory_gb"]}, "claimed": true},
