    {"id": "unmeasured-dimension", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "pending", "requires": {"dataset_planet_gb": 80}, "requires_dims": ["dataset_planet_gb"]}, "claimed": false},
    {"id": "empty-requires", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "pending", "requires": {}}, "claimed": true},
    {"id": "environment-tagged", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "pending", "environment_hash": "abc123"}, "claimed": false},
    {"id": "environment-empty", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "pending", "environment_hash": ""}, "claimed": true},
    {"id": "needs-feature", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "pending", "required_features": ["after"]}, "claimed": false},
    {"id": "no-features", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "pending", "required_features": []}, "claimed": true},
    {"id": "running-live-lease", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "running", "server_id": "someone", "lease_expires": {"rel_ms": 600000}}, "claimed": false},
    {"id": "running-expired-lease", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "running", "server_id": "someone", "lease_expires": {"rel_ms": -1000}, "retry_count": 1, "max_retries": 5}, "claimed": true, "retry_count_after": 2},
    {"id": "running-expired-exhausted", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "running", "server_id": "someone", "lease_expires": {"rel_ms": -1000}, "retry_count": 5, "max_retries": 5}, "claimed": false},
    {"id": "running-expired-unlimited", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "running", "server_id": "someone", "lease_expires": {"rel_ms": -1000}, "retry_count": 50, "max_retries": 0}, "claimed": true, "retry_count_after": 51},
    {"id": "running-no-lease", "task": {"name": "ns.Facet", "task_list_name": "ns", "state": "running", "server_id": "someone", "lease_expires": 0}, "claimed": false},
