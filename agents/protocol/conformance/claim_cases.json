{
  "description": "Which tasks a server may claim. Every agent library runs these against its own claim (and the Python runtime against MongoStore.claim_task) so the rule exists once, as data. Each case: insert `task`, claim as `server`, expect `claimed`. Time values given as {\"rel_ms\": N} mean now + N.",
  "server": {
    "task_names": ["ns.Facet"],
    "task_lists": ["ns", "default"],
    "resources": {"memory_gb": 8, "cpus": 4}
  },
  "cases": [
