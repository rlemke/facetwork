# AgentFlow Environment Configuration
# Copy to .env and customize. Scripts source this automatically.
# Precedence: command-line flags > env vars > .env > defaults

# MongoDB (external server at afl-mongodb, defined in /etc/hosts)
#FW_MONGODB_URL=mongodb://afl-mongodb:27017
FW_MONGODB_URL=mongodb://localhost:27017
FW_MONGODB_DATABASE=facetwork
FW_EXAMPLES_DATABASE=facetwork_examples

# Scaling
FW_RUNNERS=2
FW_AGENTS=2
FW_OSM_AGENTS=2
FW_OSM_LITE_AGENTS=2
FW_WEATHER_AGENTS=2

# Runner tuning
# FW_MAX_CONCURRENT=2
# FW_POLL_INTERVAL_MS=1000
# FW_REAPER_TIMEOUT_MS=120000   # Orphan reaper timeout (default 2min)
# FW_STUCK_TIMEOUT_MS=1800000   # Stuck task watchdog timeout (default 30min)
# FW_TASK_EXECUTION_TIMEOUT_MS=900000  # Per-task execution timeout (default 15min)
# FW_LEASE_DURATION_MS=300000   # Task lease duration (default 5min; renewed by heartbeat)

# Workflow → task list routing. Comma-separated prefix=list pairs; longest
# prefix wins. Tasks for matching workflows are submitted onto that list, and
# runners started with `--task-list <name>` will claim only those tasks. An
# empty prefix sets the global fallback (otherwise "default").
# Example: route OSM and Anthropic workflows to dedicated queues so a flooded
# OSM import can't starve Anthropic calls:

# Overlays
FW_HDFS=false
FW_POSTGIS=false
# FW_POSTGIS_URL=postgresql://afl:afl@afl-postgres:5432/afl_gis
FW_POSTGIS_URL=postgresql://afl:afl@localhost:5432/afl_gis

# Local-first PostGIS import: parse PBF into a disposable local PG instance,
# then bulk-transfer to the main server. Reduces I/O load on main PG during
# multi-hour imports. Start with: fw db import-pg
# FW_IMPORT_POSTGIS_URL=postgresql://afl_osm:afl_osm_2024@localhost:5433/osm
FW_JENKINS=false
FW_GEOFABRIK_MIRROR=/Volumes/afl_data/osm

# Base output directory for all handler output (default: /Volumes/afl_data/output)
# All example categories derive subdirectories from this (osm/, hiv-reports/, weather/, etc.)
# Temporary files also go under FW_OUTPUT_BASE/tmp/ instead of /tmp.
# FW_OUTPUT_BASE=/Volumes/afl_data/output
FW_OUTPUT_BASE=/tmp/output

# Legacy alias for FW_OUTPUT_BASE (backward compatibility)
# FW_LOCAL_OUTPUT_DIR=/Volumes/afl_data/output
FW_LOCAL_OUTPUT_DIR=/tmp/output

# Unified data root for the OSM tool set + handler caches
# (see agent-spec/cache-layout.agent-spec.yaml). Everything caches under
# $FW_DATA_ROOT/cache/<namespace>/<cache_type>/, stages under
# $FW_DATA_ROOT/staging/, and indexes lazily under $FW_DATA_ROOT/_indexes/.
# Default: /Volumes/afl_data (local) or /user/afl (hdfs).
# FW_DATA_ROOT=/Volumes/afl_data
# FW_STORAGE=local                  # local | hdfs | s3
# FW_CACHE_ROOT, FW_STAGING_ROOT, FW_TMP_ROOT, FW_INDEXES_ROOT,
# FW_LOCKS_ROOT are individually overridable if you need to split them
# across different volumes.

# OSM PBF download cache now lives under the unified data root above
# ($FW_DATA_ROOT/cache/osm). Override just the cache root with FW_CACHE_ROOT,
# or set FW_STORAGE=hdfs for HDFS. (The legacy FW_CACHE_DIR was retired.)

# S3 / MinIO shared storage (portable cache + outputs across a multi-server
# fleet — step payloads carry s3:// URIs instead of host-local paths).
# Requires the `s3` extra (boto3): pip install -e ".[s3]". For MinIO, run the
# container + create the bucket (see docs/operations/deployment.md). For real
# AWS S3, leave FW_S3_ENDPOINT unset and use the standard AWS credential chain.
# GOTCHA: keep FW_OUTPUT_BASE LOCAL (it feeds the temp dir); put durable
# artifacts on S3 via FW_DATA_ROOT + FW_OSM_OUTPUT_BASE. Scratch
# (staging/tmp/locks) auto-falls-back to local (override: FW_LOCAL_SCRATCH).
# FW_STORAGE=s3
# FW_DATA_ROOT=s3://afl-cache
# FW_OSM_OUTPUT_BASE=s3://afl-cache/osm-output
# FW_S3_ENDPOINT=http://afl-minio:9000   # fleet default name (→ infra host via
#                                         # /etc/hosts or compose alias); use
#                                         # http://localhost:9000 if MinIO is
#                                         # local; OMIT for real AWS S3
# FW_S3_ACCESS_KEY=minioadmin            # or AWS_ACCESS_KEY_ID
# FW_S3_SECRET_KEY=minioadmin            # or AWS_SECRET_ACCESS_KEY
# FW_S3_REGION=us-east-1
#
# docker-compose.full-stack.yml now BUNDLES a MinIO service and the OSM
# runners (osm-geocoder, osm-lz) default to it — their cache + output go to
# s3://afl-cache with NO external disk. Override these to point the fleet at
# a different MinIO/S3 (the defaults match the bundled service):
# FW_S3_BUCKET=afl-cache                  # bucket the osm runners write to
# MINIO_API_PORT=9000                      # host port for the S3 API
# MINIO_CONSOLE_PORT=9001                  # host port for the MinIO console

# OSM extractor output base (HDFS URI or local path; empty = FW_OUTPUT_BASE/osm)
# FW_OSM_OUTPUT_BASE=hdfs://afl-hadoop-hdfs:8020/osm-output
# FW_OSM_OUTPUT_BASE=/Volumes/afl_data/output/osm
FW_OSM_OUTPUT_BASE=/tmp/output/osm

# LLM (Claude API for prompt-block event facets)
# ANTHROPIC_API_KEY=

# Remote runner management
# FW_RUNNER_HOSTS=host1 host2 host3
# FW_REMOTE_PATH=/opt/agentflow
# FW_SSH_OPTS=

# External data dirs (leave empty for Docker volumes)
# HDFS_NAMENODE_DIR=
# HDFS_DATANODE_DIR=
# GRAPHHOPPER_DATA_DIR=
# POSTGIS_DATA_DIR=
# JENKINS_HOME_DIR=
