/** Output comparison, shipped with Facetwork.
  *
  * For asking "did this pipeline reproduce that published result?" — and
  * getting an answer more useful than a boolean.
  *
  * The motivating measurement is `fwh_gridbuilder`, which reproduced PyPSA
  * grid-builder's output and compared them by hand:
  *
  *     columns:  same (12)
  *     rows:     snakemake 832, facetwork 832
  *     row data: 0 differing (after normalising tag-key order)
  *     bytes:    differ (earth_osm tag-key order is unstable)
  *     RESULT: same data
  *
  * Read that carefully, because the whole design follows from it. The bytes
  * differ. A checksum comparison — the obvious implementation — reports FAILED
  * and is WRONG: the upstream tool does not serialise a nested dict in a stable
  * key order, so two runs of the SAME pipeline also differ byte-wise. The
  * datasets are identical; only the serialisation is unstable.
  *
  * So a reproduction check must report the HIGHEST LEVEL AT WHICH TWO OUTPUTS
  * AGREE, and what it took to get there — not whether they are identical.
  * `Tabular` walks a ladder of increasing strictness:
  *
  *     exists      -> both artifacts are present and readable
  *     schema      -> same field names
  *     cardinality -> same record count
  *     keys        -> same set of identity keys (WHICH records exist)
  *     values      -> same values per key, under the declared normalisations
  *     bytes       -> byte-identical
  *
  * ⚠️ Normalisations are DECLARED and REPORTED, never silently applied.
  * Quietly sorting keys until two files match does not demonstrate a
  * reproduction, it manufactures one. Whatever was needed to reach agreement
  * is returned in `normalised_by` so a reader can judge whether the agreement
  * is real. A comparison that has to work hard to succeed is a finding.
  *
  * ⚠️ `tolerance` exists because exact float equality is the wrong predicate
  * for most scientific output, but it is a claim about acceptable error, so it
  * is reported alongside the verdict rather than hidden in the result.
  *
  * ⚠️ A TOLERANCE IS A PER-VALUE PREDICATE AND CANNOT SEE A BIAS. Measured
  * reproducing NOAA's 1991-2020 Climate Normals from the GHCN-Daily
  * observations they derive from: all 36 values landed inside tolerance, so the
  * verdict was `values` / agree — while TMAX ran high in all 12 months
  * (+0.24 degF mean) and TMIN low in all 12 (-0.51 degF). "36 small random
  * errors" and "36 errors in the same direction" are completely different
  * claims about a reproduction; only the second says the METHOD differs.
  * So an exact sign test runs over the signed residuals and reports
  * `systematic_bias` beside the verdict. Both can be true at once: the
  * reproduction met the stated tolerance AND the method demonstrably differs.
  *
  * ⚠️ The test is PER COLUMN, never pooled. Pooling destroys the signal it
  * looks for -- TMAX high and TMIN low cancel to a balanced sign split and
  * report "no bias" while both columns are systematically wrong.
  *
  * ⚠️ ON A DISTRIBUTED RUNTIME, COMPARE THE LOGICAL OUTPUT, NOT THE TASK RECORDS.
  * Measured 2026-09-01 running the same genomics pipeline twice over three
  * samples: run 1 produced 10 tasks and 3 per-sample records, run 2 produced 11
  * tasks and 4 — because one task was RETRIED, leaving a duplicate record for
  * the same sample. The runs were in fact byte-identical once collapsed to one
  * record per key. A comparison fed raw task rows would have reported a
  * cardinality mismatch and called a perfectly reproducible pipeline
  * irreproducible. Retries are a property of the ORCHESTRATOR, not of the
  * result; deduplicate on the identity key before comparing.
  *
  * Composes with the other built-ins: `fw.http.Fetch` acquires the published
  * artifact (recording digest and provenance in its sidecar), `fw.archive.Extract`
  * unpacks it, `fw.compare.Tabular` compares, `fw.compare.Summarise` aggregates
  * a fan-out of per-file verdicts into one report.
  */
namespace fw.compare {

    /** One file-pair verdict: how far up the ladder the two agree. */
    schema Verdict {
        path: String,
        level: String,
        agree: Boolean,
        differing: Long,
        detail: String
    }

    /** Compare two record-oriented files (csv, tsv, or json-lines).
      *
      * `key_columns` names the identity of a record; with it, records are matched
      * by key so a REORDERED file still compares equal and the report can say
      * which records are missing, added or changed. Without it, records are
      * compared positionally and `normalised_by` says so — position is a weaker
      * claim and the result should not pretend otherwise.
      *
      * `sort_json_keys` normalises nested JSON blobs whose key order is unstable
      * (the grid-builder case above). `ignore_columns` drops fields that are
      * expected to differ — timestamps, absolute paths, run ids.
      *
      * `tolerance` is a RELATIVE tolerance for numeric fields; 0 means exact.
      *
      * `split_columns` explodes a column holding a DELIMITED MULTI-VALUE LIST
      * into one comparable row per element, so two artifacts that group the
      * same elements differently still match on the elements they share. A VCF
      * line `G  A,ATTTACAACC` is two alleles sharing a row: keyed on the whole
      * ALT field it matches nothing when the other release lists only `A`, and
      * the comparison reports total disagreement between artifacts that in fact
      * AGREE on one allele. Splitting CHANGES THE UNIT of `expected_count` /
      * `actual_count` from record to element, so it is reported in
      * `normalised_by` with the before-and-after counts.
      *
      * ⚠️ `out_of_scope` is the number of unmatched records lying in a key
      * partition (the first key column) that the OTHER artifact does not cover
      * at all. Measured on GIAB HG001 v3.3.2 vs v4.2.1: of 242,958 records the
      * ladder called "retired", 99,980 — 41.2% — are chrX variants, and v4.2.1
      * simply does not include chrX (the releases are named `CHROM1-X` and
      * `1_22`). Those were not retired; they are outside the newer release's
      * scope, and the two readings call for entirely different action. A
      * comparison that reports content differences between artifacts spanning
      * different key space is measuring the wrong thing, confidently — so the
      * scope difference is surfaced separately and never folded into the
      * record counts.
      *
      * Returns the highest level reached, the number of differing records, and
      * the normalisations that were required to get there.
      */
    event facet Tabular(
        expected: String,
        actual: String,
        key_columns: [String] = [],
        ignore_columns: [String] = [],
        sort_json_keys: Boolean = false,
        tolerance: Double = 0.0,
        max_examples: Long = 10,
        split_columns: [String] = [],
        split_delimiter: String = ",",
        report: String = ""
    ) => (
        level: String,
        agree: Boolean,
        differing: Long,
        expected_count: Long,
        actual_count: Long,
        out_of_scope: Long,
        systematic_bias: Boolean,
        mean_residual: Double,
        normalised_by: [String],
        report: String
    ) with Effect(kind = "io") with Cost(tier = "moderate")

    /** Aggregate many `Tabular` verdicts into one discrepancy report.
      *
      * A fan-out over 3,000 files that logs 3,000 verdicts has reported nothing
      * a person can act on. This returns the weakest level any pair reached —
      * because a reproduction is only as good as its worst file — alongside the
      * counts and a written report.
      */
    event facet Summarise(
        verdicts: [Verdict],
        title: String = "reproduction report",
        report: String = ""
    ) => (
        level: String,
        agree: Boolean,
        pairs: Long,
        disagreeing: Long,
        report: String
    ) with Effect(kind = "io") with Cost(tier = "free")
}
