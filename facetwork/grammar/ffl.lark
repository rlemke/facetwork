// AFL v1 Grammar (Lark LALR)

start: _NL* (namespace_block | top_level_decl)*

// Namespace
namespace_block: DOC_COMMENT? "namespace" QNAME "{" _NL* namespace_body "}" _NL*
namespace_body: (uses_decl | facet_decl | event_facet_decl | workflow_decl | implicit_decl | schema_decl | environment_decl)*

uses_decl: ("uses" | "use") QNAME _stmt_end

// Top-level declarations
top_level_decl: facet_decl | event_facet_decl | workflow_decl | implicit_decl

facet_decl: DOC_COMMENT? "facet" facet_sig in_env_clause? facet_def_tail? catch_clause? _stmt_end
event_facet_decl: DOC_COMMENT? "event" "facet" facet_sig in_env_clause? facet_def_tail? catch_clause? _stmt_end
workflow_decl: DOC_COMMENT? "workflow" facet_sig in_env_clause? facet_def_tail? catch_clause? _stmt_end

// `in environment NAME` — binds a script-bearing declaration to a named
// execution environment (docs/architecture/script-environments.md).
//
// `environment` is matched as a plain IDENT (and validated in the
// transformer) so it stays a CONTEXTUAL keyword: `environment` remains
// usable as a parameter/field/argument name, which real domains rely on
// (e.g. jenkins.deploy.DeployToEnvironment(environment: String)).
in_env_clause: "in" IDENT QNAME _NL*

// Facet signature.  Mixin sigs may appear on the same line as the
// return clause or on separate lines.
facet_sig: IDENT "(" [params] ")" [return_clause] _NL* (mixin_sig _NL*)*
return_clause: "=>" "(" [params] ")"

// Parameters (allow newlines)
params: _NL* param (_NL* "," _NL* param)* _NL*
param: IDENT ":" type ("=" expr)?

type: array_type | TYPE_BUILTIN | QNAME
array_type: "[" type "]"

mixin_sig: "with" QNAME "(" [named_args] ")" ["as" IDENT]

// andThen blocks, prompt blocks, and script blocks
//
// The introducer for prompt blocks is matched as a plain IDENT
// (semantic check enforces it must be `prompt`) rather than as a
// hard keyword, so `prompt` remains usable as an ordinary identifier
// elsewhere in the language — param names, schema field names, etc.
// Same trick for the three directive keywords (system / template /
// model) inside the prompt block, and for the `python` script-block
// dialect tag.
facet_def_tail: _NL* "script" script_block _NL* andthen_clause*
              | andthen_clause+
              | _NL* IDENT prompt_block         -> facet_def_tail_prompt

andthen_clause: "andThen" foreach_clause? block
              | "andThen" _NL* "script" script_block _NL*  -> andthen_script
              | "andThen" _NL* "when" when_block             -> andthen_when

// `foreach v in xs limit N` — N caps how many iterations may be in
// flight at once (a bulkhead on fan-out width). The same set of
// iterations always runs; only the concurrency changes.
//
// `limit` is matched as a plain IDENT and validated in the transformer,
// keeping it a CONTEXTUAL keyword — six existing domain .ffl files use
// `limit` as an ordinary parameter name, which reserving it would break.
foreach_clause: "foreach" IDENT "in" reference foreach_limit?
// Accepts any literal, not just INTEGER, so `limit "8"` reaches the
// validator as FOREACH_LIMIT_NOT_INTEGER (with a docs_uri) instead of
// dying as an opaque parse error.
foreach_limit: IDENT (literal | reference)

// Prompt blocks for LLM-based event facets.
// `prompt_directive` accepts `IDENT STRING` and the transformer
// validates IDENT ∈ {system, template, model}. Keeps these words
// available as ordinary identifiers (param names, field names,
// named-arg keys) outside prompt-block scope.
prompt_block: "{" _NL* prompt_body "}"
prompt_body: (prompt_directive _NL*)*
prompt_directive: IDENT STRING

// Script blocks for inline code execution. `IDENT STRING` accepts
// the dialect tag (only `python` is recognised today, validated in
// the transformer) without burning `python` as a hard keyword.
script_block: STRING
            | _NL* IDENT STRING                 -> script_dialect

block: "{" _NL* block_body "}" _NL*
// Inline diagnostic statements (sys.log, sys.assert) are interleaved
// with step statements.  They produce no value and create no step row;
// the andThen evaluator runs them inline as side effects.
block_body: (block_stmt _NL*)* (yield_stmt _NL*)*
block_stmt: step_stmt | sys_log_stmt | sys_assert_stmt
sys_log_stmt: "sys" "." "log" "(" [named_args] ")"
sys_assert_stmt: "sys" "." "assert" "(" expr ")"

// When blocks for conditional branching
when_block: "{" _NL* when_case+ "}" _NL*
when_case: "case" when_condition "=>" block        -> when_case_expr
         | "case" "_" "=>" block                   -> when_case_default
when_condition: expr
step_stmt: IDENT "=" call_expr after_clause? step_body* catch_clause?

// `after A, B` — an explicit ordering edge for an INVISIBLE dependency (one
// that flows through a side channel the compiler can't see: a shared cache
// prefix, an object-store path, a scratch dir). Data references already create
// edges, so `after` is never needed when a value flows between the steps.
//
// `after` is a CONTEXTUAL keyword: matched as IDENT and validated in the
// transformer, so it stays usable as a parameter/field/step name. (Matching it
// as a literal would reserve the word FFL-wide — the bug that made
// jenkins.deploy's `environment` parameter unparseable.)
//
// Targets are BARE STEP NAMES, not expressions: `after data`, never
// `after data.count`.
// The comma must sit on the SAME line as the target before it (a newline may
// follow it, for wrapping). Allowing `_NL*` BEFORE the comma makes the target
// list ambiguous with the next statement under LALR(1): after `after a\n` the
// parser cannot tell a continued list from a new statement.
after_clause: IDENT after_targets
after_targets: after_target ("," _NL* after_target)*
// A dotted path parses so the VALIDATOR can reject it with a precise message
// (AFTER_NOT_A_STEP: "write 'after data', not 'after data.count'") instead of a
// bare syntax error. `after` takes step names, never attributes.
after_target: IDENT ("." IDENT)*
step_body: "andThen" foreach_clause? block
         | "andThen" _NL* "when" when_block             -> step_body_when

// Catch clauses for error recovery
catch_clause: CATCH_KW block                    -> catch_simple
            | CATCH_KW _NL* "when" when_block   -> catch_when

// A single yield may target multiple facets/mixins by reusing the
// `with` chain syntax that call expressions already accept. The
// transformer expands the chain into one YieldStmt per target so
// downstream consumers see a flat list. Each target must still be a
// distinct facet/mixin (YIELD_DUPLICATE_TARGET applies). Authors
// may stack `with` clauses on separate lines, the same way
// statement-level call expressions allow it.
yield_stmt: "yield" call_expr

// Call expressions
call_expr: QNAME "(" [named_args] ")" mixin_call*
mixin_call: "with" QNAME "(" [named_args] ")" ["as" IDENT]

// Arguments (allow newlines)
named_args: _NL* named_arg (_NL* "," _NL* named_arg)* _NL*
// `+=` is meaningful only in a `yield` inside a `foreach`, where it AGGREGATES
// across iterations instead of overwriting (YIELD_APPEND_OUTSIDE_YIELD rejects
// it elsewhere). It is accepted by the shared arg rule rather than a separate
// yield-only rule so that misuse is a validator diagnostic naming the reason,
// not a parse error pointing at a token.
named_arg: IDENT "=" _NL* expr
         | IDENT "+=" _NL* expr    -> named_arg_append

// Expressions (lowest to highest precedence)
expr: or_expr
or_expr: and_expr ("||" _NL* and_expr)*
and_expr: comparison_expr ("&&" _NL* comparison_expr)*
comparison_expr: concat_expr (compare_op _NL* concat_expr)?
// Comparison operators include the standard relational set plus the
// containment/string-match keywords (`in`, `not in`, `contains`,
// `startsWith`, `endsWith`).  All are non-associative — exactly one
// operator may appear, like `a == b`.
compare_op: COMP_OP                  -> compare_op_basic
          | "in"                     -> compare_op_in
          | "not" "in"               -> compare_op_not_in
          | "contains"               -> compare_op_contains
          | "startsWith"             -> compare_op_starts_with
          | "endsWith"               -> compare_op_ends_with
concat_expr: additive_expr ("++" _NL* additive_expr)*
additive_expr: multiplicative_expr (ADD_OP _NL* multiplicative_expr)*
multiplicative_expr: unary_expr (MUL_OP _NL* unary_expr)*
unary_expr: ADD_OP unary_expr | "!" unary_expr -> not_expr | postfix_expr
postfix_expr: atom_expr ("[" expr "]")*
atom_expr: literal | reference | array_literal | map_literal | "(" expr ")"

// Collection literals
array_literal: "[" _NL* (expr (_NL* "," _NL* expr)* _NL*)? "]"
map_literal: "#{" _NL* (map_entry (_NL* "," _NL* map_entry)* _NL*)? "}"
map_entry: (STRING | IDENT) ":" _NL* expr

COMP_OP.2: "==" | "!=" | ">=" | "<=" | ">" | "<"
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"

reference: INPUT_REF | step_ref
step_ref: IDENT ("." IDENT)*
// One-or-more leading "$": $ = immediate container, $$ = up one, $$$ = up two, ...
INPUT_REF: /\$+/ "." IDENT ("." IDENT)*

literal: STRING | FLOAT | INTEGER | BOOLEAN | NULL

// Schema declarations
schema_decl: DOC_COMMENT? "schema" IDENT "{" _NL* [schema_fields] "}" _stmt_end
schema_fields: schema_field (_NL* "," _NL* schema_field)* _NL*
schema_field: IDENT ":" type

// Environment declarations (docs/architecture/script-environments.md)
// The `environment` introducer is matched as a plain IDENT and validated
// in the transformer, keeping it a contextual keyword (see in_env_clause).
environment_decl: DOC_COMMENT? IDENT IDENT "{" _NL* [env_fields] "}" _stmt_end
env_fields: env_field (_NL* "," _NL* env_field)* _NL*
env_field: IDENT "=" env_value
?env_value: STRING
          | env_value_list
env_value_list: "[" _NL* [env_strings] "]"
env_strings: STRING (_NL* "," _NL* STRING)* _NL*

// Implicit declarations
implicit_decl: "implicit" IDENT "=" call_expr _stmt_end

// Statement terminator (newline or semicolon, both optional in many contexts)
_stmt_end: (_NL+ | ";" _NL* | )

// Terminals - order matters for priority
// Keywords and literals must come before IDENT
CATCH_KW.2: "catch"
BOOLEAN.2: "true" | "false"
NULL.2: "null"
TYPE_BUILTIN.2: "String" | "Long" | "Int" | "Double" | "Boolean" | "Json"

STRING: "\"" _STRING_INNER* "\""
_STRING_INNER: /[^"\\]/ | _ESCAPE
_ESCAPE: "\\" /./

FLOAT.2: /[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?/

INTEGER: /[0-9]+/

IDENT: /[A-Za-z_][A-Za-z0-9_]*/
QNAME: IDENT ("." IDENT)*

// Comments
COMMENT: "//" /[^\n]/*
DOC_COMMENT.3: /\/\*\*[\s\S]*?\*\/([ \t]*(\r?\n))*/
BLOCK_COMMENT: "/*" /(.|\n)*?/ "*/"

// Whitespace and newlines
_NL: /(\r?\n)+/
%import common.WS_INLINE
%ignore WS_INLINE
%ignore COMMENT
%ignore BLOCK_COMMENT
