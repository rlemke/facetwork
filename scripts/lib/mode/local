#!/usr/bin/env bash
# fw-summary: run the WHOLE stack on this machine (own Mongo/MinIO/registry); recreate runners (Model B)
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
source "$FW_LIB/mode/_lib.sh"

# ⚠️ REJECT an unknown argument. This used to be a bare `[ "$1" = "--dry" ]`, so
# `fw mode local --dry-run` silently performed the REAL switch -- flipping infra
# and recreating 23 containers on a command the operator believed was a preview.
# Measured 2026-09-18. A flag that is ignored is worse than one that errors,
# especially where the difference is "preview" vs "change the whole host".
DRY=0
while [ $# -gt 0 ]; do
    case "$1" in
        --dry|--dry-run|-n) DRY=1; shift ;;
        -h|--help)
            echo "Usage: fw mode local [--dry]"
            echo "  --dry, --dry-run, -n   print what would change; change nothing"
            exit 0 ;;
        *)
            echo "fw mode local: unknown argument '$1'" >&2
            echo "  did you mean --dry ?  (nothing was changed)" >&2
            exit 2 ;;
    esac
done
# Standalone: infra + runners all on this host. Idempotent — safe to re-run.
_mode_apply local "$DRY"
