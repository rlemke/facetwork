#!/usr/bin/env bash
# fw-summary: show the active mode (local/cluster) + where infra resolves + runner state
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
source "$FW_LIB/mode/_lib.sh"

active="$(_mode_active)"
echo "Active mode: $active"
echo

# What the live config points at (env + server catalog), and what it resolves to.
reg="$(grep -m1 -E '^FW_FLEET_REGISTRY=' "$FW_ROOT/.env" 2>/dev/null | cut -d= -f2-)"
[ -z "$reg" ] && reg="$(grep -m1 -E '^FW_FLEET_REGISTRY=' "$FW_ROOT/.env.fleet" 2>/dev/null | cut -d= -f2-)"
infra_ip="$(grep -m1 -E '^FW_INFRA_IP=' "$FW_ROOT/.env.fleet" 2>/dev/null | cut -d= -f2-)"
infra_host="$(grep -m1 -E '^FW_INFRA_HOST=' "$FW_ROOT/.env.fleet" 2>/dev/null | cut -d= -f2-)"

# Resolve LIVE rather than trusting the file: FW_INFRA_IP is written once per
# `fw mode` switch, so on a machine that reboots onto a new DHCP lease the file
# is the one thing guaranteed to be stale. Everything that creates containers
# re-resolves at start time, and this must report what they will actually use.
live_ip="$(_mode_resolve_ip "${infra_host:-}")"
container_ip="$(_mode_container_ip "${infra_host:-}")"
probe_ip="$live_ip"; [ -z "$probe_ip" ] && probe_ip="$infra_ip"

echo "Config (what runners + CLI use):"
printf '  %-18s %s\n' "infra host"     "${infra_host:-<unset>}"
# A file value that matches neither the live address nor what containers use is
# a stale pin from an earlier network — say so instead of reporting it as truth.
stale=""
[ -n "$infra_ip" ] && [ "$infra_ip" != "$live_ip" ] && [ "$infra_ip" != "$container_ip" ] \
    && stale="   ⚠️ .env.fleet pins a stale $infra_ip"
printf '  %-18s %s\n' "infra IP"       "${live_ip:-<unresolved>} (live)$stale"
printf '  %-18s %s\n' "containers use" "${container_ip:-<unresolved>}  (afl-mongodb/afl-minio -> here)"
printf '  %-18s %s\n' "image registry" "${reg:-server3.local:5050 (default)}"
if [ -f "$FW_ROOT/servers.local.json" ]; then
    printf '  %-18s %s\n' "server catalog" "servers.local.json present (overrides infra resolution)"
else
    printf '  %-18s %s\n' "server catalog" "servers.json only (committed defaults)"
fi

echo
echo "Reachability:"
# ⚠️ Probe the MONGO host, not the infra host. There has been no single infra
# machine since 2026-09-13 (Mongo moved off it, MinIO stayed), so probing the
# infra IP for :27017 asks the wrong box and reported UNREACHABLE against a
# perfectly healthy cluster. Derive the host from FW_MONGODB_URL and resolve it
# the way everything else does -- through the server catalog.
_m_url="$(grep -m1 -E '^FW_MONGODB_URL=' "$FW_ROOT/.env.fleet" 2>/dev/null | cut -d= -f2-)"
_m_host="$(printf '%s' "$_m_url" | sed -E 's|^mongodb://||; s|/.*$||; s|:[0-9]+$||; s|^.*@||; s|,.*$||')"
_m_ip=""
[ -n "$_m_host" ] && _m_ip="$(_mode_resolve_ip "$_m_host" 2>/dev/null || true)"
[ -z "$_m_ip" ] && _m_ip="$_m_host"
if [ -n "$_m_ip" ]; then
    if _mode_mongo_reachable "$_m_ip"; then s="reachable ✓"; else s="UNREACHABLE ✗"; fi
    printf '  %-18s %s\n' "Mongo :27017"  "$_m_host ($_m_ip) → $s"
elif [ -n "$probe_ip" ]; then
    if _mode_mongo_reachable "$probe_ip"; then s="reachable ✓"; else s="UNREACHABLE ✗"; fi
    printf '  %-18s %s\n' "Mongo :27017"  "$probe_ip → $s"
fi
# MinIO is a SEPARATE service on a SEPARATE host; say so rather than implying the
# one Mongo line covers the fleet's storage too.
_s3="$(grep -m1 -E '^FW_S3_ENDPOINT=' "$FW_ROOT/.env.fleet" 2>/dev/null | cut -d= -f2-)"
_s3_host="$(printf '%s' "$_s3" | sed -E 's|^https?://||; s|/.*$||; s|:[0-9]+$||')"
_s3_port="$(printf '%s' "$_s3" | sed -nE 's|.*:([0-9]+).*|\1|p')"; : "${_s3_port:=9000}"
if [ -n "$_s3_host" ]; then
    _s3_ip="$(_mode_resolve_ip "$_s3_host" 2>/dev/null || true)"; [ -z "$_s3_ip" ] && _s3_ip="$_s3_host"
    if nc -z -G 3 "$_s3_ip" "$_s3_port" >/dev/null 2>&1; then s="reachable ✓"; else s="UNREACHABLE ✗"; fi
    printf '  %-18s %s\n' "MinIO :$_s3_port" "$_s3_host ($_s3_ip) → $s"
fi

echo
n_up="$(docker ps --format '{{.Names}}' 2>/dev/null | grep -cE '^facetwork-runner-' || true)"
n_all="$(_mode_runner_containers | wc -l | tr -d ' ')"
printf 'Runners on this host: %s up / %s defined\n' "$n_up" "$n_all"

echo
echo "Switch:  fw mode local | fw mode cluster        (Model B — flip infra, recreate runners)"
echo "         fw mode leave | fw mode join           (Model A — stop/start THIS host as a cluster runner)"
