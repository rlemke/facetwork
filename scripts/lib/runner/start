#!/usr/bin/env bash
# Register handlers for examples, then start the runner and dashboard.
#
# Local mode (default): upserts handler_registrations from one or more
# examples, starts the dashboard (port 8080), and starts the runner
# service in registry mode.
#
# Remote mode: registers handlers locally (MongoDB), then SSHs to each
# remote host to start runner processes, polling MongoDB for RUNNING state.
#
# Usage:
#   fw runner start                                        # register ALL examples
#   fw runner start --example hiv-drug-resistance          # one example
#   fw runner start --example devops-deploy --example hiv-drug-resistance
#   fw runner start --no-dashboard                         # skip dashboard
#   fw runner start -- --log-format text                   # extra args passed to runner
#   fw runner start --instances 3                          # 3 concurrent runner processes
#   fw runner start --example hiv-drug-resistance -- --log-format text --max-concurrent 10
#
# Remote mode:
#   fw runner start --all --example hiv-drug-resistance    # all AFL_RUNNER_HOSTS
#   fw runner start --host h1 --host h2 --example hiv-drug-resistance
#
# Container modes (replaces the old start-worker):
#   fw runner start --docker --example osm-geocoder        # runners as containers, local bundled infra
#   fw runner start --fleet                                # join an external shared Mongo+MinIO (default: osm-geocoder + osm-lz)
#   fw runner start --fleet --example noaa-weather         # any per-example runner service in the fleet
#   fw runner start --fleet --example census-us --replicas 6
#
# Options:
#   --example NAME   Register handlers from examples/NAME only (repeatable).
#                    In --docker/--fleet, selects the runner-NAME compose service
#                    (e.g. osm-geocoder, osm-lz, anthropic, noaa-weather,
#                    jenkins-example, census-us, genomics, sensor-monitoring).
#   --instances N    Start N runner processes per host (process mode; default: 1)
#   --no-dashboard   Do not start the dashboard (process mode)
#   --docker         Run runners as containers via compose (local bundled infra)
#   --fleet          Containers joining an EXTERNAL shared Mongo+MinIO; preflights
#                    both and reads --env FILE (default .env.fleet)
#   --replicas N     --docker/--fleet: containers per selected runner service
#                    (default: AFL_OSM_REPLICAS or 4 for --fleet, 1 for --docker)
#   --env FILE       --fleet: shared-endpoints env file (default .env.fleet)
#   --recreate       --docker/--fleet: force-recreate the containers
#   --all            Start on all hosts from AFL_RUNNER_HOSTS
#   --host HOST      Start on specific remote host (repeatable)
#   --start-timeout N  Seconds to wait for remote runner startup (default: 30)
#   --              Remaining args are passed to the runner service
#   -h, --help      Show this help message
#
# Environment (remote mode):
#   AFL_RUNNER_HOSTS   Space-separated hostnames
#   AFL_REMOTE_PATH    Repo path on remote hosts (default: same as local)
#   AFL_SSH_OPTS       Extra SSH options
#
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
set -euo pipefail

REPO_ROOT="$FW_ROOT"

# Load shared env (.env sets AFL_MONGODB_URL etc.)
source "$FW_LIB/_helpers/_env.sh"
source "$FW_LIB/_helpers/_catalog.sh"

PYTHON="${REPO_ROOT}/.venv/bin/python3"
[[ -x "$PYTHON" ]] || PYTHON=python3

DOMAINS=()
EXAMPLES=()
RUNNER_ARGS=()
INSTANCES=1
DASHBOARD=true
MODE="local"
HOST_ARGS=()
START_TIMEOUT=30
REPLICAS=""          # docker/fleet: containers per selected runner service
ENV_FILE=""          # fleet: env file with the shared endpoints (default .env.fleet)
RECREATE=0           # docker/fleet: force-recreate (e.g. on an image change)
CHECK_ONLY=0         # docker/fleet: preflight + validate only, don't start

while [[ $# -gt 0 ]]; do
    case "$1" in
        --domain)
            DOMAINS+=("$2"); shift 2 ;;
        --example)
            EXAMPLES+=("$2"); shift 2 ;;
        --instances)
            INSTANCES="$2"; shift 2 ;;
        --no-dashboard)
            DASHBOARD=false; shift ;;
        --docker)
            MODE="docker"; shift ;;          # run runners as containers (local bundled infra)
        --fleet)
            MODE="fleet"; shift ;;           # containers joining an external shared Mongo+MinIO
        --replicas)
            REPLICAS="$2"; shift 2 ;;        # docker/fleet: scale each runner service
        --env)
            ENV_FILE="$2"; shift 2 ;;        # fleet: shared-endpoints env file
        --recreate)
            RECREATE=1; shift ;;
        --check)
            CHECK_ONLY=1; shift ;;           # docker/fleet: preflight + validate only
        --all)
            MODE="remote"; shift ;;
        --host)
            MODE="remote"; HOST_ARGS+=("$2"); shift 2 ;;
        --start-timeout)
            START_TIMEOUT="$2"; shift 2 ;;
        -h|--help)
            sed -n '2,/^[^#]/{ /^#/s/^# \{0,1\}//p; }' "$0"
            exit 0 ;;
        --)
            shift; RUNNER_ARGS=("$@"); break ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: fw runner start [--example NAME]... [--instances N] [--no-dashboard]" >&2
            echo "                            [--docker | --fleet [--env FILE]] [--replicas N] [--recreate]" >&2
            echo "                            [--all | --host HOST]... [-- RUNNER_ARGS...]" >&2
            exit 1 ;;
    esac
done

# =========================================================================
# Container modes (--docker / --fleet) — converged from the old start-worker.
# Runs per-example runner CONTAINERS via compose instead of bare processes.
# Each --example NAME maps to the `runner-NAME` compose service; all per-example
# runners build from the same image, so one tag serves any example.
# =========================================================================
if [[ "$MODE" == "docker" || "$MODE" == "fleet" ]]; then
    PY="${REPO_ROOT}/.venv/bin/python3"; [[ -x "$PY" ]] || PY=python3

    # Map domains (and any --example) → runner services. The per-service runners
    # are the fwh_* domains; default preserves the old start-worker set.
    SERVICES=()
    SELECTED=(${DOMAINS[@]+"${DOMAINS[@]}"} ${EXAMPLES[@]+"${EXAMPLES[@]}"})
    if [[ ${#SELECTED[@]} -eq 0 ]]; then
        # Default fleet set = domains flagged fleet_default in the catalog
        # (domains.json + overrides), not a hardcoded list.
        while IFS= read -r _svc; do [[ -n "$_svc" ]] && SERVICES+=("$_svc"); done \
            < <(catalog_fleet_default_services)
    else
        for e in "${SELECTED[@]}"; do SERVICES+=("runner-$e"); done
    fi

    COMPOSE_F=(-f "$REPO_ROOT/docker-compose.full-stack.yml")
    COMPOSE_ENV=()

    if [[ "$MODE" == "fleet" ]]; then
        COMPOSE_F+=(-f "$REPO_ROOT/docker-compose.fleet.yml")
        ENV_FILE="${ENV_FILE:-$REPO_ROOT/.env.fleet}"
        if [[ ! -f "$ENV_FILE" ]]; then
            echo "ERROR: env file not found: $ENV_FILE" >&2
            echo "  cp .env.fleet.example .env.fleet  and edit the shared endpoints." >&2
            echo "  (or, to join this fleet:  cp .env.fleet.preset .env.fleet)" >&2
            exit 1
        fi
        COMPOSE_ENV=(--env-file "$ENV_FILE")

        # Per-server override layer: an optional sibling file holding ONLY this
        # server's specifics (AFL_DATA_DIR, AFL_OSM_REPLICAS, AFL_INFRA_IP if the
        # infra host moved, …). Loaded AFTER the shared base so its values WIN
        # (compose merges multiple --env-file, later wins), and it is gitignored.
        # So when the shared base (.env.fleet, copied from .env.fleet.preset)
        # changes, you just re-copy the preset — this file's per-server values
        # survive untouched. No more re-editing .env.fleet after every update.
        OVERRIDE_FILE="${ENV_FILE}.override"
        if [[ -f "$OVERRIDE_FILE" ]]; then
            COMPOSE_ENV+=(--env-file "$OVERRIDE_FILE")
            echo "  Per-server overrides: $OVERRIDE_FILE"
        fi

        # Read the few vars this script needs WITHOUT sourcing (a value may contain
        # spaces, e.g. AFL_REGISTRY_RUNNER_ARGS=--task-list osm); compose reads the
        # full file safely via --env-file. The override file wins, matching compose.
        _envget() {
            local v=""
            [[ -f "$OVERRIDE_FILE" ]] && v="$(sed -n "s/^$1=//p" "$OVERRIDE_FILE" | tail -1)"
            [[ -n "$v" ]] && { printf '%s\n' "$v"; return; }
            sed -n "s/^$1=//p" "$ENV_FILE" | tail -1
        }
        AFL_MONGODB_URL="$(_envget AFL_MONGODB_URL)"
        AFL_S3_ENDPOINT="$(_envget AFL_S3_ENDPOINT)"
        AFL_RUNNER_IMAGE="${AFL_RUNNER_IMAGE:-$(_envget AFL_RUNNER_IMAGE)}"
        : "${AFL_MONGODB_URL:?set AFL_MONGODB_URL (shared MongoDB) in $ENV_FILE}"
        : "${AFL_S3_ENDPOINT:?set AFL_S3_ENDPOINT (shared MinIO) in $ENV_FILE}"
        REPLICAS="${REPLICAS:-$(_envget AFL_OSM_REPLICAS)}"; REPLICAS="${REPLICAS:-4}"

        # Name this server's runners (hostname by default) so `fleet status` /
        # the dashboard show it by name and fleet-agent drift records line up.
        export AFL_FLEET_HOST="${AFL_FLEET_HOST:-$(_envget AFL_RUNNER_NAME)}"
        export AFL_FLEET_HOST="${AFL_FLEET_HOST:-$(hostname -s 2>/dev/null || hostname)}"
        # Every Facetwork server is a runner — group under "runner" by default.
        export AFL_SERVER_GROUP="${AFL_SERVER_GROUP:-$(_envget AFL_SERVER_GROUP)}"
        export AFL_SERVER_GROUP="${AFL_SERVER_GROUP:-runner}"

        echo "Preflight — shared services must be reachable from this host:"
        if "$PY" - "$AFL_MONGODB_URL" <<'PYEOF' 2>/dev/null
import sys
from pymongo import MongoClient
MongoClient(sys.argv[1], serverSelectionTimeoutMS=5000).admin.command("ping")
PYEOF
        then echo "  ✓ MongoDB reachable: $AFL_MONGODB_URL"
        else
            echo "  ✗ MongoDB NOT reachable: $AFL_MONGODB_URL" >&2
            echo "    Check host/port, /etc/hosts (afl-mongodb -> IP), mongod binds 0.0.0.0, firewall." >&2
            exit 1
        fi
        if "$PY" - "$AFL_S3_ENDPOINT" <<'PYEOF' 2>/dev/null
import socket, sys
from urllib.parse import urlparse
u = urlparse(sys.argv[1]); host = u.hostname or sys.argv[1]
port = u.port or (443 if u.scheme == "https" else 80)
socket.create_connection((host, port), timeout=5).close()
PYEOF
        then echo "  ✓ MinIO/S3 reachable: $AFL_S3_ENDPOINT"
        else
            echo "  ✗ MinIO/S3 NOT reachable: $AFL_S3_ENDPOINT" >&2
            echo "    Check the endpoint URL/port, MinIO binds 0.0.0.0, firewall." >&2
            exit 1
        fi

        # The osm runners bind-mount ${AFL_DATA_DIR}/osm-scratch into the
        # container for local PBF staging. Docker creates a MISSING source dir
        # as root, but it can't mkdir under an unwritable parent (e.g. macOS
        # /Volumes, which only root can write) — that surfaces as a cryptic
        # "mkdir /host_mnt/...: permission denied" at `up` time. Validate it
        # here so a server whose .env.fleet still points AFL_DATA_DIR at another
        # host's disk fails with an actionable message instead.
        AFL_DATA_DIR="${AFL_DATA_DIR:-$(_envget AFL_DATA_DIR)}"; AFL_DATA_DIR="${AFL_DATA_DIR:-/Volumes/afl_data}"
        _SCRATCH="$AFL_DATA_DIR/osm-scratch"
        if mkdir -p "$_SCRATCH" 2>/dev/null && [[ -w "$_SCRATCH" ]]; then
            echo "  ✓ Local scratch writable: $_SCRATCH"
        else
            echo "  ✗ Local scratch NOT writable: $_SCRATCH" >&2
            echo "    Set AFL_DATA_DIR in $ENV_FILE to a large LOCAL path this server can write" >&2
            echo "    (the preset's /Volumes/afl_data is this fleet's infra host, not every server)." >&2
            exit 1
        fi
    fi
    REPLICAS="${REPLICAS:-1}"

    # Extra compose files (space/colon-separated), e.g. the local multi-server
    # sim's network override. Lets the same path serve real fleets and simulation.
    if [[ -n "${AFL_FLEET_EXTRA_COMPOSE:-}" ]]; then
        IFS=': ' read -ra _extra <<< "$AFL_FLEET_EXTRA_COMPOSE"
        for _f in "${_extra[@]}"; do [[ -n "$_f" ]] && COMPOSE_F+=(-f "$_f"); done
    fi

    # Validate each selected service exists (catches typos / wrong example name).
    AVAIL="$(docker compose "${COMPOSE_F[@]}" ${COMPOSE_ENV[@]+"${COMPOSE_ENV[@]}"} config --services 2>/dev/null | grep '^runner-' || true)"
    for s in "${SERVICES[@]}"; do
        if ! grep -qx "$s" <<<"$AVAIL"; then
            echo "ERROR: no compose service '$s' (from --example ${s#runner-})." >&2
            echo "Available runner services:" >&2
            echo "$AVAIL" | sed 's/^runner-/  /' >&2
            exit 1
        fi
    done

    if [[ "$CHECK_ONLY" == "1" ]]; then
        echo "Preflight + service validation OK (--check): not starting runners."
        exit 0
    fi

    SCALE=()
    for s in "${SERVICES[@]}"; do SCALE+=(--scale "$s=$REPLICAS"); done

    # --recreate: remove the selected services' containers FIRST, then bring them
    # up fresh. A plain `up -d --force-recreate --scale` replaces the *current*
    # containers but leaves ORPHAN replicas from a prior run/scale still running —
    # on the fleet those stale containers keep claiming tasks with old code/env
    # (the cause of osm leaves writing host-local paths that S3 downstream can't
    # read). Removing first guarantees exactly $REPLICAS fresh containers per
    # service. Same pattern as fw single rebuild-runners --up.
    if [[ "$RECREATE" == "1" ]]; then
        echo "Recreate: removing existing containers for [${SERVICES[*]}] (clears orphan replicas)"
        docker compose "${COMPOSE_F[@]}" ${COMPOSE_ENV[@]+"${COMPOSE_ENV[@]}"} \
            rm -sf "${SERVICES[@]}" || true
    fi

    echo "Starting [${SERVICES[*]}] x${REPLICAS} via docker compose (mode=$MODE)"
    [[ "$MODE" == "fleet" ]] && echo "  joining MongoDB=$AFL_MONGODB_URL  MinIO=$AFL_S3_ENDPOINT"
    # NB: no --remove-orphans — on the shared full-stack network it makes compose
    # try to remove facetwork_default and fails ("network has active endpoints":
    # infra mongodb/postgis/jenkins are attached). The rm -sf above already
    # cleared the selected services' orphan replicas.
    docker compose "${COMPOSE_F[@]}" ${COMPOSE_ENV[@]+"${COMPOSE_ENV[@]}"} \
        up -d "${SCALE[@]}" "${SERVICES[@]}"

    echo "Done. Runners now claim tasks from $( [[ "$MODE" == "fleet" ]] && echo "the shared fleet" || echo "the local stack" )."
    echo "Watch:  docker compose ${COMPOSE_F[*]} logs -f ${SERVICES[*]}"
    exit 0
fi

if ! [[ "$INSTANCES" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: --instances must be a positive integer, got '$INSTANCES'" >&2
    exit 1
fi

# Resolve packages (domains via entry-point/domains-dir + teaching examples in
# examples/). The python helper emits tab-separated lines:
#   PKG\t<name>\t<handlers_path_or_->     ENV\t<KEY>\t<VALUE>
RESOLVED=$(env PYTHONPATH="$REPO_ROOT" REPO_ROOT="$REPO_ROOT" "$PYTHON" -c "
import os, sys
from pathlib import Path
from facetwork._pkg_discovery import filter_packages
from facetwork.domains import discover_all_domains
from facetwork.examples import discover_all_examples

repo = Path(os.environ['REPO_ROOT'])
allpkgs = discover_all_domains(repo) + discover_all_examples(repo)
selected = sys.argv[1:] or None
chosen = list(filter_packages(allpkgs, include=selected))
for pkg in chosen:
    hp = str(pkg.handlers_path) if pkg.handlers_path else '-'
    print(f'PKG\t{pkg.name}\t{hp}')
for pkg in chosen:
    for k, v in pkg.runner_env.items():
        print(f'ENV\t{k}\t{v}')
" ${DOMAINS[@]+\"${DOMAINS[@]}\"} ${EXAMPLES[@]+\"${EXAMPLES[@]}\"})

PKGS=()
HANDLER_PATHS=()
while IFS=$'\t' read -r kind a b; do
    [[ -z "$kind" ]] && continue
    case "$kind" in
        PKG)
            PKGS+=("$a")
            [[ "$b" != "-" ]] && HANDLER_PATHS+=("$b")
            ;;
        ENV)
            export "$a=$b"
            ;;
    esac
done <<< "$RESOLVED"

if [[ ${#PKGS[@]} -eq 0 ]]; then
    echo "No domains/examples found (checked facetwork.domains entry points, domains/, examples/)." >&2
    exit 1
fi

echo "=== Facetwork: Register Handlers & Start Runner ==="
echo ""
echo "  Packages:  ${PKGS[*]}"
echo "  Instances: $INSTANCES"
echo "  Dashboard: $DASHBOARD"
echo "  Mode:      $MODE"
if [[ -n "${AFL_TASK_EXECUTION_TIMEOUT_MS:-}" ]]; then
    echo "  Exec timeout: ${AFL_TASK_EXECUTION_TIMEOUT_MS}ms"
fi
if [[ -n "${AFL_STUCK_TIMEOUT_MS:-}" ]]; then
    echo "  Stuck timeout: ${AFL_STUCK_TIMEOUT_MS}ms"
fi

# Surface the effective output destination so silent fallbacks (.env's
# /tmp/output, or built-in defaults like /Volumes/afl_data/output that
# don't exist on this host) aren't surprises. The default was getting picked
# up across hand-restarts when the caller's shell hadn't re-exported a
# project-specific AFL_OUTPUT_BASE.
_OUT_BASE="${AFL_OUTPUT_BASE:-${AFL_LOCAL_OUTPUT_DIR:-}}"
if [[ -z "$_OUT_BASE" ]]; then
    echo "  AFL_OUTPUT_BASE: (unset — handlers will use built-in defaults)"
    echo "    WARNING: outputs may land at /Volumes/afl_data/output (sandbox default) and fail." >&2
else
    _OUT_SOURCE="env"
    if [[ "$_OUT_BASE" == "/tmp/output" ]]; then
        _OUT_SOURCE="default in .env"
    fi
    echo "  AFL_OUTPUT_BASE: $_OUT_BASE  ($_OUT_SOURCE)"
    if ! mkdir -p "$_OUT_BASE" 2>/dev/null || [[ ! -w "$_OUT_BASE" ]]; then
        echo "    WARNING: $_OUT_BASE is not writable in this shell; outputs will fail or fall back." >&2
    fi
fi
echo ""

# Register handlers via the shared discovery API. PKGS may span both families,
# so register against each; `|| true` swallows the benign "none of these names
# are in this family" exit (each family registers only the names it owns).
env PYTHONPATH="$REPO_ROOT" REPO_ROOT="$REPO_ROOT" "$PYTHON" -m facetwork.domains ${PKGS[@]+"${PKGS[@]}"} || true
env PYTHONPATH="$REPO_ROOT" REPO_ROOT="$REPO_ROOT" "$PYTHON" -m facetwork.examples ${PKGS[@]+"${PKGS[@]}"} || true

# Build PYTHONPATH so the runner can import handler modules from local
# examples (entry-point packages are already on sys.path via pip install).
RUNNER_PYTHONPATH="$REPO_ROOT"
for hp in ${HANDLER_PATHS[@]+"${HANDLER_PATHS[@]}"}; do
    RUNNER_PYTHONPATH="$RUNNER_PYTHONPATH:$hp"
done

# =========================================================================
# Local mode
# =========================================================================

if [[ "$MODE" == "local" ]]; then
    PIDS=()

    # Start dashboard
    if [[ "$DASHBOARD" == "true" ]]; then
        echo "Starting dashboard on port 8080..."
        env PYTHONPATH="$REPO_ROOT" PYTHONUNBUFFERED=1 "$PYTHON" -m facetwork.dashboard &
        PIDS+=($!)
        echo "  Dashboard started (PID $!)"
        # Wait for dashboard to bind port before starting runners
        # (runners also have HTTP status servers that auto-increment ports)
        for _i in $(seq 1 20); do
            if curl -sf http://localhost:8080/health >/dev/null 2>&1; then
                break
            fi
            sleep 0.5
        done
    fi

    # Start runner(s)
    if [[ "$INSTANCES" -eq 1 && "$DASHBOARD" == "false" ]]; then
        echo "Starting runner with --registry..."
        exec env PYTHONPATH="$RUNNER_PYTHONPATH" PYTHONUNBUFFERED=1 "$PYTHON" -m facetwork.runtime.runner --registry ${RUNNER_ARGS[@]+"${RUNNER_ARGS[@]}"}
    else
        echo "Starting $INSTANCES runner instance(s) with --registry..."
        for i in $(seq 1 "$INSTANCES"); do
            env PYTHONPATH="$RUNNER_PYTHONPATH" PYTHONUNBUFFERED=1 "$PYTHON" -m facetwork.runtime.runner --registry ${RUNNER_ARGS[@]+"${RUNNER_ARGS[@]}"} &
            PIDS+=($!)
            echo "  Runner $i started (PID $!)"
        done
    fi

    echo ""
    echo "All processes started. PIDs: ${PIDS[*]}"
    echo "Use fw runner stop to stop them."

    # Wait for all — if any exits, report it
    wait "${PIDS[@]}"
    exit 0
fi

# =========================================================================
# Remote mode
# =========================================================================

source "$FW_LIB/_helpers/_remote.sh"
_afl_resolve_remote_env

HOSTS=()
while IFS= read -r h; do
    HOSTS+=("$h")
done < <(_afl_resolve_hosts "${HOST_ARGS[@]}")

echo "=== Starting Remote Runners ==="
echo "  Hosts: ${HOSTS[*]}"
echo "  Remote path: $AFL_REMOTE_PATH"
echo ""

# Build the runner args string for SSH
RUNNER_ARGS_STR=""
if [[ ${#RUNNER_ARGS[@]} -gt 0 ]]; then
    # Quote each arg for remote shell
    for arg in "${RUNNER_ARGS[@]}"; do
        RUNNER_ARGS_STR="$RUNNER_ARGS_STR $(printf '%q' "$arg")"
    done
fi

ALL_OK=true

for host in "${HOSTS[@]}"; do
    echo "Starting runner on $host..."

    # Record existing server UUIDs on this host so we can detect the new one
    EXISTING_UUIDS=()
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        read -r srv_name srv_port srv_uuid <<< "$line"
        if [[ "$srv_name" == "$host" ]]; then
            EXISTING_UUIDS+=("$srv_uuid")
        fi
    done <<< "$(_afl_query_running_servers)"

    # Start runner on remote host (detached via nohup)
    for i in $(seq 1 "$INSTANCES"); do
        _afl_ssh "$host" \
            "cd $AFL_REMOTE_PATH && nohup ./fw runner exec --registry$RUNNER_ARGS_STR > /tmp/afl-runner-\$\$.log 2>&1 &" || {
            echo "  ERROR: SSH to $host failed"
            ALL_OK=false
            continue 2
        }
    done

    # Poll MongoDB until new server(s) appear with state=running
    printf "  Waiting for runner on %s to register (timeout: %ss)... " "$host" "$START_TIMEOUT"
    if _afl_poll_new_server "$host" "running" "$START_TIMEOUT" "${EXISTING_UUIDS[@]+"${EXISTING_UUIDS[@]}"}"; then
        echo "done"
    else
        echo "TIMEOUT"
        ALL_OK=false
    fi
done

echo ""
if [[ "$ALL_OK" == "true" ]]; then
    echo "All remote runners started successfully."
else
    echo "Some runners failed to start. Check logs on the remote hosts."
    exit 1
fi
