#!/usr/bin/env bash
# Start the full fleet on THIS host: dashboard + the ffl-runner orchestration
# tier + every per-example handler runner, then a fleet-agent watcher.
#
# Orchestration split (docs/architecture/ffl-runner-orchestration-tier.md):
# bring up the ffl-runner tier (continuation_mode=shared) FIRST, then start the
# handler runners with AFL_HANDLER_CONTINUATION_MODE=off so they keep the inline
# cascade after their own handler but leave the shared backlog + stuck-step
# sweep to the ffl tier. (A bare `docker compose up` leaves AFL_CONTINUATION_MODE
# at its "inline" default, so it still self-orchestrates without the tier.)
#
# start-runner --fleet --recreate removes each service's existing containers
# before bringing them up (no orphan replicas) and layers .env.fleet +
# .env.fleet.override.
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_catalog.sh"
set -euo pipefail

REPO_ROOT="$FW_ROOT"
cd "$REPO_ROOT"

# Number of ffl-runners on this host (>=2 recommended for liveness).
FFL_REPLICAS="${FFL_REPLICAS:-2}"

# Dashboard (base full-stack service) — same env layering as the fleet runners.
docker compose --env-file .env.fleet --env-file .env.fleet.override \
  -f docker-compose.full-stack.yml -f docker-compose.fleet.yml \
  up -d --no-deps dashboard

# 1) Orchestration tier FIRST, so handler runners can safely run --continuation
#    off (the tier must own the sweep before the handlers stop running it).
"$FW_LIB/runner/start" --fleet --recreate --domain ffl --replicas "$FFL_REPLICAS"

# 2) Handler runners — off (the ffl tier owns the sweep/backlog). The env var is
#    read by the *s3-storage / *osm-s3-env anchors; runner-ffl overrides it back
#    to "shared" explicitly, so this does not affect the tier.
#
#    Two scale tiers, BOTH derived from the catalog (domains.json + overrides):
#    domains flagged `scaled` (heavy, parallel — the osm runners) get the
#    throughput knob (AFL_OSM_REPLICAS); every other compose domain is a single
#    replica. Passing all domains to ONE start-runner call would fan
#    AFL_OSM_REPLICAS across ALL services (one `--scale N` per selected service),
#    spinning up N copies of anthropic/census/genomics/etc. that nothing needs.
export AFL_HANDLER_CONTINUATION_MODE=off

# 2a) scaled runners (osm) — scaled by the throughput knob (start-runner --fleet
#     default 4; .env.fleet sets AFL_OSM_REPLICAS=3).
SCALED=(); while IFS= read -r _d; do [[ -n "$_d" ]] && SCALED+=(--domain "$_d"); done \
    < <(catalog_scaled_domain_suffixes)
if [[ ${#SCALED[@]} -gt 0 ]]; then
    "$FW_LIB/runner/start" --fleet --recreate "${SCALED[@]}"
fi

# 2b) every other compose-domain runner — exactly one replica each.
UNSCALED=(); while IFS= read -r _d; do [[ -n "$_d" ]] && UNSCALED+=(--domain "$_d"); done \
    < <(catalog_unscaled_domain_suffixes)
if [[ ${#UNSCALED[@]} -gt 0 ]]; then
    "$FW_LIB/runner/start" --fleet --recreate --replicas 1 "${UNSCALED[@]}"
fi

# Keep this host's roles reconciled to the central fleet config.
"$FW_LIB/fleet/agent" watch --data-dir "$HOME/afl_data"
