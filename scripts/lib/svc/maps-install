#!/usr/bin/env bash
# fw-summary: install/uninstall a launchd unit that keeps `fw svc maps` always up
#
# Writes a login-shell wrapper (~/.facetwork/maps-gallery.sh) + a LaunchAgent
# (com.facetwork.maps) that runs the local maps gallery, RunAtLoad + KeepAlive, so
# it survives logout/reboot and restarts if it dies. macOS only (launchd).
#
# Usage:
#   fw svc maps-install                 # write + load (port 8090)
#   fw svc maps-install --port 9095
#   fw svc maps-install --no-load       # write files only
#   fw svc maps-install --uninstall     # unload + remove
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
set -euo pipefail

LABEL="com.facetwork.maps"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
WRAPPER="$HOME/.facetwork/maps-gallery.sh"
LOGDIR="$HOME/.facetwork"
PORT=8090 LOAD=1 UNINSTALL=0

while [ $# -gt 0 ]; do
    case "$1" in
        --port) PORT="$2"; shift 2 ;;
        --no-load) LOAD=0; shift ;;
        --uninstall|--remove) UNINSTALL=1; shift ;;
        -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

# ⚠️ NOT a timer — this supervises a LONG-RUNNING server (RunAtLoad + KeepAlive),
# so cron is the wrong tool: it would start a new gallery every tick and stack
# them. The Linux equivalent is a systemd unit, which needs root to install, so
# this cannot self-install. It writes the unit and hands over the one command,
# which is more use than telling the operator that a unit exists.
#
# `loginctl show-user … Linger` is off on these hosts, so a --user unit would
# die at logout; a system unit with User= is the form that survives.
if [ "$(uname)" != "Darwin" ]; then
    UNIT="/tmp/facetwork-maps.service"
    cat > "$UNIT" <<UNITEOF
[Unit]
Description=Facetwork local maps gallery
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=$USER
WorkingDirectory=$FW_ROOT
ExecStart=$FW_ROOT/fw svc maps --port ${PORT:-8090}
Restart=always
RestartSec=10
StandardOutput=append:${LOG:-$HOME/.facetwork/maps.log}
StandardError=append:${LOG:-$HOME/.facetwork/maps.log}

[Install]
WantedBy=multi-user.target
UNITEOF
    echo "launchd is macOS-only, and this is a supervised server rather than a" >&2
    echo "scheduled job, so cron is not the substitute." >&2
    echo >&2
    echo "Wrote a systemd unit to $UNIT. Install it with:" >&2
    echo "  sudo cp $UNIT /etc/systemd/system/facetwork-maps.service" >&2
    echo "  sudo systemctl daemon-reload" >&2
    echo "  sudo systemctl enable --now facetwork-maps" >&2
    echo >&2
    echo "Or just run it in the foreground when you want it:" >&2
    echo "  fw svc maps --port ${PORT:-8090}" >&2
    exit 1
fi

if [ "$UNINSTALL" = 1 ]; then
    launchctl unload "$PLIST" 2>/dev/null || true
    rm -f "$PLIST" "$WRAPPER"
    echo "uninstalled $LABEL (removed $PLIST + $WRAPPER)."
    exit 0
fi

mkdir -p "$LOGDIR" "$(dirname "$PLIST")"

# --- wrapper: login shell so PATH/venv/docker/gh resolve; wait for MinIO -------
cat > "$WRAPPER" <<WRAP
#!/bin/bash -l
# Facetwork maps gallery — launched by $LABEL. Regenerate via 'fw svc maps-install'.
set -u
export PYTHONUNBUFFERED=1
PORT="\${FW_MAPS_PORT:-$PORT}"
# The gallery reads maps from the local MinIO. Bring Docker + MinIO up first so it
# doesn't crash-restart on boot (KeepAlive retries regardless).
if ! docker info >/dev/null 2>&1; then
  open -a Docker >/dev/null 2>&1 || true
  for i in \$(seq 1 80); do docker info >/dev/null 2>&1 && break; sleep 3; done
fi
for i in \$(seq 1 60); do
  curl -sf http://localhost:9000/minio/health/live >/dev/null 2>&1 && break
  sleep 3
done
# Publish token (OPT-IN): a LaunchAgent can't read gh's token from the macOS
# keychain, so publish is disabled here by default. To enable it, deliberately
# create ~/.facetwork/maps.env (0600) with 'GITHUB_TOKEN=...' — ideally a
# fine-grained PAT scoped to the Pages repo (contents:write). Nothing implicit is
# sourced. Without it the gallery still runs; Publish just shows "disabled".
[ -f "\$HOME/.facetwork/maps.env" ] && . "\$HOME/.facetwork/maps.env"
cd "$FW_ROOT" || exit 1
exec ./fw svc maps --port "\$PORT"
WRAP
chmod +x "$WRAPPER"

# --- plist --------------------------------------------------------------------
cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LABEL</string>
    <key>ProgramArguments</key><array><string>$WRAPPER</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>15</integer>
    <key>WorkingDirectory</key><string>$FW_ROOT</string>
    <key>StandardOutPath</key><string>$LOGDIR/maps-gallery.log</string>
    <key>StandardErrorPath</key><string>$LOGDIR/maps-gallery.err.log</string>
</dict>
</plist>
PLISTEOF

echo "wrote:"
echo "  $WRAPPER"
echo "  $PLIST   (port $PORT)"

if [ "$LOAD" = 1 ]; then
    launchctl unload "$PLIST" 2>/dev/null || true
    launchctl load "$PLIST"
    echo "loaded $LABEL — gallery will stay up at http://localhost:$PORT/"
    echo "  logs: $LOGDIR/maps-gallery.log  ·  stop: launchctl unload $PLIST"
else
    echo "not loaded (--no-load). Activate with: launchctl load $PLIST"
fi
