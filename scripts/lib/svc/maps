#!/usr/bin/env bash
# fw-summary: local maps gallery — browse the maps sitting in MinIO (no git repo)
#
# Serves a gallery of every map in the object store (streamed from MinIO on
# demand — nothing is copied to disk or the git repo, so big maps/tiles/data can
# live locally). Publish only the ones you pick to the public site separately.
#
# Usage:
#   fw svc maps                 # http://localhost:8090/
#   fw svc maps --port 9095
#   FW_S3_ENDPOINT=... fw svc maps   # browse a different store
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
source "$FW_LIB/_helpers/_env.sh"   # load .env (FW_S3_* etc.) if present
set -euo pipefail

# S3 config lives in .env.fleet on fleet hosts; pull the relevant vars from there
# too if they aren't already set (the base .env may not carry them).
if [ -f "$FW_ROOT/.env.fleet" ]; then
    for _k in FW_S3_ENDPOINT FW_S3_ACCESS_KEY FW_S3_SECRET_KEY FW_S3_BUCKET; do
        if [ -z "${!_k:-}" ]; then
            _v="$(sed -n "s/^[[:space:]]*${_k}[[:space:]]*=[[:space:]]*//p" "$FW_ROOT/.env.fleet" | tail -1)"
            [ -n "$_v" ] && export "$_k=$_v"
        fi
    done
fi

PYTHON="${FW_ROOT}/.venv/bin/python3"
[[ -x "$PYTHON" ]] || PYTHON=python3

exec env PYTHONPATH="$FW_ROOT" "$PYTHON" -m facetwork.mapserver "$@"
