#!/usr/bin/env bash
# fw-summary: publish new per-region OSM replication diffs; --install adds the nightly timer
#
# Runs fwh_osm's producer (`publish-replication.sh --days N`), which cuts each
# new day of OSM replication down to every region's polygon and publishes it as
# that region's own sequenced diff. `fw svc osm-extracts` serves the result.
#
# WHY A TIMER. The stream being current is not a state, it is a rate. Phase 1
# left extracts frozen for 39 days and nothing ever errored — the data was
# simply old, silently, until a downstream map's numbers looked wrong. Catching
# up by hand once just resets that clock; without this timer the same drift
# restarts the next morning, now with a working mechanism sitting idle behind
# it.
#
# SCHEDULING — measured, not assumed. The first install used a fixed 03:15
# nightly time (after OSM's ~00:18 UTC publish in both DST halves). It never
# fired: this machine sleeps — 62 sleep/wake cycles since boot — and launchd
# does NOT run a missed StartCalendarInterval on wake. `runs` stayed put, the
# log stayed empty, and nothing reported anything. A laptop asleep at 03:15
# publishes nothing, forever, silently — the same shape of failure this whole
# tool exists to end.
#
# So the default is a periodic StartInterval (every 6h), which DOES fire on wake
# once its period has elapsed: worst case becomes "shortly after you next open
# the lid" instead of "never". `--at HH:MM` restores a fixed time for an
# always-on host, where predictability is worth more than tolerance.
#
# `--days 4` by default, not 1: missed periods then heal themselves instead of
# leaving a permanent hole, and re-publishing a day is a no-op.
#
# Usage:
#   fw svc osm-replicate                 # publish up to 4 new days now
#   fw svc osm-replicate --days 14       # bigger catch-up
#   fw svc osm-replicate --install            # every 6h, fires on wake
#   fw svc osm-replicate --every-hours 12 --install
#   fw svc osm-replicate --at 03:15 --install # fixed time (always-on hosts only)
#   fw svc osm-replicate --uninstall
#   fw svc osm-replicate --status
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
source "$FW_LIB/_helpers/_env.sh"
set -euo pipefail

LABEL="com.facetwork.osm-replicate"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
WRAPPER="$HOME/.facetwork/osm-replicate.sh"
LOGDIR="$HOME/.facetwork"
LOG="$LOGDIR/osm-replicate.log"
DAYS=4 AT="" EVERY_HOURS=6 ACTION="run"

while [ $# -gt 0 ]; do
    case "$1" in
        --days) DAYS="$2"; shift 2 ;;
        --at) AT="$2"; shift 2 ;;
        --every-hours) EVERY_HOURS="$2"; shift 2 ;;
        --install) ACTION="install"; shift ;;
        --uninstall|--remove) ACTION="uninstall"; shift ;;
        --status) ACTION="status"; shift ;;
        -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

PUBLISH="${FWH_HANDLERS_ROOT:-$HOME/fw_handlers}/fwh_osm/src/osm_geocoder/tools/publish-replication.sh"

case "$ACTION" in
run)
    [ -x "$PUBLISH" ] || { echo "not found: $PUBLISH — is fwh_osm installed?" >&2; exit 1; }
    echo "[$(date '+%Y-%m-%d %H:%M:%S %Z')] publishing up to $DAYS day(s)"
    exec "$PUBLISH" --days "$DAYS"
    ;;

status)
    # Capture before testing: `launchctl list | grep -q` under `set -o pipefail`
    # reports a running job as absent (grep exits early, launchctl takes SIGPIPE).
    if [ -n "$(launchctl list 2>/dev/null | grep -F "$LABEL" || true)" ]; then
        echo "timer: LOADED ($LABEL)"
    else
        echo "timer: not loaded — install with: fw svc osm-replicate --install"
    fi
    [ -x "$PUBLISH" ] && "$PUBLISH" --status 2>&1 | sed 's/^/  /' || true
    [ -f "$LOG" ] && { echo "log:   $LOG"; tail -4 "$LOG" | sed 's/^/  /'; }
    ;;

uninstall)
    launchctl unload "$PLIST" 2>/dev/null || true
    rm -f "$PLIST" "$WRAPPER"
    echo "uninstalled $LABEL."
    echo "⚠️  The extracts stay served, but the stream stops advancing — and"
    echo "    nothing will report that. Consumers just keep getting older data."
    ;;

install)
    if [ "$(uname)" != "Darwin" ]; then
        echo "launchd is macOS-only. On Linux use a systemd timer, or cron:" >&2
        echo "  15 3 * * *  cd $FW_ROOT && ./fw svc osm-replicate >> $LOG 2>&1" >&2
        exit 1
    fi
    if [ -n "$AT" ]; then
        case "$AT" in
            [0-9][0-9]:[0-9][0-9]) HH="${AT%%:*}"; MM="${AT##*:}" ;;
            *) echo "--at wants HH:MM (24h), got '$AT'" >&2; exit 2 ;;
        esac
        SCHEDULE="    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>$((10#$HH))</integer><key>Minute</key><integer>$((10#$MM))</integer></dict>"
        SCHED_DESC="daily at $AT local"
    else
        SCHEDULE="    <!-- Periodic, not a fixed time: a missed StartCalendarInterval is NOT
         run on wake, so on a machine that sleeps a nightly entry never fires.
         StartInterval does fire on wake once its period has elapsed. -->
    <key>StartInterval</key><integer>$((EVERY_HOURS * 3600))</integer>"
        SCHED_DESC="every ${EVERY_HOURS}h (fires on wake)"
    fi
    mkdir -p "$LOGDIR" "$(dirname "$PLIST")"

    cat > "$WRAPPER" <<WRAP
#!/bin/bash -l
# Nightly OSM replication publish — launched by $LABEL.
# Regenerate via 'fw svc osm-replicate --install'. Do not hand-edit.
set -u
export PYTHONUNBUFFERED=1
# The extracts and polygons live on an external volume. If it is not mounted,
# publishing would fail per-region with "no polygon" and still write a state —
# advertising a day whose diff was never cut. Wait, then refuse.
for i in \$(seq 1 60); do
  [ -d "${FW_OSM_SELFHOST_WWW:-/nonexistent}" ] && break
  sleep 5
done
[ -d "${FW_OSM_SELFHOST_WWW:-/nonexistent}" ] || {
  echo "\$(date): ${FW_OSM_SELFHOST_WWW:-<unset>} not present — skipping tonight"
  exit 1
}
cd "$FW_ROOT" || exit 1
exec ./fw svc osm-replicate --days $DAYS
WRAP
    chmod +x "$WRAPPER"

    cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LABEL</string>
    <key>ProgramArguments</key><array><string>$WRAPPER</string></array>
    <!-- Every day, not weekdays: OSM replication does not observe weekends. -->
    <key>RunAtLoad</key><true/>
$SCHEDULE
    <!-- No WorkingDirectory: it would be the repo, which is fine, but the
         wrapper cd's anyway and the external volume must not be chdir'd into
         by launchd (getcwd: Operation not permitted). -->
    <key>StandardOutPath</key><string>$LOG</string>
    <key>StandardErrorPath</key><string>$LOGDIR/osm-replicate.err.log</string>
</dict>
</plist>
PLISTEOF

    echo "wrote:"
    echo "  $WRAPPER"
    echo "  $PLIST   ($SCHED_DESC, --days $DAYS)"
    launchctl unload "$PLIST" 2>/dev/null || true
    launchctl load "$PLIST"
    echo "loaded $LABEL — the replication stream now advances nightly."
    echo "  logs: $LOG  ·  check: fw svc osm-replicate --status"
    ;;
esac
