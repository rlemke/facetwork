#!/usr/bin/env bash
# Start the AFL MCP server.
#
# Usage:
#   fw svc mcp                                # start stdio server
#   fw svc mcp --config /path/to/config.json  # custom config
#   fw svc mcp --help                         # show options

source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
set -euo pipefail

REPO_ROOT="$FW_ROOT"

PYTHON="${REPO_ROOT}/.venv/bin/python3"
[[ -x "$PYTHON" ]] || PYTHON=python3

exec env PYTHONPATH="$REPO_ROOT" "$PYTHON" -m facetwork.mcp "$@"
