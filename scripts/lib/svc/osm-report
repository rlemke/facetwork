#!/usr/bin/env bash
# fw-summary: status report on the OSM extract stores (sizes, ages, missing regions)
#
# WHAT THIS ANSWERS
#   How big is the OSM cache, when was each tier last updated, when was its DATA
#   last current, and what is missing?
#
# ⚠️ "Last updated" is two different clocks and the report keeps them apart.
#   mtime is when we WROTE the file. The replication timestamp in the sibling
#   `-updates/state.txt` is when the DATA was current. On this store they differ
#   by up to 53 days, and only the second one answers "is this stale?".
#   1,105 extracts cannot answer it at all (empty or partial state.txt) — that is
#   reported as its own category, never folded into "old" and never assumed fresh.
#
# ⚠️ There are TWO stores and they are NOT interchangeable. The MinIO bucket holds
#   8 continents + ~3,900 sub-regions and is what our workflows read; the served
#   tree at :8088 holds continents ONLY and is what the replication URL stamped
#   into every PBF header points at. Repointing a consumer from one to the other
#   404s every sub-region. Both are always shown, side by side.
#
# ⚠️ Exit codes: 0 = report written, 2 = could not survey. There is deliberately
#   NO exit 1. This describes; `fw svc osm-watchdog` alarms, and it stays trivial
#   so the thing whose job is to notice breakage has little in it to break.
#
# Usage:
#   fw svc osm-report                      # write the report locally
#   fw svc osm-report --publish            # ... and into s3://osm-extracts/_report/
#   fw svc osm-report --json               # machine-readable to stdout
#   fw svc osm-report --install            # daily timer (backstop; see below)
#   fw svc osm-report --status | --uninstall
#
# The report is regenerated from the stores, so it is only ever as current as its
# last run. `osm-replicate` and `osm-admin-regen` call it after they change the
# cache; the daily timer is the BACKSTOP, because a report that only refreshes
# when an updater runs shows month-old data looking permanently fresh the moment
# that updater stops — which is the exact silent failure the watchdog exists for.
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
source "$FW_LIB/_helpers/_env.sh"
set -uo pipefail

LABEL="com.facetwork.osm-report"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
WRAPPER="$HOME/.facetwork/osm-report.sh"
LOG="$HOME/.facetwork/osm-report.log"
ACTION="run" EVERY_HOURS=24 PASS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --install) ACTION="install"; shift ;;
        --uninstall|--remove) ACTION="uninstall"; shift ;;
        --status) ACTION="status"; shift ;;
        --every-hours) EVERY_HOURS="$2"; shift 2 ;;
        -h|--help) sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) PASS+=("$1"); shift ;;
    esac
done

PYBIN="${PYTHON:-$FW_ROOT/.venv/bin/python}"
[ -x "$PYBIN" ] || PYBIN="$(command -v python3)"
MODULE="$FW_LIB/svc/_osm_report.py"

case "$ACTION" in
run)
    exec "$PYBIN" "$MODULE" ${PASS[@]+"${PASS[@]}"}
    ;;

status)
    echo "label:   $LABEL"
    if [ -f "$PLIST" ]; then
        echo "plist:   $PLIST"
        launchctl list | grep -F "$LABEL" | sed 's/^/  /' || echo "  (not loaded)"
    else
        echo "plist:   not installed  (fw svc osm-report --install)"
    fi
    R="$HOME/.facetwork/osm-cache-report.md"
    if [ -f "$R" ]; then
        # ⚠️ The report's own age is the first thing to print. A stale report of
        # a healthy cache and a fresh report of a stale cache look identical if
        # you only read the contents.
        echo "report:  $R"
        echo "         generated $(sed -n 's/^\*\*Generated \(.*\)\*\* on.*/\1/p' "$R" | head -1)"
        AGE=$(( ( $(date +%s) - $(stat -f %m "$R" 2>/dev/null || stat -c %Y "$R") ) / 3600 ))
        echo "         file age  ${AGE}h"
        [ "$AGE" -gt 48 ] && echo "         ⚠️ older than 48h — the numbers in it describe the past, not now"
    else
        echo "report:  none yet"
    fi
    exit 0
    ;;

uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null \
        || launchctl unload "$PLIST" 2>/dev/null
    rm -f "$PLIST"
    echo "removed $LABEL"
    exit 0
    ;;

install)
    if ! command -v launchctl >/dev/null 2>&1; then
        echo "launchd is macOS-only. On Linux use a systemd timer or cron:" >&2
        echo "  0 6 * * *  $FW_ROOT/fw svc osm-report --publish" >&2
        exit 2
    fi
    mkdir -p "$HOME/.facetwork" "$HOME/Library/LaunchAgents"
    # ⚠️ Exec the venv interpreter explicitly. Under launchd a bare `python3`
    # resolves to Xcode's sandboxed 3.9, which has none of the deps and raises
    # "Operation not permitted" on the external volume — the same trap
    # osm-replicate documents.
    cat > "$WRAPPER" <<WEOF
#!/bin/bash
# Generated by \`fw svc osm-report --install\`. Do not edit; re-run the installer.
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PYTHONUNBUFFERED=1
[ -f "\$HOME/.facetwork/fleet-secrets.env" ] && . "\$HOME/.facetwork/fleet-secrets.env"
cd "$FW_ROOT" || exit 1
exec "$FW_ROOT/fw" svc osm-report --publish
WEOF
    chmod +x "$WRAPPER"
    cat > "$PLIST" <<PEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$WRAPPER</string></array>
  <key>StartInterval</key><integer>$((EVERY_HOURS * 3600))</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
PEOF
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
        || launchctl load "$PLIST"
    echo "installed $LABEL — every ${EVERY_HOURS}h, publishing to s3://osm-extracts/_report/"
    echo "  log: $LOG"
    exit 0
    ;;
esac
