#!/usr/bin/env bash
# Docker VM disk guard — keep the Docker Desktop VM's disk from filling up and
# ENOSPC-crashing the bundled MongoDB/MinIO (WiredTiger panics when it can't
# write its journal; on a full VM disk mongo crash-loops and the whole fleet
# halts — see docs/operations/deployment.md).
#
# When the Docker VM root fs is at/over THRESHOLD%, reclaim:
#   - build cache (always safe; rebuilt on demand)
#   - unused images (safe: images in use by a running container are kept, and
#     anything pruned is re-pullable from the registry / rebuildable)
#   - stopped containers
# It NEVER touches volumes (your data: mongo, minio, postgis).
#
# Run from cron, e.g. every 30 min:
#   */30 * * * * /Users/ralph_lemke/facetwork/scripts/docker-disk-guard >/dev/null 2>&1
#
# Env:
#   DOCKER_DISK_THRESHOLD   prune at/over this % (default 80)
#   DOCKER_DISK_GUARD_LOG   log file (default ~/.docker-disk-guard.log)
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
set -uo pipefail

# cron runs with a minimal PATH — make sure docker resolves.
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

THRESHOLD="${DOCKER_DISK_THRESHOLD:-80}"
LOG="${DOCKER_DISK_GUARD_LOG:-$HOME/.docker-disk-guard.log}"
ts() { date '+%Y-%m-%dT%H:%M:%S'; }

command -v docker >/dev/null 2>&1 || { echo "$(ts) ERROR: docker not on PATH" >>"$LOG"; exit 1; }
docker info >/dev/null 2>&1 || { echo "$(ts) ERROR: docker daemon not responding" >>"$LOG"; exit 1; }

# Docker VM root fs usage % (the overlay that holds /var/lib/docker — images,
# volumes, container layers). Read from inside the VM; the host's df is unrelated.
read_used() { docker run --rm busybox df / 2>/dev/null | awk 'NR==2{gsub(/%/,"",$5); print $5}'; }

used="$(read_used)"
if ! [[ "$used" =~ ^[0-9]+$ ]]; then
    echo "$(ts) ERROR: could not read Docker VM disk usage" >>"$LOG"
    exit 1
fi

if [ "$used" -lt "$THRESHOLD" ]; then
    echo "$(ts) ok: VM disk ${used}% < ${THRESHOLD}% — no prune" >>"$LOG"
    exit 0
fi

echo "$(ts) HIGH: VM disk ${used}% >= ${THRESHOLD}% — reclaiming" >>"$LOG"
bc="$(docker builder prune -f 2>&1 | grep -i 'reclaimed' | tail -1)"
ip="$(docker image prune -af 2>&1 | grep -i 'reclaimed' | tail -1)"
cp="$(docker container prune -f 2>&1 | grep -i 'reclaimed' | tail -1)"
after="$(read_used)"
echo "$(ts) done: ${used}% -> ${after:-?}%  [build:${bc:-0}] [images:${ip:-0}] [containers:${cp:-0}]" >>"$LOG"
