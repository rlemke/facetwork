#!/usr/bin/env bash
# fw-summary: migrate seeded domain flows from the example: prefix to domain: (default dry-run)
#
# Part of the examples->domains rename. Only the domain packages flip; teaching
# examples keep example:. Idempotent and UUID-preserving (an in-flight
# fw:execute task keeps resolving). Default is a dry-run; pass --apply to write.
# Run AFTER every host is on the new image (so runners seed domains under
# domain:, not re-creating example:<domain>); safe to re-run.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
source "$FW_LIB/_helpers/_env.sh"

PYTHON="$FW_ROOT/.venv/bin/python3"; [ -x "$PYTHON" ] || PYTHON=python3
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --apply|--yes) ARGS+=(--apply); shift ;;
        --dry|--dry-run) shift ;;
        --mongo) export FW_MONGODB_URL="$2"; shift 2 ;;
        -h|--help)
            sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'
            echo; echo "Usage: fw maint migrate-seed-prefix [--apply] [--mongo URL]"
            exit 0 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

exec env PYTHONPATH="$FW_ROOT" "$PYTHON" -m facetwork.domains.migrate ${ARGS[@]+"${ARGS[@]}"}
