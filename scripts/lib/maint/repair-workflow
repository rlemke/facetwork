#!/usr/bin/env bash
# Diagnose and repair a stuck AFL workflow.
#
# Performs seven checks:
#   1. Runner state — if completed/failed but has non-terminal work, reset to running
#   2. Orphaned tasks — running tasks on dead/shutdown servers → pending
#   3. Transient step errors — connection/timeout errors → retry (EventTransmit)
#   4. Ancestor blocks — reset errored ancestors so execution resumes
#   5. Dead-lettered tasks — re-enqueue with retry count reset, fix steps and ancestors
#   6. Inconsistent steps — steps marked Complete but with failed tasks → reset
#   7. Stranded block steps — every task terminal but block-level steps never
#      cascaded, so the runner stays 'running' forever (the county-atlas 49-hour
#      stall). Resumed here via the evaluator; --dry lists them without resuming.
#
# Usage:
#   fw maint repair-workflow <runner_id>
#   fw maint repair-workflow --dry <runner_id>
#   fw maint repair-workflow --mongo mongodb://server3.local:27017 <runner_id>
#
# Environment:
#   FW_MONGODB_URL    MongoDB connection string (default from .env)
#
# --mongo overrides FW_MONGODB_URL. Needed on any host that is not the DB: those
# .env files resolve to localhost:27017, so without it the command dies on a raw
# pymongo connection error (matches `fw fleet --mongo` / `fw runner --mongo`).

source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
set -euo pipefail

REPO_ROOT="$FW_ROOT"
source "$FW_LIB/_helpers/_env.sh"

DRY_RUN=false
RUNNER_ID=""
MONGO_URL=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry)  DRY_RUN=true; shift ;;
        --mongo)
            [[ $# -ge 2 ]] || { echo "--mongo needs a URL" >&2; exit 1; }
            MONGO_URL="$2"; shift 2 ;;
        -h|--help)
            awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
            exit 0
            ;;
        -*)     echo "Unknown option: $1" >&2; exit 1 ;;
        *)      RUNNER_ID="$1"; shift ;;
    esac
done

if [[ -z "$RUNNER_ID" ]]; then
    echo "Usage: fw maint repair-workflow [--dry] <runner_id>" >&2
    exit 1
fi

# Export so `load_config()` sees it — same precedence as every other fw command,
# rather than threading a second connection path through the Python below.
[[ -n "$MONGO_URL" ]] && export FW_MONGODB_URL="$MONGO_URL"

PYTHON="${REPO_ROOT}/.venv/bin/python3"
[[ -x "$PYTHON" ]] || PYTHON=python3

exec env PYTHONPATH="$REPO_ROOT" "$PYTHON" -c "
import sys
import json

runner_id = '$RUNNER_ID'
dry_run = '$DRY_RUN' == 'true'

from facetwork.config import load_config
from facetwork.runtime.mongo_store import MongoStore
from facetwork.runtime.workflow_repair import repair_workflow as _repair

config = load_config()
mongo_url = config.mongodb.connection_string()

def _unreachable(exc):
    # A bare pymongo ServerSelectionTimeoutError is almost always 'ran this on a
    # host whose .env says localhost' — say that instead of 40 lines of traceback.
    return 'ServerSelectionTimeout' in type(exc).__name__ or 'Connection refused' in str(exc)

def _die_unreachable():
    print(f'Error: cannot reach MongoDB at {mongo_url}', file=sys.stderr)
    print('       Pass --mongo mongodb://<db-host>:27017 (or set FW_MONGODB_URL).', file=sys.stderr)
    print('       Hosts that are not the DB have localhost in their .env.', file=sys.stderr)
    sys.exit(1)

# The connection is established lazily, so the timeout can surface either at
# construction or on the first operation — guard both.
try:
    store = MongoStore(mongo_url, config.mongodb.database)
except Exception as e:
    if _unreachable(e):
        _die_unreachable()
    raise

try:
    result = _repair(store, runner_id, dry_run=dry_run)
except ValueError as e:
    print(f'Error: {e}', file=sys.stderr)
    sys.exit(1)
except Exception as e:
    if _unreachable(e):
        _die_unreachable()
    raise

prefix = '(dry run) ' if dry_run else ''

print(f'=== {prefix}Workflow Repair: {result[\"runner_id\"][:12]} ===')
print(f'Workflow: {result[\"workflow_id\"]}')
print()

if result['runner_reset']:
    print(f'  Runner: reset from {result[\"runner_previous_state\"]} -> running')
else:
    print(f'  Runner: OK ({result[\"runner_previous_state\"]})')

orphaned = result['orphaned_tasks_reset']
print(f'  Orphaned tasks reset: {len(orphaned)}')
for t in orphaned:
    print(f'    {t[\"name\"]}  step={t[\"step_id\"][:12]}  server={t[\"server_id\"][:12] if t[\"server_id\"] else \"(none)\"}')

retried = result['transient_steps_retried']
print(f'  Transient errors retried: {len(retried)}')
for s in retried:
    print(f'    {s[\"facet_name\"] or s[\"step_id\"][:12]}  error={s[\"error_snippet\"]}')

ancestors = result['ancestors_reset']
print(f'  Ancestor blocks reset: {len(ancestors)}')

dead_letter = result.get('dead_letter_tasks_reset', [])
print(f'  Dead-lettered tasks re-enqueued: {len(dead_letter)}')
for t in dead_letter:
    print(f'    {t["name"]}  step={t["step_id"][:12]}  error={t["error"][:80]}')

inconsistent = result.get('inconsistent_steps_reset', [])
print(f'  Inconsistent steps reset: {len(inconsistent)}')
for s in inconsistent:
    print(f'    {s["facet_name"] or s["step_id"][:12]}  (step=Complete, task={s["task_state"]})')

stranded = result.get('stranded_block_steps', [])
resumed = result.get('stranded_resumed', 0)
unresolved = result.get('stranded_unresolved', len(stranded))
print(f'  Stranded block steps: {len(stranded)}')
if stranded:
    from collections import Counter
    by_state = Counter(s['state'].rsplit('.', 1)[-1] for s in stranded)
    print(f'    states: {dict(by_state)}')
    oldest = max((s['age_ms'] or 0) for s in stranded) / 3600000.0
    print(f'    oldest: {oldest:.1f}h  (every task in this workflow is terminal)')
    if not dry_run:
        print(f'    resumed: {resumed}/{len(stranded)}')
        if result.get('stranded_error'):
            print('    WARNING: ' + result['stranded_error'])
        left = len(store.get_stuck_steps_for_workflow(result['workflow_id']))
        print(f'    still stuck after resume: {left}')

total = (1 if result['runner_reset'] else 0) + len(orphaned) + len(retried) + len(ancestors) + len(dead_letter) + len(inconsistent) + (resumed if not dry_run else len(stranded))
print()
if total == 0 and not stranded:
    print('No issues found.')
elif stranded and not dry_run and unresolved:
    # Detected but could not fix: say so. Reporting 'No issues found' here would
    # be the same lie the missing check produced in the first place.
    print(f'{prefix}Applied {total} repair(s); {unresolved} stranded '
          f'step(s) COULD NOT be resumed — see the warnings above.')
    sys.exit(1)
else:
    print(f'{prefix}Applied {total} repair(s).')

store._client.close()
"
