#!/usr/bin/env python3
# fw-summary: find pending tasks whose resource requirements no runner can ever meet
#
# Resource-aware claim routing keeps a task away from runners that cannot serve
# it. That is the point — a runner should never accept work it will only fail.
# But it creates a new way to disappear: a task demanding more than ANY host has
# is simply never claimed. It does not error, it does not retry, it does not
# dead-letter. It waits, silently, forever.
#
# That is the same shape as every other silent gap in this system (the dead
# letters nobody watched, the reconcile that only ever logged "lagging"), so it
# gets the same treatment: something must ask the standing question.
#
# ⚠️ Exit codes are load-bearing, matching `fw maint dead-letters`:
#     0  nothing unsatisfiable
#     1  at least one task no live runner can serve
#     2  could not tell (no Mongo, no live servers to compare against)
# Only 1 is a real alarm. Reporting "unsatisfiable" when the fleet is merely
# offline would train you to ignore it.
"""Report pending tasks no live runner can ever claim.

Two independent routing dimensions can strand a task, and both fail the same
silent way: never claimed, never retried, never dead-lettered.

  requires           a resource floor (memory_gb, scratch_gb, ...) that exceeds
                     every live host's advertised capacity
  environment_hash   a script environment no live runner provides

⚠️ The second was missing and it is the one that actually bit. A new
`environment` declared outside examples/canonical/ was never baked (the
Dockerfile copied only that directory), and the built-in fw.file.FileOps
environment survived in images purely as a stale cached layer -- the first
change that invalidated it removed the environment entirely. In both cases
script tasks carried an environment_hash no runner advertised and sat pending
forever while this check reported "OK". It was looking at the wrong dimension.
"""
from __future__ import annotations

import argparse
import os
import sys

# `fw` execs this file directly, so nothing has sourced .env - see _dotenv.
import pathlib

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "_helpers"))
from _dotenv import load_env  # noqa: E402

load_env(__file__)


# fw execs this file, so the shebang picked the SYSTEM python — which on three
# of this fleet's four hosts has no pymongo. This check therefore exited 2
# ("could not verify") everywhere but the host it was written on, for its whole
# life, without ever looking broken.
from venv_reexec import ensure_venv  # noqa: E402

ensure_venv(__file__, "pymongo")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--mongo", default=os.environ.get("FW_MONGODB_URL")
                    or "mongodb://localhost:27017")
    ap.add_argument("--database", default=os.environ.get("FW_MONGODB_DATABASE") or "facetwork")
    ap.add_argument("--stale-server-minutes", type=float, default=5.0,
                    help="ignore servers whose heartbeat is older than this")
    a = ap.parse_args()

    try:
        import pymongo
    except ImportError:
        print("pymongo is required", file=sys.stderr)
        return 2

    try:
        db = pymongo.MongoClient(a.mongo, serverSelectionTimeoutMS=8000).get_database(a.database)
        # ⚠️ NOT filtered to tasks that declare a constraint. The handler-name
        # dimension applies to EVERY task, and the task it strands declares
        # nothing at all: an event-facet task whose facet no live runner has a
        # handler for is never CLAIMED, so it is never released-with-backoff,
        # so retry_count stays 0 and it never dead-letters. Measured
        # 2026-09-02: repro.asteroids.PickExposure sat pending 8h at retry=0
        # while this check reported OK, because it was reading only the two
        # fields the task left empty.
        pending = list(db.tasks.find(
            {"state": "pending"},
            {"uuid": 1, "name": 1, "requires": 1, "environment_hash": 1, "kind": 1,
             "kind": 1, "created": 1}))
        servers = list(db.servers.find({"state": "running"},
                                       {"server_name": 1, "resources": 1, "ping_time": 1,
                                        "provided_environments": 1, "handlers": 1}))
    except Exception as exc:  # noqa: BLE001
        print(f"could not query {a.mongo}: {type(exc).__name__}", file=sys.stderr)
        return 2

    import time
    now = time.time() * 1000
    live = [s for s in servers
            if (now - float(s.get("ping_time") or 0)) / 60000 <= a.stale_server_minutes]
    if not live:
        # No live fleet to compare against: cannot distinguish "impossible" from
        # "nobody is home". Do not alarm — see the exit-code note above.
        print("could not verify: no live servers to compare against")
        return 2

    # Best capacity the fleet offers per dimension. A task is unsatisfiable only
    # if NO single host meets ALL of its dimensions — checking per-host, not
    # against a per-dimension maximum, because capacity does not combine across
    # machines.
    def fits(need: dict, res: dict) -> bool:
        for dim, want in (need or {}).items():
            cap = res.get(dim)
            if not isinstance(cap, (int, float)) or want > cap:
                return False
        return True

    provided = set()
    served = set()
    for s in live:
        provided.update(s.get("provided_environments") or [])
        served.update(str(h) for h in (s.get("handlers") or []))

    bad = []
    for t in pending:
        need = t.get("requires") or {}
        env = (t.get("environment_hash") or "").strip()
        why = []
        if need and not any(fits(need, s.get("resources") or {}) for s in live):
            why.append(f"requires {need}")
        if env and env not in provided:
            why.append(f"environment {env[:16]} provided by NO live runner")
        # A script task is named by its facet and is in no runner's handler
        # set — the environment IS its capability (see
        # persistence.claim_script_task), so the name dimension does not apply
        # to it. Protocol tasks are handled by every runner by definition.
        name = t.get("name") or ""
        is_protocol = name.startswith("fw:") or name.startswith("_fw")
        if (t.get("kind") or "") != "script" and not is_protocol and not env:
            if name not in served:
                why.append(f"no live runner has a handler for {name}")
        if why:
            bad.append((t, "; ".join(why)))

    n_env = sum(1 for t in pending if (t.get("environment_hash") or "").strip())
    n_named = sum(
        1 for t in pending
        if (t.get("kind") or "") != "script"
        and not (t.get("name") or "").startswith(("fw:", "_fw"))
        and not (t.get("environment_hash") or "").strip()
    )
    if not bad:
        # "with routing constraints" was accurate only while the query filtered
        # to tasks declaring one. It now covers EVERY pending task, and saying
        # otherwise would understate what was checked.
        print(f"OK — all {len(pending)} pending task(s) are servable by at least "
              f"one of {len(live)} live runner(s) "
              f"({n_env} env-routed, {n_named} name-routed)")
        return 0

    print(f"{len(bad)} pending task(s) NO live runner can serve "
          f"(checked against {len(live)} runner(s)):\n")
    for t, why in bad[:20]:
        age_h = (now - float(t.get("created") or now)) / 3_600_000
        print(f"  {t.get('name','?')[:44]:44s} waiting {age_h:5.1f}h  {why}")
    # One row per DISTINCT (host, capacity). A fleet of 85 runners is ~20
    # processes per host all advertising the same numbers, and printing every
    # one buried the single finding under 85 near-identical lines. This runs on
    # a timer now; a report nobody reads to the end is a report nobody reads.
    print("\n  fleet capacity:")
    seen = {}
    for s in live:
        key = (s.get("server_name", "?"), str(s.get("resources") or "(none advertised)"))
        seen[key] = seen.get(key, 0) + 1
    for (host, res), n in sorted(seen.items()):
        print(f"    {host:10s} x{n:<3d} {res}")
    print(f"\n  environments provided across the fleet: "
          f"{sorted(e[:16] for e in provided) or '(none)'}")
    if any("environment" in w for _, w in bad):
        if any("has a handler for" in r for _, r in bad):
            print("\n  An unserved NAME usually means the domain is not deployed to the")
            print("  fleet (a local-checkout runner served it once and is now gone), or a")
            print("  runner's --topics scoping excludes it. Such a task is never claimed,")
            print("  so it never retries and never dead-letters — it only disappears.")
        print("\n  An unprovided environment usually means the image did not BAKE it.")
        print("  Check the build:  fw ffl bake-envs --check   /   envbake in the runner image")
    print("\n  These will NOT retry and will NOT dead-letter — they are simply never")
    print("  claimed. Lower the requirement, add a capable host, or terminate them:")
    print("    fw maint terminate-workflow <runner_id>")
    return 1


if __name__ == "__main__":
    sys.exit(main())
