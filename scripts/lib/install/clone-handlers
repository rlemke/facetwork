#!/usr/bin/env bash
# fw-summary: git clone every catalog domain repo into ~/fw_handlers (skip existing)
#
# Bulk raw clone of the fwh_* domain repos listed in the catalog (domains.json +
# FW_DOMAINS_FILE / domains.local.json overrides) — NOT a hardcoded list. For
# clone + `pip install -e` in one step prefer `fw install domain --all`; this is
# just the clones (no pip). Already-cloned repos are skipped.
#
# Usage:
#   fw install clone-handlers          # clone any missing domain repos
#   fw install clone-handlers --dry    # show what would be cloned/skipped
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_catalog.sh"
set -euo pipefail

DRY=0
{ [ "${1:-}" = "--dry" ] || [ "${1:-}" = "--dry-run" ]; } && DRY=1

ROOT="${FWH_HANDLERS_ROOT:-$HOME/fw_handlers}"
[ "$DRY" = 1 ] || mkdir -p "$ROOT"

while IFS=$'\x1f' read -r name repo _extras _desc; do
    [ -n "$repo" ] || continue
    dest="$ROOT/$repo"
    if [ -d "$dest/.git" ]; then
        echo "✓ $repo already cloned ($dest)"
    elif [ "$DRY" = 1 ]; then
        echo "→ would clone $repo  ($name)"
    else
        echo "→ cloning $repo"
        git clone "https://github.com/rlemke/$repo.git" "$dest"
    fi
done < <(catalog_domain_rows)
