#!/usr/bin/env bash
# Repair a virtualenv whose console-script shebangs / activate scripts point at a
# stale path — e.g. after the venv (or its parent dir) was moved or renamed.
#
# A venv's `bin/<tool>` scripts (pip, pytest, mypy, uvicorn, …) bake an ABSOLUTE
# shebang to the interpreter, and the `activate*` files hardcode VIRTUAL_ENV. If
# the venv is relocated, all of those break with "bad interpreter". The python
# symlink itself is relative, so `bin/python -m <tool>` keeps working — this
# rewrites the rest to match the venv's CURRENT location.
#
# Usage:
#   scripts/repair-venv                 # repair ./.venv (or $VIRTUAL_ENV)
#   scripts/repair-venv /path/to/.venv  # repair a specific venv
#   scripts/repair-venv --dry           # show what would change, make no edits
#
# Idempotent and safe to re-run. Only touches regular text files under bin/;
# symlinks and binaries are skipped.

source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
set -euo pipefail

DRY=0
VENV=""
for a in "$@"; do
    case "$a" in
        --dry|-n) DRY=1 ;;
        *) VENV="$a" ;;
    esac
done

if [[ -z "$VENV" ]]; then
    if [[ -n "${VIRTUAL_ENV:-}" ]]; then
        VENV="$VIRTUAL_ENV"
    else
        VENV="$FW_ROOT/.venv"
    fi
fi
VENV="$(cd "$VENV" 2>/dev/null && pwd || true)"
if [[ -z "$VENV" || ! -x "$VENV/bin/python" ]]; then
    echo "Error: no venv python at '${VENV:-?}/bin/python'." >&2
    exit 1
fi

# Drive the rewrite from the venv's own interpreter (immune to a stale pip shebang).
"$VENV/bin/python" - "$VENV" "$DRY" <<'PYEOF'
import os, sys

venv, dry = sys.argv[1], sys.argv[2] == "1"
bindir = os.path.join(venv, "bin")


def read_text(p):
    try:
        with open(p, "r", encoding="utf-8") as f:
            return f.read()
    except (UnicodeDecodeError, OSError):
        return None  # binary or unreadable


files = [
    os.path.join(bindir, n)
    for n in sorted(os.listdir(bindir))
    if not os.path.islink(os.path.join(bindir, n)) and os.path.isfile(os.path.join(bindir, n))
]

py = os.path.join(bindir, "python")   # relative symlink -> always-correct interpreter
base = os.path.basename(venv)

# Discover THIS venv's stale (old) location from shebangs pointing at a
# `<OLD>/bin/pythonX.Y` whose basename matches this venv's (e.g. `.venv`). Used
# to fix the absolute paths embedded in the `activate*` scripts (which have no
# shebang to normalize). Basename match avoids grabbing an unrelated path.
stale = set()
for p in files:
    first = (read_text(p) or "").splitlines()[:1]
    first = first[0] if first else ""
    if first.startswith("#!") and "/bin/python" in first:
        prefix = os.path.dirname(os.path.dirname(first[2:].split()[0]))
        if prefix and prefix != venv and os.path.basename(prefix) == base:
            stale.add(prefix)

fixed = 0
for p in files:
    t = read_text(p)
    if t is None:
        continue
    lines = t.splitlines(keepends=True)
    nt = t

    # 1. Normalize a python interpreter shebang to THIS venv's python. Every
    #    console script in a venv's bin/ should run the venv interpreter; this
    #    repairs both moved-venv shebangs and any pointing at the base python.
    if lines and lines[0].startswith("#!") and "python" in lines[0].lower():
        want = "#!" + py + "\n"
        if lines[0] != want:
            lines[0] = want
            nt = "".join(lines)

    # 2. Swap the old venv path inside activate* scripts (VIRTUAL_ENV + PATH).
    for old in stale:
        nt = nt.replace(old, venv)

    if nt != t:
        fixed += 1
        print(("WOULD FIX " if dry else "fixed     ") + os.path.relpath(p, venv))
        if not dry:
            with open(p, "w", encoding="utf-8") as f:
                f.write(nt)

print(f"\n{'(dry-run) ' if dry else ''}{fixed} file(s) "
      f"{'would be ' if dry else ''}repointed at {venv}"
      + (f"  (old: {', '.join(sorted(stale))})" if stale else ""))
PYEOF