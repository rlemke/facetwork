#!/usr/bin/env bash
# fw-summary: git pull every catalog domain repo in ~/fw_handlers (no pip reinstall)
#
# Fast source refresh of the cloned fwh_* domain repos listed in the catalog
# (domains.json + overrides) — NOT a hardcoded list. Editable installs pick up
# source changes without a reinstall; for a full `pip install -e` (e.g. after an
# entry-point change) use `fw install domain --all` instead. Missing clones are
# reported, not fatal.
#
# Usage:
#   fw install pull-handlers          # git pull each cloned domain repo
#   fw install pull-handlers --dry    # show what would be pulled/skipped
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_catalog.sh"
set -euo pipefail

DRY=0
{ [ "${1:-}" = "--dry" ] || [ "${1:-}" = "--dry-run" ]; } && DRY=1

ROOT="${FWH_HANDLERS_ROOT:-$HOME/fw_handlers}"

while IFS=$'\x1f' read -r name repo _extras _desc; do
    [ -n "$repo" ] || continue
    dest="$ROOT/$repo"
    if [ ! -d "$dest/.git" ]; then
        echo "✗ $repo not cloned ($dest) — fw install clone-handlers, or fw install domain $name"
    elif [ "$DRY" = 1 ]; then
        echo "→ would pull $repo  ($name)"
    else
        echo "→ $repo"
        git -C "$dest" pull --ff-only
    fi
done < <(catalog_domain_rows)
