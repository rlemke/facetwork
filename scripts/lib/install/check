#!/usr/bin/env bash
# fw-summary: analyze missing test/example dependencies on this host (optionally --install them)
#
# Scans tests/ + examples/ for imported third-party modules (both hard imports
# and pytest.importorskip(...) markers), reports which are NOT importable on this
# host, and cross-checks the standalone example packages against what's actually
# installed (facetwork.examples entry points). It also reports SCRIPT ENVIRONMENT
# coverage: which declared `environment`s this host actually provides under
# FW_ENV_ROOT. With --install it installs the gaps: example-provided modules via
# `fw install domain <name>`, script environments via envbake materialization,
# everything else via pip (boto3 → the facetwork [s3] extra).
#
# This is the automation of the host-by-host gap hunt: a fresh runner host can
# run `fw install check --install` instead of discovering missing deps via failed
# test runs. Environment coverage is the same class of gap one level up: a host
# missing a declared environment never CLAIMS its script tasks (they carry the
# manifest hash), so the work simply doesn't run here — silently.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
# Load .env, so FW_ENV_ROOT here is the one the RUNNERS will use. Without this,
# the section that reports script-environment coverage read the /opt/fw_envs
# default while a host with an unwritable /opt had FW_ENV_ROOT pointed elsewhere
# in .env — reporting a materialized environment as missing. An advisory check
# that disagrees with the runtime is worse than none: this gap is silent by
# nature (a host missing an environment simply never CLAIMS its script tasks),
# so the report is the only signal there is.
source "$FW_LIB/_helpers/_env.sh"

PYTHON="$FW_ROOT/.venv/bin/python3"; [ -x "$PYTHON" ] || PYTHON=python3
INSTALL=0 BREAK=0 COMMANDS_ONLY=0 FLEET=0 JSON=0 QUIET=0
for a in "$@"; do
    case "$a" in
        --install|--fix) INSTALL=1 ;;
        --dry|--dry-run) INSTALL=0 ;;
        --break-system-packages) BREAK=1 ;;
        --commands) COMMANDS_ONLY=1 ;;
        --fleet) FLEET=1 ;;
        --json) JSON=1 ;;
        --quiet) QUIET=1 ;;
        -h|--help)
            sed -n '3,17p' "$0" | grep -v '^# fw-summary:' | sed 's/^# \{0,1\}//'
            echo; echo "Usage: fw install check [--install] [--break-system-packages]"
            echo "       fw install check --commands [--json|--quiet]   # section 4 only"
            echo "       fw install check --fleet                       # section 4 on every host"
            exit 0 ;;
        *) echo "unknown arg: $a" >&2; exit 2 ;;
    esac
done

STARTABILITY="$FW_LIB/_helpers/_startability.py"

# --- [4] on every host ----------------------------------------------------
# A command that cannot start is a PER-HOST fact, and the whole point is that
# it is invisible from the host where it works. `fw maint unsatisfiable` ran
# only on the machine it was written on for its entire life.
if [ "$FLEET" -eq 1 ]; then
    HOSTS="${FW_RUNNER_HOSTS:-}"
    if [ -z "$HOSTS" ] && [ -f "$FW_ROOT/servers.json" ]; then
        HOSTS="$("$PYTHON" -c "import json,sys;print(' '.join(s['name'] for s in json.load(open(sys.argv[1]))['servers']))" "$FW_ROOT/servers.json" 2>/dev/null || true)"
    fi
    [ -z "$HOSTS" ] && { echo "could not verify: no hosts (set FW_RUNNER_HOSTS or add servers.json)" >&2; exit 2; }
    SELF="$(hostname -s 2>/dev/null || hostname)"
    # ⚠️ Always include THIS host. FW_RUNNER_HOSTS names the machines you deploy
    # TO, so a sweep driven by it silently omits the one you are standing on —
    # which is the host where everything looks fine, and the reason a per-host
    # failure stayed invisible for as long as it did.
    case " $HOSTS " in *" $SELF "*|*" $SELF."*) ;; *) HOSTS="$SELF $HOSTS" ;; esac
    rc=0; reached=0
    echo "fw command startability across the fleet"
    echo
    # ⚠️ Probed in BOTH shell contexts, because they resolve DIFFERENT
    # interpreters and the honest answer differs between them. Measured
    # 2026-09-02: server1 finds /usr/local/bin/python3 (has pymongo) at login
    # and /usr/bin/python3 (3.9, does not) when scheduled — so `fw fleet config`
    # works when a human runs it and fails from launchd. Reporting one number
    # would have been wrong whichever we picked, and the context that matters
    # for a scheduled job is the one that fails.
    for h in $HOSTS; do
        short="${h%%.*}"
        printf '  %s\n' "$short"
        host_rc=0; got=0
        for ctx in login scheduled; do
            # $SHELL, not bash: the login PATH lives in the USER'S shell rc
            # files. Probing with `bash -lc` on a zsh host reported
            # /usr/bin/python3 while a real login resolves homebrew — the probe
            # was measuring a shell nobody uses. Single-quoted so $SHELL expands
            # on the REMOTE host.
            if [ "$ctx" = "login" ]; then remote='$SHELL -lc "cd ~/facetwork && ./fw install check --commands --json"'
            else                          remote='cd ~/facetwork && ./fw install check --commands --json'; fi
            if [ "$short" = "$SELF" ]; then
                if [ "$ctx" = "login" ]; then out="$("${SHELL:-/bin/sh}" -lc "'$PYTHON' '$STARTABILITY' --json" 2>/dev/null || true)"
                else out="$(env -i HOME="$HOME" PATH=/usr/bin:/bin:/usr/sbin:/sbin "$PYTHON" "$STARTABILITY" --json 2>/dev/null || true)"; fi
            else
                out="$(ssh -o ConnectTimeout=8 -o BatchMode=yes "$h" "$remote" 2>/dev/null || true)"
            fi
            if [ -z "$out" ]; then
                printf '      %-12s unreachable or no checkout — UNKNOWN\n' "$ctx"
                [ "$rc" -eq 0 ] && rc=2
                continue
            fi
            got=1
            printf '%s' "$out" | "$PYTHON" -c '
import json, sys
d = json.load(sys.stdin)
ctx = sys.argv[1]
b = d.get("broken", [])
r = d.get("risk", [])
interp = d.get("interpreters", {}).get("system", "?")
tag = "OK" if not b else "%d BROKEN" % len(b)
print("      %-12s %-10s %s" % (ctx, tag, interp))
for x in b:
    print("          \u2717 fw %-24s missing: %s" % (x["cmd"], ", ".join(x["missing"])))
for x in r:
    print("          \u26a0 fw %-24s via system python: %s" % (x["cmd"], ", ".join(x["modules"])))
sys.exit(1 if b else 0)' "$ctx" || host_rc=1
        done
        [ "$got" -eq 1 ] && reached=$((reached+1))
        [ "$host_rc" -eq 1 ] && rc=1
    done
    echo
    echo "  login     = the PATH a login shell / ssh command resolves"
    echo "  scheduled = the PATH a launchd or cron job resolves"
    echo
    echo "  Both are reported because they resolve DIFFERENT interpreters and the"
    echo "  honest answer differs: server1 finds pymongo in /usr/local/bin/python3"
    echo "  at login and /usr/bin/python3 (without it) when scheduled. A command"
    echo "  broken only under 'scheduled' still fails every timer that calls it."
    echo "  ⚠️ An INTERACTIVE terminal can differ again where rc files add to PATH"
    echo "  (server3's .zshrc prepends homebrew); the interpreter path is printed"
    echo "  for each row so the answer is never left to the label."
    echo
    [ "$rc" -eq 1 ] && echo "FAIL — a command cannot start somewhere in the fleet."
    [ "$rc" -eq 2 ] && echo "COULD NOT VERIFY — a host was unreachable (reached $reached)."
    [ "$rc" -eq 0 ] && echo "OK — every command resolves its imports on all $reached reachable host(s), both contexts."
    exit $rc
fi

# --- [4] only -------------------------------------------------------------
if [ "$COMMANDS_ONLY" -eq 1 ]; then
    ARGS=""
    [ "$JSON" -eq 1 ] && ARGS="--json"
    [ "$QUIET" -eq 1 ] && ARGS="$ARGS --quiet"
    exec "$PYTHON" "$STARTABILITY" $ARGS
fi

env FW_ROOT="$FW_ROOT" FW_LIB="$FW_LIB" FW_PYTHON="$PYTHON" FW_INSTALL="$INSTALL" FW_BREAK="$BREAK" \
    "$PYTHON" - <<'PY'
import ast
import os
import re
import subprocess
import sys
from importlib import util as importutil
from importlib.metadata import entry_points

FW_ROOT = os.environ["FW_ROOT"]
FW_LIB = os.environ["FW_LIB"]
PYTHON = os.environ["FW_PYTHON"]
DO_INSTALL = os.environ["FW_INSTALL"] == "1"

# A non-venv (system/Homebrew) python may be PEP 668 externally-managed, which
# blocks pip (even --user on Homebrew). Hosts with a repo .venv install normally;
# a non-venv host needs a venv (fw install repo) or an explicit opt-in override.
IN_VENV = sys.prefix != sys.base_prefix
BREAK = os.environ.get("FW_BREAK") == "1"
PIP_EXTRA = ["--break-system-packages"] if BREAK else []

# Modules that are local/path-hacked or part of this repo — never "missing".
EXCLUDE = {"handlers", "conftest", "facetwork", "examples", "tests", "afl"}
STDLIB = set(getattr(sys, "stdlib_module_names", set()))


def local_example_modules():
    """Top-level module names provided *locally* by an in-repo example (e.g.
    `handlers`, `hiv_helpers`, `maven_runner`). These are importable only once an
    example's conftest puts its dir on sys.path, so they look "missing" to a
    static scan — exclude them. Collect every package/module basename anywhere
    under examples/, minus test files."""
    locals_ = set()
    ex = os.path.join(FW_ROOT, "examples")
    for dp, dirs, files in os.walk(ex):
        if "__pycache__" in dp:
            continue
        if "__init__.py" in files:
            locals_.add(os.path.basename(dp))
        for f in files:
            if f.endswith(".py") and not f.startswith("test_") and f != "conftest.py":
                locals_.add(f[:-3])
    return locals_


EXCLUDE |= local_example_modules()

# How to install a given missing top-level module. Example-provided modules map
# to `fw install domain <name>`; a few belong to a facetwork extra; the rest
# default to `pip install <module>`.
KNOWN = {
    "anthropic_handlers": ("domain", "anthropic"),
    "boto3": ("pip", "-e", f"{FW_ROOT}[s3]"),
    "botocore": ("pip", "-e", f"{FW_ROOT}[s3]"),
}


def scan_imports(roots):
    mods = set()
    for root in roots:
        for dp, _, files in os.walk(root):
            if "__pycache__" in dp:
                continue
            for fn in files:
                if not fn.endswith(".py"):
                    continue
                p = os.path.join(dp, fn)
                try:
                    tree = ast.parse(open(p, encoding="utf-8", errors="ignore").read(), p)
                except Exception:
                    continue
                for node in ast.walk(tree):
                    if isinstance(node, ast.Import):
                        for a in node.names:
                            mods.add(a.name.split(".")[0])
                    elif isinstance(node, ast.ImportFrom):
                        if node.level == 0 and node.module:
                            mods.add(node.module.split(".")[0])
                    elif isinstance(node, ast.Call):
                        f = node.func
                        if (isinstance(f, ast.Attribute) and f.attr == "importorskip"
                                and node.args and isinstance(node.args[0], ast.Constant)
                                and isinstance(node.args[0].value, str)):
                            mods.add(node.args[0].value.split(".")[0])
    return mods


def importable(mod):
    try:
        return importutil.find_spec(mod) is not None
    except Exception:
        return False


def parse_registry():
    """name -> (repo, extras, desc) from the domain catalog (domains.json).

    The catalog is the single source of truth (`fw install domain` reads it via
    _catalog.sh), so read it the same way rather than scraping that script — an
    earlier regex over its inline table silently reported ZERO domains once the
    table moved into domains.json.
    """
    try:
        from facetwork.domains import catalog
    except Exception:
        return {}
    reg = {}
    for name, d in (catalog.domains() or {}).items():
        extras = d.get("extras") or []
        if isinstance(extras, str):
            extras = [e for e in extras.split(",") if e]
        reg[name] = (d.get("repo", ""), ",".join(extras), d.get("description", ""))
    return reg


def installed_examples():
    # Read both groups during the examples->domains cutover (fwh_* may still
    # declare the legacy group).
    names = set()
    for group in ("facetwork.domains", "facetwork.examples"):
        names |= {e.name for e in entry_points(group=group)}
    return names


# --- analyze ---------------------------------------------------------------
roots = [os.path.join(FW_ROOT, "tests"), os.path.join(FW_ROOT, "examples")]
roots = [r for r in roots if os.path.isdir(r)]
mods = scan_imports(roots)
missing_mods = sorted(
    m for m in mods
    if m and not m.startswith("_") and m not in EXCLUDE and m not in STDLIB
    and not importable(m)
)

reg = parse_registry()
inst = installed_examples()
missing_examples = sorted(n for n in reg if n not in inst)

host = os.uname().nodename.split(".")[0]
print(f"Dependency analysis — host {host}, python {PYTHON}")
print()

# Section 1: missing modules the test suite imports (these cause skips/failures)
print("Test/example modules NOT importable here:")
if not missing_mods:
    print("  ✓ none — every module imported by tests/ + examples/ is available")
else:
    for m in missing_mods:
        action = KNOWN.get(m)
        if action and action[0] == "domain":
            hint = f"fw install domain {action[1]}"
        elif action and action[0] == "pip":
            hint = "pip install " + " ".join(action[1:])
        else:
            hint = f"pip install {m}"
        print(f"  ✗ {m:<22} -> {hint}")

# Section 2: example packages (informational — install to run that example)
print()
print("Standalone domain packages (facetwork.domains):")
for name in sorted(reg):
    repo, extras, _ = reg[name]
    mark = "✓ installed" if name in inst else "○ available (not installed)"
    extra_note = f"  [extras: {extras}]" if extras else ""
    print(f"  {mark:<28} {name}{extra_note}")

# Section 3: script-environment coverage (script-environments.md §4).
# A declared `environment` is a CLAIM-ROUTING dimension: script tasks carry its
# manifest hash and a runner only claims them if it provides that hash. So a
# host that passes sections 1-2 can still be silently unable to run script work.
env_gaps = []   # [(qualified, hash, manifest)] — python envs missing here
env_rows = []   # [(mark, label, note)]
env_note = None


def env_root():  # replaced by the real one below when facetwork is importable
    return os.environ.get("FW_ENV_ROOT", "/opt/fw_envs")


try:
    from facetwork.envbake import collect_environments
    from facetwork.environments import env_root, interpreter_for_hash, materialize_environment

    env_roots = [os.path.join(FW_ROOT, "examples"),
                 os.environ.get("FWH_HANDLERS_ROOT") or os.path.expanduser("~/fw_handlers")]
    try:
        declared = collect_environments([r for r in env_roots if os.path.isdir(r)])
    except SystemExit as exc:
        # Conflicting declarations of the same name — report, don't abort the check.
        declared, env_note = {}, str(exc)
    for qualified, info in sorted(declared.items()):
        manifest, h = info["manifest"], info["hash"]
        lang = (manifest.get("language") or "?").lower()
        label = f"{qualified}@{h}"
        if lang != "python":
            env_rows.append(("○", label, f"language={lang} — provided-only (polyglot agent)"))
        elif not manifest.get("resolved", True):
            # Unresolved => this hash is NOT the published one; presence here is
            # unverifiable. Say so rather than reporting a false gap.
            env_rows.append(("!", label, "manifest UNRESOLVED (index unreachable?) — coverage unverifiable"))
        elif interpreter_for_hash(h):
            env_rows.append(("✓", label, f"provided ({len(manifest.get('pins') or [])} pin(s))"))
        else:
            env_rows.append(("✗", label, "NOT materialized here -> fw ffl bake-envs"))
            env_gaps.append((qualified, h, manifest))
except Exception as exc:  # noqa: BLE001 - env coverage is additive; never break the dep check
    env_note = f"could not analyze ({exc})"

print()
print(f"Script environments (FW_ENV_ROOT={env_root()}):")
if env_note:
    print(f"  ? {env_note}")
elif not env_rows:
    print("  ✓ none declared under examples/ + the domain checkouts")
else:
    for mark, label, note in env_rows:
        print(f"  {mark} {label:<44} {note}")

n_missing = len(missing_mods)
print()
if not DO_INSTALL:
    if n_missing:
        print(f"{n_missing} missing module(s). Re-run with --install to fix, or install an")
        print("domain package to run it:  fw install domain <name>")
    else:
        print("All test/example module dependencies satisfied.")
    if env_gaps:
        print(f"{len(env_gaps)} declared environment(s) NOT provided here — this host will not")
        print("claim their script tasks. Fix with:  fw install check --install  (or fw ffl bake-envs)")
    sys.exit(0)

# --- install (--install) ---------------------------------------------------
if not missing_mods and not env_gaps:
    print("Nothing to install — modules importable and every declared environment provided.")
    sys.exit(0)

rc = 0
if missing_mods:
    print("Installing missing dependencies…")
# group: example installs and pip installs
example_names, pip_specs = [], []
for m in missing_mods:
    action = KNOWN.get(m)
    if action and action[0] == "domain":
        if action[1] not in example_names:
            example_names.append(action[1])
    elif action and action[0] == "pip":
        spec = list(action[1:])
        if spec not in pip_specs:
            pip_specs.append(spec)
    else:
        pip_specs.append([m])

for name in example_names:
    print(f"  -> fw install domain {name}")
    r = subprocess.run([os.path.join(FW_LIB, "install", "domain"), name, "--check"])
    rc = rc or r.returncode
pep668 = False
for spec in pip_specs:
    print(f"  -> pip install {' '.join(PIP_EXTRA + spec)}")
    r = subprocess.run([PYTHON, "-m", "pip", "install", *PIP_EXTRA, *spec],
                       capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        if "externally-managed-environment" in (r.stdout + r.stderr):
            pep668 = True
        rc = rc or r.returncode

print()
if pep668:
    print(f"pip is blocked — {PYTHON} is PEP 668 externally-managed (system/Homebrew).")
    print("Fix the host's setup, then re-run:")
    print("  fw install repo                 # create a repo .venv and install into it (recommended)")
    print("  fw install check --install --break-system-packages   # override (risks the system python)")
    rc = rc or 1
elif missing_mods:
    # importable() is cached per-process; spawn a fresh interpreter so a just-
    # installed package (possibly in a site dir not on our startup sys.path) is seen.
    check = "import importlib.util,sys; sys.exit(0 if all(importlib.util.find_spec(m) for m in sys.argv[1:]) else 1)"
    still = [m for m in missing_mods
             if subprocess.run([PYTHON, "-c", check, m]).returncode != 0]
    if still:
        print(f"Still missing after install: {', '.join(sorted(still))} (may need a manual extra/OS lib)")
        rc = rc or 1
    else:
        print("✓ all previously-missing modules now importable")

# Materialize the missing script environments (same builder the image bake and
# `fw ffl bake-envs` use, so a host converges on the SAME content-addressed venv).
if env_gaps:
    print(f"Materializing {len(env_gaps)} script environment(s) into {env_root()}…")
    for qualified, h, manifest in env_gaps:
        try:
            interpreter = materialize_environment(manifest, h)
            print(f"  ✓ {qualified}@{h} -> {interpreter}")
        except PermissionError:
            print(f"  ✗ {qualified}@{h}: {env_root()} is not writable by this user.")
            print(f"    Point FW_ENV_ROOT at a writable dir (e.g. FW_ENV_ROOT=$HOME/fw_envs) and re-run,")
            print(f"    exporting the same value for the runners — they look the environment up there.")
            rc = rc or 1
        except Exception as exc:  # noqa: BLE001 - report every env, then fail
            print(f"  ✗ {qualified}@{h}: {str(exc)[:300]}")
            rc = rc or 1
sys.exit(rc)
PY
rc_deps=$?

# --- [4] command startability ---------------------------------------------
echo
"$PYTHON" "$STARTABILITY"
rc_cmds=$?

[ "$rc_deps" -ne 0 ] && exit "$rc_deps"
exit "$rc_cmds"
