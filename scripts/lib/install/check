#!/usr/bin/env bash
# fw-summary: analyze missing test/example dependencies on this host (optionally --install them)
#
# Scans tests/ + examples/ for imported third-party modules (both hard imports
# and pytest.importorskip(...) markers), reports which are NOT importable on this
# host, and cross-checks the standalone example packages against what's actually
# installed (facetwork.examples entry points). With --install it installs the
# gaps: example-provided modules via `fw install example <name>`, everything else
# via pip (boto3 → the facetwork [s3] extra).
#
# This is the automation of the host-by-host gap hunt: a fresh runner host can
# run `fw install check --install` instead of discovering missing deps via failed
# test runs.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"

PYTHON="$FW_ROOT/.venv/bin/python3"; [ -x "$PYTHON" ] || PYTHON=python3
INSTALL=0
for a in "$@"; do
    case "$a" in
        --install|--fix) INSTALL=1 ;;
        --dry|--dry-run) INSTALL=0 ;;
        -h|--help)
            sed -n '3,12p' "$0" | grep -v '^# fw-summary:' | sed 's/^# \{0,1\}//'
            echo; echo "Usage: fw install check [--install]"
            exit 0 ;;
        *) echo "unknown arg: $a" >&2; exit 2 ;;
    esac
done

exec env FW_ROOT="$FW_ROOT" FW_LIB="$FW_LIB" FW_PYTHON="$PYTHON" FW_INSTALL="$INSTALL" \
    "$PYTHON" - <<'PY'
import ast
import os
import re
import subprocess
import sys
from importlib import util as importutil
from importlib.metadata import entry_points

FW_ROOT = os.environ["FW_ROOT"]
FW_LIB = os.environ["FW_LIB"]
PYTHON = os.environ["FW_PYTHON"]
DO_INSTALL = os.environ["FW_INSTALL"] == "1"

# A non-venv (system/Homebrew) python is PEP 668 externally-managed — pip refuses
# to install into it without --user. Hosts with a repo .venv install normally.
IN_VENV = sys.prefix != sys.base_prefix
PIP_USER = [] if IN_VENV else ["--user"]

# Modules that are local/path-hacked or part of this repo — never "missing".
EXCLUDE = {"handlers", "conftest", "facetwork", "examples", "tests", "afl"}
STDLIB = set(getattr(sys, "stdlib_module_names", set()))


def local_example_modules():
    """Top-level module names provided *locally* by an in-repo example (e.g.
    `handlers`, `hiv_helpers`, `maven_runner`). These are importable only once an
    example's conftest puts its dir on sys.path, so they look "missing" to a
    static scan — exclude them. Collect every package/module basename anywhere
    under examples/, minus test files."""
    locals_ = set()
    ex = os.path.join(FW_ROOT, "examples")
    for dp, dirs, files in os.walk(ex):
        if "__pycache__" in dp:
            continue
        if "__init__.py" in files:
            locals_.add(os.path.basename(dp))
        for f in files:
            if f.endswith(".py") and not f.startswith("test_") and f != "conftest.py":
                locals_.add(f[:-3])
    return locals_


EXCLUDE |= local_example_modules()

# How to install a given missing top-level module. Example-provided modules map
# to `fw install example <name>`; a few belong to a facetwork extra; the rest
# default to `pip install <module>`.
KNOWN = {
    "anthropic_handlers": ("example", "anthropic"),
    "boto3": ("pip", "-e", f"{FW_ROOT}[s3]"),
    "botocore": ("pip", "-e", f"{FW_ROOT}[s3]"),
}


def scan_imports(roots):
    mods = set()
    for root in roots:
        for dp, _, files in os.walk(root):
            if "__pycache__" in dp:
                continue
            for fn in files:
                if not fn.endswith(".py"):
                    continue
                p = os.path.join(dp, fn)
                try:
                    tree = ast.parse(open(p, encoding="utf-8", errors="ignore").read(), p)
                except Exception:
                    continue
                for node in ast.walk(tree):
                    if isinstance(node, ast.Import):
                        for a in node.names:
                            mods.add(a.name.split(".")[0])
                    elif isinstance(node, ast.ImportFrom):
                        if node.level == 0 and node.module:
                            mods.add(node.module.split(".")[0])
                    elif isinstance(node, ast.Call):
                        f = node.func
                        if (isinstance(f, ast.Attribute) and f.attr == "importorskip"
                                and node.args and isinstance(node.args[0], ast.Constant)
                                and isinstance(node.args[0].value, str)):
                            mods.add(node.args[0].value.split(".")[0])
    return mods


def importable(mod):
    try:
        return importutil.find_spec(mod) is not None
    except Exception:
        return False


def parse_registry():
    """name -> (repo, extras, desc) from scripts/lib/install/example."""
    reg = {}
    path = os.path.join(FW_LIB, "install", "example")
    rx = re.compile(r'^\s*"([a-z0-9-]+)\|([^|]*)\|([^|]*)\|(.*)"')
    for line in open(path, encoding="utf-8", errors="ignore"):
        m = rx.match(line)
        if m:
            reg[m.group(1)] = (m.group(2), m.group(3), m.group(4))
    return reg


def installed_examples():
    return {e.name for e in entry_points(group="facetwork.examples")}


# --- analyze ---------------------------------------------------------------
roots = [os.path.join(FW_ROOT, "tests"), os.path.join(FW_ROOT, "examples")]
roots = [r for r in roots if os.path.isdir(r)]
mods = scan_imports(roots)
missing_mods = sorted(
    m for m in mods
    if m and not m.startswith("_") and m not in EXCLUDE and m not in STDLIB
    and not importable(m)
)

reg = parse_registry()
inst = installed_examples()
missing_examples = sorted(n for n in reg if n not in inst)

host = os.uname().nodename.split(".")[0]
print(f"Dependency analysis — host {host}, python {PYTHON}")
print()

# Section 1: missing modules the test suite imports (these cause skips/failures)
print("Test/example modules NOT importable here:")
if not missing_mods:
    print("  ✓ none — every module imported by tests/ + examples/ is available")
else:
    for m in missing_mods:
        action = KNOWN.get(m)
        if action and action[0] == "example":
            hint = f"fw install example {action[1]}"
        elif action and action[0] == "pip":
            hint = "pip install " + " ".join(action[1:])
        else:
            hint = f"pip install {m}"
        print(f"  ✗ {m:<22} -> {hint}")

# Section 2: example packages (informational — install to run that example)
print()
print("Standalone example packages (facetwork.examples):")
for name in sorted(reg):
    repo, extras, _ = reg[name]
    mark = "✓ installed" if name in inst else "○ available (not installed)"
    extra_note = f"  [extras: {extras}]" if extras else ""
    print(f"  {mark:<28} {name}{extra_note}")

n_missing = len(missing_mods)
print()
if not DO_INSTALL:
    if n_missing:
        print(f"{n_missing} missing module(s). Re-run with --install to fix, or install an")
        print("example package to run it:  fw install example <name>")
    else:
        print("All test/example module dependencies satisfied.")
    sys.exit(0)

# --- install (--install) ---------------------------------------------------
if not missing_mods:
    print("Nothing to install — all test/example modules already importable.")
    sys.exit(0)

print("Installing missing dependencies…")
rc = 0
# group: example installs and pip installs
example_names, pip_specs = [], []
for m in missing_mods:
    action = KNOWN.get(m)
    if action and action[0] == "example":
        if action[1] not in example_names:
            example_names.append(action[1])
    elif action and action[0] == "pip":
        spec = list(action[1:])
        if spec not in pip_specs:
            pip_specs.append(spec)
    else:
        pip_specs.append([m])

for name in example_names:
    print(f"  -> fw install example {name}")
    r = subprocess.run([os.path.join(FW_LIB, "install", "example"), name, "--check"])
    rc = rc or r.returncode
for spec in pip_specs:
    print(f"  -> pip install {' '.join(PIP_USER + spec)}")
    r = subprocess.run([PYTHON, "-m", "pip", "install", *PIP_USER, *spec])
    rc = rc or r.returncode

# re-check
still = sorted(m for m in missing_mods if not importable(m))
print()
if still:
    print(f"Still missing after install: {', '.join(still)} (may need an OS lib or a manual extra)")
    rc = rc or 1
else:
    print("✓ all previously-missing modules now importable")
sys.exit(rc)
PY
