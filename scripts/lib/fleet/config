#!/usr/bin/env python3
# fw-summary: manage central fleet_config — set/get/status/secret
"""fleet — manage the Facetwork fleet's CENTRAL config (in MongoDB) and view the
live fleet. Set MinIO + runner counts ONCE here instead of on every server; each
server's `fleet-agent` reads this to self-configure.

  fleet set    --mongo <url> [--minio URL] [--bucket B] [--mongo-url URL] [--dashboard-url URL] [--osm-replicas N] [--task-list X]
               [--domain-runner NAME ...] [--domain-replicas N] [--rm-domain-runner NAME ...]
  fleet get    --mongo <url>
  fleet status --mongo <url>

The config lives in the `fleet_config` collection (_id="default"); `status`
reads live runners from the `servers` heartbeat collection. The only thing a
server needs to join is the Mongo URL (or a resolvable `afl-mongodb` hostname);
the MinIO endpoint and replica counts flow from here.

Model: the infra services — MongoDB, MinIO, Dashboard — are identified by their
access URL ONLY. The fleet does not enumerate their cluster members; each may be
a single node, a replica set / distributed deployment, or a managed service.
Every Facetwork server is a homogeneous RUNNER (there is no "master"); any runner
with Mongo access can seed workflow definitions.
"""
from __future__ import annotations

import os
import sys

# Self-bootstrap under the repo venv: ensure the required tools (pymongo,
# cryptography) are installed — creating the venv if needed — then re-exec.
try:
    import pymongo  # noqa: F401
except ModuleNotFoundError:
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "_helpers"))
    from _fleet_bootstrap import bootstrap_and_reexec

    bootstrap_and_reexec()  # re-execs under the venv unless already running it
    import pymongo  # noqa: F401

import argparse
import time
import json
from collections import Counter
from datetime import datetime, timezone

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "_helpers"))
import _fleet_lib  # noqa: E402
from pymongo import MongoClient  # noqa: E402

DB = os.environ.get("FW_MONGODB_DATABASE", "facetwork")


def _resolve(a):
    """Discover the Mongo URL if not given explicitly (Phase 3)."""
    return _fleet_lib.resolve_mongo(getattr(a, "mongo", None), log=lambda m: print(f"  {m}"))


def _db(url):
    return MongoClient(url, serverSelectionTimeoutMS=5000)[DB]


def _warn_unknown_domain_runners(names):
    """Best-effort: warn if a --domain-runner name isn't a known catalog
    compose-domain service suffix (e.g. `jenkins-example`). Never fatal — a
    deployment may run a service not yet in its catalog."""
    try:
        from fwroot import fw_root

        sys.path.insert(0, fw_root())
        from facetwork.domains.catalog import compose_domains

        known = {s["service"][len("runner-"):] for s in compose_domains().values()
                 if s.get("service", "").startswith("runner-")}
        unknown = [n for n in names if n not in known]
        if unknown:
            print(f"  note: domain-runner(s) not in the catalog: {', '.join(unknown)}")
            print(f"        known compose-domain suffixes: {', '.join(sorted(known))}")
            print("        (ensure runner-<name> exists in docker-compose; harmless if it does)")
    except Exception:  # noqa: BLE001 — validation is advisory only
        pass


def _print_cfg(cfg):
    minio = cfg.get("minio", {})
    eps = cfg.get("endpoints", {})
    print(f"  version:   {cfg.get('version', '-')}")
    print(f"  updated:   {cfg.get('updated_at', '-')}")
    # Infra services are identified by access URL only (single node, cluster, or
    # managed service — the fleet does not track their internal membership).
    print(f"  mongodb:   {eps.get('mongodb', '-')}")
    print(f"  minio:     {minio.get('endpoint', '-')}  bucket={minio.get('bucket', '-')}")
    print(f"  dashboard: {eps.get('dashboard', '-')}")
    for role, spec in (cfg.get("roles") or {}).items():
        kind = f" kind={spec['kind']}" if spec.get("kind") else ""
        groups = spec.get("server_groups")
        grp = f" groups={','.join(groups)}" if groups else ""
        print(f"  role {role}: replicas={spec.get('replicas', '-')} task_list={spec.get('task_list', '-')} image={spec.get('image', '-')}{kind}{grp}")


def cmd_set(a):
    d = _db(_resolve(a))
    cfg = d.fleet_config.find_one({"_id": "default"}) or {
        "_id": "default", "minio": {}, "endpoints": {}, "roles": {}, "version": 0,
    }
    if a.minio:
        cfg.setdefault("minio", {})["endpoint"] = a.minio
    if a.bucket:
        cfg.setdefault("minio", {})["bucket"] = a.bucket
    # Infra services addressed by URL only — no fleet membership is recorded for
    # them. MinIO's endpoint also mirrors into `endpoints.minio` for a unified view.
    if a.mongo_url:
        cfg.setdefault("endpoints", {})["mongodb"] = a.mongo_url
    if a.dashboard_url:
        cfg.setdefault("endpoints", {})["dashboard"] = a.dashboard_url
    if a.minio:
        cfg.setdefault("endpoints", {})["minio"] = a.minio
    if a.osm_replicas is not None:
        cfg.setdefault("roles", {}).setdefault("osm-geocoder", {})["replicas"] = a.osm_replicas
    if a.task_list:
        cfg.setdefault("roles", {}).setdefault("osm-geocoder", {})["task_list"] = a.task_list
    if a.image:
        cfg.setdefault("roles", {}).setdefault("osm-geocoder", {})["image"] = a.image
    if a.gh_router_image:
        cfg.setdefault("roles", {}).setdefault("gh-router", {})["image"] = a.gh_router_image
    # ffl-runner: the dedicated orchestration tier (continuation_mode=shared).
    # replicas>0 makes each host bring up that many; image is optional (defaults
    # to the shared runner image so a --image roll covers it too — set --ffl-image
    # only to roll an engine change to ONLY the ffl tier).
    if a.ffl_replicas is not None:
        cfg.setdefault("roles", {}).setdefault("ffl-runner", {})["replicas"] = a.ffl_replicas
    if a.ffl_image:
        cfg.setdefault("roles", {}).setdefault("ffl-runner", {})["image"] = a.ffl_image
    # Per-domain handler runners (kind="domain"): fold the fwh_* per-domain
    # runners into the central config so they follow rollouts/recreates like the
    # osm tier. The role key is the compose-service suffix (runner-<key>), e.g.
    # census-us, anthropic, jenkins-example. Image inherits the shared runner
    # image unless --domain-image pins one. Each runs at --domain-replicas per
    # server (default 1). `--rm-domain-runner` drops a role.
    if a.domain_runner:
        _warn_unknown_domain_runners(a.domain_runner)
    for name in (a.domain_runner or []):
        spec = cfg.setdefault("roles", {}).setdefault(name, {})
        spec["kind"] = "domain"
        if a.domain_replicas is not None:
            spec["replicas"] = a.domain_replicas
        else:
            spec.setdefault("replicas", 1)
        if a.domain_image:
            spec["image"] = a.domain_image
        # --server-groups in the SAME call applies to these domain runners (a
        # convenience for "add census-us, but only to the 'light' group"). Empty
        # value clears the restriction (runs everywhere).
        if a.server_groups is not None:
            groups = [g.strip() for g in a.server_groups.split(",") if g.strip()]
            if groups:
                spec["server_groups"] = groups
            else:
                spec.pop("server_groups", None)
    # server_groups gating, general form: restrict ANY role (osm-geocoder,
    # ffl-runner, gh-router, or a domain) to hosts in the named server-groups.
    # `ROLE:` with no groups clears the restriction. The role need not be created
    # in this call (it may already exist), but a brand-new key is left otherwise
    # empty — set its replicas/kind in the same or a prior `fleet set`.
    for value in (a.role_groups or []):
        role, groups = _fleet_lib.parse_role_groups(value)
        spec = cfg.setdefault("roles", {}).setdefault(role, {})
        if groups:
            spec["server_groups"] = groups
        else:
            spec.pop("server_groups", None)
    for name in (a.rm_domain_runner or []):
        (cfg.get("roles") or {}).pop(name, None)
    cfg["version"] = int(cfg.get("version", 0)) + 1
    cfg["updated_at"] = datetime.now(timezone.utc).isoformat()
    d.fleet_config.replace_one({"_id": "default"}, cfg, upsert=True)
    print(f"fleet_config updated → version {cfg['version']}")
    _print_cfg(cfg)
    print("\nServers reconcile on their next `fleet-agent apply`.")


def cmd_get(a):
    cfg = _db(_resolve(a)).fleet_config.find_one({"_id": "default"})
    if not cfg:
        print("no fleet_config set yet — run `fleet set --minio … --osm-replicas N`")
        return
    if a.json:
        cfg.pop("_id", None)
        print(json.dumps(cfg, indent=2, default=str))
    else:
        _print_cfg(cfg)


def _host_key(name) -> str:
    """Normalize a host name for matching.

    The agent records itself as ``server3.local`` while runners register as
    ``server3``, so the two collections never joined — every host displayed
    "no fleet-agent record" and the drift column was meaningless.
    """
    s = str(name or "?").strip()
    return s[:-6] if s.endswith(".local") else s


def cmd_status(a):
    d = _db(_resolve(a))
    cfg = d.fleet_config.find_one({"_id": "default"}) or {}
    desired = cfg.get("version", "-")
    print(f"fleet_config v{desired}  minio={cfg.get('minio', {}).get('endpoint', '-')}")

    # Desired vs applied per host (fleet-agent records into fleet_agents), and
    # — the part that actually indicates health — how many runners each host has
    # ALIVE versus how many it was asked to start. Applying a config says
    # nothing about whether the containers survived: a host can report
    # "up-to-date" while every runner it launched crash-loops on startup.
    agents = {_host_key(a_["_id"]): a_ for a_ in d.fleet_agents.find({})}

    # Only count runners with a FRESH heartbeat. `state == "running"` alone is a
    # stale-record trap: a killed runner keeps that state until the reaper gets
    # to it, so counting it inflates "live" with runners that are long gone.
    now_ms = int(time.time() * 1000)
    fresh_ms = int(os.environ.get("FW_FLEET_STATUS_FRESH_MS", 180_000))
    all_running = list(d.servers.find({"state": "running"}))
    servers = [s for s in all_running if now_ms - int(s.get("ping_time") or 0) <= fresh_ms]
    stale = len(all_running) - len(servers)

    by_host = Counter(_host_key(s.get("server_name", "?")) for s in servers)
    hosts = sorted(set(by_host) | set(agents))
    print(f"\nlive runners: {len(servers)} across {len(by_host)} host(s)"
          + (f"   ({stale} stale record(s) ignored)" if stale else ""))
    degraded = []
    for host in hosts:
        n = by_host.get(host, 0)
        ips = next((s.get("server_ips") for s in servers
                    if _host_key(s.get("server_name", "?")) == host), None)
        ag = agents.get(host)
        if ag is not None:
            av = ag.get("applied_version")
            drift = "up-to-date" if str(av) == str(desired) else f"LAGGING (applied v{av})"
            exp = ag.get("expected_runners")
        else:
            drift, exp = "no fleet-agent record", None
        count = f"{n:>2}/{exp} runner(s)" if exp else f"{n:>2} runner(s)"
        health = ""
        if exp:
            if n == 0:
                health = "  ** NO RUNNERS ALIVE **"
            elif n < int(exp):
                health = f"  ** {int(exp) - n} MISSING **"
        if health:
            degraded.append(host)
        print(f"  {host:<24} {count:<18} [{drift}]{health}  {ips or ''}")
    if degraded:
        print("\n  A host can apply the config and still have its runners die on startup —")
        print("  check `docker ps` restart counts and the runner logs on: " + ", ".join(degraded))


def cmd_secret(a):
    if a.action == "gen-key":
        print(_fleet_lib.gen_key())
        print("# export FW_FLEET_KEY=<above> on the admin and every host (one bootstrap secret).", file=sys.stderr)
        return
    d = _db(_resolve(a))
    if a.action == "set":
        if not (a.minio_access and a.minio_secret):
            sys.exit("secret set needs --minio-access and --minio-secret")
        _fleet_lib.set_minio_secret(d, a.minio_access, a.minio_secret)
        print("MinIO credentials encrypted into fleet_secrets (key = FW_FLEET_KEY).")
        print("Each host with FW_FLEET_KEY now decrypts them at apply — no creds in host env.")
    elif a.action == "show":
        sec = _fleet_lib.get_minio_secret(d)
        if not sec:
            print("no MinIO secret stored (`fleet secret set …`)")
        else:
            print(f"  minio access_key: {sec['access_key']}")
            print(f"  minio secret_key: {'*' * len(sec['secret_key'])}")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_mongo(sp):
        sp.add_argument("--mongo", default=None,
                        help="MongoDB URL (auto-discovered if omitted: FW_MONGODB_URL → mDNS → afl-mongodb)")

    ps = sub.add_parser("set", help="update the central fleet config")
    add_mongo(ps)
    ps.add_argument("--minio", help="shared MinIO/S3 endpoint (URL), e.g. http://afl-minio:9000")
    ps.add_argument("--bucket", help="durable bucket (default afl-cache)")
    ps.add_argument("--mongo-url", help="advertised MongoDB URL runners connect to (URL of the service, not a server list)")
    ps.add_argument("--dashboard-url", help="dashboard URL, e.g. http://afl-dashboard:8080 (informational; URL-addressed service)")
    ps.add_argument("--osm-replicas", type=int, help="osm runners per server")
    ps.add_argument("--task-list", help="task list for osm runners (default osm)")
    ps.add_argument("--image", help="runner image tag (a change triggers a rolling recreate fleet-wide)")
    ps.add_argument("--gh-router-image", help="embedded-GraphHopper agent image tag for the gh-router role (a change recreates it fleet-wide)")
    ps.add_argument("--ffl-replicas", type=int, help="ffl-runner (orchestration tier, continuation_mode=shared) per server; 0 disables")
    ps.add_argument("--ffl-image", help="image tag for the ffl-runner role (optional; defaults to the shared runner image — set only to roll the engine to ONLY the ffl tier)")
    ps.add_argument("--domain-runner", action="append", metavar="NAME",
                    help="add/update a per-domain handler runner role (compose-service suffix, e.g. census-us, anthropic, jenkins-example); repeatable. Each maps to runner-<NAME> and is managed fleet-wide by fleet-agent.")
    ps.add_argument("--domain-replicas", type=int, help="replicas per server for the --domain-runner(s) in this call (default 1 when adding)")
    ps.add_argument("--domain-image", help="image override for the --domain-runner(s) in this call (default: the shared runner image, so a --image roll covers them)")
    ps.add_argument("--server-groups", metavar="G1,G2",
                    help="server-groups for the --domain-runner(s) in THIS call — they then run ONLY on hosts whose FW_SERVER_GROUP is listed (empty value clears). Convenience for --role-groups NAME:G1,G2.")
    ps.add_argument("--role-groups", action="append", metavar="ROLE:G1,G2",
                    help="restrict ANY role to hosts in these server-groups; ROLE is any role key (osm-geocoder, ffl-runner, gh-router, or a domain name), 'ROLE:' clears. A role with no server_groups runs everywhere (the default). Repeatable.")
    ps.add_argument("--rm-domain-runner", action="append", metavar="NAME", help="remove a role (e.g. a domain runner); repeatable")
    ps.set_defaults(func=cmd_set)

    pg = sub.add_parser("get", help="print the central fleet config")
    add_mongo(pg)
    pg.add_argument("--json", action="store_true")
    pg.set_defaults(func=cmd_get)

    pst = sub.add_parser("status", help="config version + live runners by host")
    add_mongo(pst)
    pst.set_defaults(func=cmd_status)

    psec = sub.add_parser("secret", help="manage encrypted MinIO creds (Fernet, key=FW_FLEET_KEY)")
    add_mongo(psec)
    psec.add_argument("action", choices=["gen-key", "set", "show"])
    psec.add_argument("--minio-access", help="MinIO access key (for `set`)")
    psec.add_argument("--minio-secret", help="MinIO secret key (for `set`)")
    psec.set_defaults(func=cmd_secret)

    a = p.parse_args()
    try:
        a.func(a)
    except Exception as exc:  # noqa: BLE001
        sys.exit(f"error: {exc}")


if __name__ == "__main__":
    main()
