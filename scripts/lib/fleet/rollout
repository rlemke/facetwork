#!/usr/bin/env bash
# fw-summary: build+push the runner image at HEAD, point fleet_config at it, wait for converge
#
# One-shot codification of docs/operations/fleet-rollouts.md §2:
#   buildx build (cache-from current image) + push  ->  fleet config set --image
#   ->  poll `fleet config status` until every host's fleet-agent applies it.
# Tag = git short SHA of HEAD. Requires the `fleetbuilder` buildx builder and a
# host daemon configured for the HTTP registry (see `fw fleet registry-setup`).
#
# --stagger: BEFORE flipping the config, `docker pull` the new tag on this host
# and then each fleet host ONE AT A TIME. The fleet's registry is a single HTTP
# `registry:2`; when the config flips, every host's fleet-agent reconciles within
# its ~30s poll window and pulls the ~1GB image AT ONCE — on a slow host that pull
# can exceed the agent's 600s docker bound (exit 124) and trip the 900s watchdog
# into a reconcile loop that never converges (observed on the Intel minis, v62).
# Pre-pulling serially serializes registry load so each host's post-flip reconcile
# only recreates containers from a cached image (no registry hit). Remote hosts
# come from --host (repeatable) or FW_RUNNER_HOSTS ("user@host …"); set FW_SSH_OPTS
# (e.g. "-i ~/.ssh/id_rsa") if the default key/user doesn't apply.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
source "$FW_LIB/_helpers/_remote.sh"
_afl_resolve_remote_env

# The fleet's runner-image registry, addressed by NAME so it survives the infra
# host's DHCP drift (the Docker daemon resolves server3.local via mDNS; it's in
# each host's insecure-registries). REGISTRY is what fleet_config records and
# what REMOTE hosts pull from. PUSH_REGISTRY is where the BUILDER pushes to. Both
# address the SAME registry + repo, so a push under either name is pulled fine as
# `server3.local:5050`.
REGISTRY="${FW_FLEET_REGISTRY:-server3.local:5050}"
IMAGE_REPO="$REGISTRY/facetwork-runner"
BUILDER="${FW_FLEET_BUILDER:-fleetbuilder}"

# The push address depends on WHERE BUILDKIT RUNS, so derive it from the builder's
# driver instead of hardcoding one:
#
#   driver=docker            buildkit is the host daemon      -> localhost:5050 ✓
#   driver=docker-container  buildkit is a CONTAINER on a
#                            bridge network, so `localhost`
#                            is the BUILDER's own loopback,
#                            where nothing listens           -> host.docker.internal:5050
#
# Getting this wrong does not fail fast: the push retries `dial tcp [::1]:5050:
# i/o timeout` in a loop long after the image built fine, which reads like an
# IPv6 problem on the host even though the host answers on both stacks. That cost
# a full rollout on 2026-07-29. The builder's own buildkitd.toml already trusts
# host.docker.internal:5050 for exactly this reason.
#
# Any non-`docker` driver (docker-container, kubernetes, remote) is off-host, so
# localhost is wrong for all of them; only the host-daemon driver gets localhost.
# An explicit FW_FLEET_PUSH_REGISTRY always wins.
_builder_driver() {
    docker buildx inspect "$BUILDER" 2>/dev/null \
        | awk -F': *' '/^Driver:/ {print $2; exit}' \
        | tr -d '[:space:]'
}
#
# ⚠️ host.docker.internal is only the fleet registry when THIS host IS the
# registry host. Run from any other machine it resolves to that machine's OWN
# daemon, so the build pushes to a local registry while fleet_config keeps
# pointing at the real one — the rollout "succeeds", every host pulls the OLD
# image, and nothing says so. Observed 2026-08-31 running from MaxPro: the
# multi-arch manifest landed in MaxPro's registry while server3's stayed
# single-arch. The builder already trusts the registry by name (buildkitd.toml),
# so when the registry is REMOTE just push to it directly.
_registry_is_local() {
    local rhost="${REGISTRY%%:*}" me
    me="$(hostname -s 2>/dev/null || hostname)"
    case "$rhost" in
        localhost|127.0.0.1|"$me"|"$me".local) return 0 ;;
    esac
    return 1
}
if [ -n "${FW_FLEET_PUSH_REGISTRY:-}" ]; then
    PUSH_REGISTRY="$FW_FLEET_PUSH_REGISTRY"
    _push_why="FW_FLEET_PUSH_REGISTRY"
elif ! _registry_is_local; then
    PUSH_REGISTRY="$REGISTRY"
    _push_why="registry is remote — pushing to it by name"
else
    # `|| true`: under `set -e` an assignment whose command substitution fails
    # aborts the script, which would make the "not inspectable" case below
    # unreachable — it exited 1 with NO output at all instead of falling back.
    _driver="$(_builder_driver || true)"
    case "$_driver" in
        docker) PUSH_REGISTRY="localhost:5050"; _push_why="builder driver=docker (host daemon)" ;;
        "")     PUSH_REGISTRY="host.docker.internal:5050"; _push_why="builder '$BUILDER' not inspectable — assuming off-host buildkit" ;;
        *)      PUSH_REGISTRY="host.docker.internal:5050"; _push_why="builder driver=$_driver (buildkit off-host)" ;;
    esac
fi
PUSH_REPO="$PUSH_REGISTRY/facetwork-runner"
echo "push registry: $PUSH_REGISTRY  ($_push_why)"
# Multi-arch by DEFAULT. buildx pushes a manifest list, so every host pulls its
# own architecture from one tag and no per-host config exists to drift.
#
# It was arm64-only because the two Intel minis then ran EVERYTHING under
# qemu-aarch64 — load 17 on 12 cores, 30-60 min to start 16 runners, and a
# recurring "1/16 MISSING" that reads as a fault but is only emulation.
# Measured 2026-08-31: an amd64 build needed ZERO code changes and took
# 4 min cold (0 cached steps) — tippecanoe compiled from source, the pmtiles
# TARGETARCH case already picked x86_64, and osmium/shapely/pymongo all
# import. Docker Desktop's Rosetta layer makes the emulated half near-native,
# so no separate amd64 builder node is required.
#
# Set FW_FLEET_PLATFORM=linux/arm64 to build a single arch (faster bake when
# no x86 host is in the fleet).
PLATFORM="${FW_FLEET_PLATFORM:-linux/amd64,linux/arm64}"
MONGO="${FW_MONGODB_URL:-mongodb://server3.local:27017}"
# 900s, not 240s: agents recreate their services SERIALLY, so a host's converge
# time scales with its runner count — server3's 22 containers take well over
# 240s even when everything is healthy. The old default expired on a normal
# rollout, which is precisely why its "Rollout complete" line got ignored. Now
# that a timeout exits non-zero, the default has to be long enough that hitting
# it means something is actually wrong.
DRY=0 TIMEOUT=900 STAGGER=0 STAGGER_BEST_EFFORT=0
PULL_TIMEOUT="${FW_FLEET_STAGGER_PULL_TIMEOUT:-300}"
HOST_ARGS=()
_STAGGER_REMOTE_FAILED=""

# --stagger exists to guarantee every host has the image BEFORE the config flip.
# When it pre-pulls nothing it has silently removed the protection it was asked
# for, and flipping anyway is worse than not staggering: all hosts hit the
# registry at once, and a wedged pull holds a fleet-agent past its 600s docker
# bound (observed 2026-07-29 — a host sat half-recreated for 20+ minutes while
# the rollout reported success). So abort BEFORE `fleet config set`, leaving the
# fleet on its current, working image. --stagger-best-effort restores the old
# warn-and-continue behaviour when a host is knowingly offline.
_stagger_fail() {
    if [ "$STAGGER_BEST_EFFORT" = 1 ]; then
        echo "  WARN: $1 — $2 (continuing: --stagger-best-effort)" >&2
        return 0
    fi
    echo "" >&2
    echo "ERROR: --stagger cannot do its job: $1" >&2
    echo "       $2" >&2
    echo "       fleet_config NOT changed — the fleet stays on its current image." >&2
    echo "       Fix the cause, or re-run with --stagger-best-effort to accept it." >&2
    exit 1
}

# Portable per-pull timeout (macOS has no `timeout`): run "$@" in the background
# and TERM/KILL it if it outlives $1 seconds. Returns 124 on timeout. Without this
# a wedged/thrashing host's `docker pull` (its dockerd unresponsive) hangs the whole
# serial pre-pull; with it that host is warned-and-skipped and falls back to
# pulling on reconcile (no worse than not staggering it).
_bounded() {
    local t="$1"; shift
    "$@" &
    local p=$! w=0
    while kill -0 "$p" 2>/dev/null; do
        if [ "$w" -ge "$t" ]; then
            kill -TERM "$p" 2>/dev/null; sleep 1; kill -KILL "$p" 2>/dev/null
            return 124
        fi
        sleep 2; w=$((w+2))
    done
    wait "$p"
}
while [ $# -gt 0 ]; do
    case "$1" in
        --dry|--dry-run) DRY=1; shift ;;
        --mongo) MONGO="$2"; shift 2 ;;
        --platform) PLATFORM="$2"; shift 2 ;;
        --timeout) TIMEOUT="$2"; shift 2 ;;
        --stagger) STAGGER=1; shift ;;
        --stagger-best-effort) STAGGER=1; STAGGER_BEST_EFFORT=1; shift ;;
        --host) HOST_ARGS+=("$2"); shift 2 ;;
        -h|--help) echo "Usage: fw fleet rollout [--dry] [--stagger|--stagger-best-effort [--host user@host]...] [--mongo URL] [--platform P] [--timeout SEC]"; exit 0 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

cd "$FW_ROOT"
[ -n "$(git status --porcelain 2>/dev/null)" ] && echo "WARNING: working tree is dirty — rolling out HEAD, not your uncommitted edits." >&2
# The tag identifies the CONTENT, not just the facetwork commit. Baked fwh_*
# domain code is versioned independently, so a domain-only rebake at an unchanged
# facetwork HEAD used to OVERWRITE the existing tag — a mutable tag. That was
# done three times at `20c1d6b` on 2026-07-29 with different save-earth content
# each time. It only worked because --stagger does an explicit `docker pull`,
# which fetches the new digest; without that, hosts with `pull_policy: missing`
# keep stale content under a tag they already have AND THE ROLLOUT REPORTS
# CONVERGED. Appending the domain ref makes every distinct bake a distinct,
# immutable tag, so correctness no longer depends on the pre-pull.
TAG="$(git rev-parse --short HEAD)"
if [ -n "${FW_FLEET_DOMAINS_REF:-}" ]; then
    # Keep it short and tag-safe ([a-zA-Z0-9._-]); the ref is usually a sha.
    _dref="$(printf '%s' "$FW_FLEET_DOMAINS_REF" | tr -c 'a-zA-Z0-9._-' '-' | cut -c1-12)"
    TAG="${TAG}-d${_dref}"
fi
NEW_IMAGE="$IMAGE_REPO:$TAG"        # what fleet_config records / remotes pull
PUSH_IMAGE="$PUSH_REPO:$TAG"       # what the builder host pushes (same registry+repo)
# cache-from the image the fleet currently runs, addressed via the PUSH registry —
# the address the BUILDER can actually reach (it may not resolve REGISTRY by name).
# The character class must allow `-` and `.`: with the domain-ref suffix above a
# `[a-f0-9]+` match would truncate `20c1d6b-d85fd713` to `20c1d6b` and cache-from
# a tag that may not exist.
PREV_TAG="$("$FW_LIB/fleet/config" get --mongo "$MONGO" 2>/dev/null | grep -oE "facetwork-runner:[a-zA-Z0-9._-]+" | head -1 | cut -d: -f2 || true)"
PREV="${PREV_TAG:+$PUSH_REPO:$PREV_TAG}"

# Resolve stagger targets up front so --dry can show them (empty is allowed —
# the local host is always pre-pulled; remotes only if listed).
STAGGER_HOSTS=""
if [ "$STAGGER" = 1 ]; then
    STAGGER_HOSTS="$(_afl_resolve_hosts "${HOST_ARGS[@]+"${HOST_ARGS[@]}"}" 2>/dev/null || true)"
fi

echo "Rollout plan:"
echo "  image:     $NEW_IMAGE"
echo "  cache-from: ${PREV:-<none>}"
echo "  builder:   $BUILDER   platform: $PLATFORM"
echo "  registry:  $REGISTRY"
if [ "$STAGGER" = 1 ]; then
    echo "  stagger:   pre-pull serially — local ($(hostname -s 2>/dev/null || hostname))$(
        [ -n "$STAGGER_HOSTS" ] && printf ' + %s' "$(printf '%s ' $STAGGER_HOSTS)")"
    [ -z "$STAGGER_HOSTS" ] && echo "             (no remote hosts — set FW_RUNNER_HOSTS='user@host …' or --host; remotes would pull concurrently on reconcile)"
fi
if [ "$DRY" = 1 ]; then echo "[dry-run] no build, no push, no pre-pull, no fleet set."; exit 0; fi

echo "=== 1/3 buildx build + push (push via $PUSH_REGISTRY, pull/config as $REGISTRY) ==="
BUILD=(docker buildx build --builder "$BUILDER" --platform "$PLATFORM"
       -f docker/Dockerfile.domain-runner -t "$PUSH_IMAGE" --provenance=false)
# FW_FLEET_DOMAINS_REF: cache-bust the baked-domains layer so every fwh_* repo
# is re-cloned at its current HEAD (git clone in a RUN is not content-addressed,
# so without this a rollout re-uses the cached clone even when a domain repo
# moved). Set it to any new value — the changed domain's commit sha reads well.
[ -n "${FW_FLEET_DOMAINS_REF:-}" ] && BUILD+=(--build-arg "FWH_DOMAINS_REF=${FW_FLEET_DOMAINS_REF}")
[ -n "$PREV" ] && BUILD+=(--cache-from "type=registry,ref=$PREV")
BUILD+=(--push .)
"${BUILD[@]}"

# Verify the pushed manifest actually carries EVERY platform we asked for.
# A multi-arch bake that silently produces one arch does not fail here — it
# fails much later, on the host whose architecture is missing, as an opaque
# "no matching manifest for linux/amd64" during that host's reconcile. That is
# precisely the shape that left the minis stuck on an old image for hours
# (v62). Ask the registry directly: `buildx imagetools inspect` speaks HTTPS to
# this insecure HTTP registry and errors, so use the v2 API.
_verify_platforms() {
    local want="$1" list arch_json missing=""
    # REGISTRY, not PUSH_REGISTRY: the push alias may be a docker-internal name
    # (host.docker.internal) that does not resolve from this shell, and the
    # canonical name is what every host actually pulls from — so verifying it is
    # verifying the thing that matters.
    list="$(curl -fsS -H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json' \
              "http://${REGISTRY}/v2/facetwork-runner/manifests/${TAG}" 2>/dev/null)" || return 2
    arch_json="$(printf '%s' "$list" | "$PYBIN_ROLLOUT" -c '
import json,sys
d=json.load(sys.stdin)
print(" ".join(sorted({(m.get("platform") or {}).get("architecture","?") for m in d.get("manifests",[])})))
' 2>/dev/null)" || return 2
    [ -z "$arch_json" ] && return 2
    for want_p in ${want//,/ }; do
        case " $arch_json " in *" ${want_p#linux/} "*) ;; *) missing="$missing ${want_p}" ;; esac
    done
    if [ -n "$missing" ]; then
        echo "ERROR: pushed manifest is missing:${missing}  (has: $arch_json)" >&2
        echo "       A host of that architecture cannot pull this tag. Not flipping fleet_config." >&2
        return 1
    fi
    echo "  manifest verified: $arch_json"
    return 0
}
PYBIN_ROLLOUT="${FW_ROOT}/.venv/bin/python3"
[ -x "$PYBIN_ROLLOUT" ] || PYBIN_ROLLOUT=python3
_verify_platforms "$PLATFORM"; _vrc=$?
if [ "$_vrc" = 1 ]; then exit 1; fi
if [ "$_vrc" = 2 ]; then
    # A bare `[ … ] && echo` returns 1 when the test is false, which under
    # `set -e` silently kills the script — exactly what it did on first run.
    echo "  WARN: could not verify the manifest's platforms (registry API unreachable) — continuing" >&2
fi

# Pre-pull locally even without --stagger. `buildx --push` does not load the
# image into the host daemon's store, so THIS host has no copy of the tag it
# just built — and its fleet-agent then cold-pulls ~GB inside a bounded
# `docker compose up`, which times out (exit 124) and retries on every cycle.
# Observed repeatedly: runner-ffl failing 124 in a loop while the deploy sat
# unconverged, and a single manual `docker pull` fixing it. On a standalone box
# the local host IS the fleet, so the --stagger path that protects remotes never
# ran. Failure here is a WARNING, not fatal: the agent can still pull, just
# slowly, and refusing to flip the config would be a worse outcome than a slow
# reconcile.
if [ "$STAGGER" != 1 ]; then
    echo "=== local pre-pull of $TAG (so the agent's reconcile does not cold-pull) ==="
    if _bounded "$PULL_TIMEOUT" docker pull "$NEW_IMAGE" >/dev/null 2>&1; then
        echo "  cached ✓ — reconcile will not hit the registry"
    else
        echo "  WARNING: local pre-pull did not finish in ${PULL_TIMEOUT}s." >&2
        echo "           The agent will pull during reconcile and may hit its own" >&2
        echo "           timeout (exit 124) for a cycle or two before converging." >&2
    fi
fi

if [ "$STAGGER" = 1 ]; then
    echo "=== staggered pre-pull of $TAG (serialize registry load before the flip; ${PULL_TIMEOUT}s/host cap) ==="
    echo "  local ($(hostname -s 2>/dev/null || hostname)):"
    # NEW_IMAGE, not PUSH_IMAGE. Two different clients reach the same registry by
    # different names: BUILDKIT (a container) pushes via host.docker.internal,
    # while the HOST DAEMON that runs this pull only trusts the registry under
    # its catalog name (server3.local:5050 is in insecure-registries;
    # host.docker.internal:5050 is not, so the pull tries HTTPS and dies with
    # "server gave HTTP response to HTTPS client"). Pulling the same name the
    # remote hosts use also means this pre-pull exercises exactly their path.
    if _bounded "$PULL_TIMEOUT" docker pull "$NEW_IMAGE" >/dev/null 2>&1; then
        echo "    cached ✓"
    elif [ $? = 124 ]; then
        _stagger_fail "local pull TIMED OUT after ${PULL_TIMEOUT}s" \
            "the BUILD host has no copy of $TAG — buildx --push does not load into the local store"
    else
        _stagger_fail "local pull failed" \
            "the BUILD host has no copy of $TAG (registry unreachable? wrong push address?)"
    fi
    if [ -z "$STAGGER_HOSTS" ]; then
        _stagger_fail "no remote hosts resolved (FW_RUNNER_HOSTS / --host)" \
            "every host would pull concurrently on reconcile — the exact contention --stagger avoids"
    else
        # Drive the loop off FD 3 (not stdin) AND give each ssh </dev/null: a
        # backgrounded `ssh` inherits the loop's stdin and would otherwise READ the
        # here-string, swallowing the remaining host lines so only the first host
        # gets pre-pulled. Both guards keep the loop input intact.
        while IFS= read -r h <&3; do
            [ -z "$h" ] && continue
            echo "  $h:"
            # Remote `docker` needs a LOGIN shell (non-login ssh lacks it on PATH);
            # bounded so a wedged host can't hang the serial pre-pull.
            if _bounded "$PULL_TIMEOUT" _afl_ssh "$h" "bash -lc 'export PATH=/usr/local/bin:/opt/homebrew/bin:\$PATH; docker pull $NEW_IMAGE >/dev/null 2>&1'" </dev/null; then
                echo "    cached ✓"
            elif [ $? = 124 ]; then
                echo "    WARN: pull on $h TIMED OUT after ${PULL_TIMEOUT}s — it will pull on reconcile"
                _STAGGER_REMOTE_FAILED="$_STAGGER_REMOTE_FAILED $h"
            else
                echo "    WARN: pull on $h failed (unreachable/auth?) — it will pull on reconcile"
                _STAGGER_REMOTE_FAILED="$_STAGGER_REMOTE_FAILED $h"
            fi
        done 3<<< "$STAGGER_HOSTS"
    fi
    if [ -n "${_STAGGER_REMOTE_FAILED// /}" ]; then
        _stagger_fail "pre-pull failed on:${_STAGGER_REMOTE_FAILED}" \
            "those hosts will pull ~1GB concurrently on reconcile and can exceed the agent's 600s docker bound"
    fi
    echo "  pre-pull done — every host has $TAG cached; no reconcile will hit the registry."
fi

echo "=== 2/3 fleet config set --image ==="
SET_OUT="$("$FW_LIB/fleet/config" set --mongo "$MONGO" --image "$NEW_IMAGE")"
echo "$SET_OUT"
NEWVER="$(printf '%s' "$SET_OUT" | grep -oE 'version[: ]+[0-9]+' | grep -oE '[0-9]+' | head -1)"

echo "=== 3/3 waiting for hosts to converge to v${NEWVER:-?} (timeout ${TIMEOUT}s) ==="
elapsed=0
while [ "$elapsed" -lt "$TIMEOUT" ]; do
    STATUS="$("$FW_LIB/fleet/config" status --mongo "$MONGO" 2>/dev/null || true)"
    # Parse the CURRENT `fleet config status` format, which prints one line per
    # host ending in either "[up-to-date]" or "[LAGGING (applied vNNN)]". The old
    # parser counted 'applied v' — a string that now appears ONLY on LAGGING
    # hosts, so a fully converged fleet scored 0/0 and this loop reported failure
    # for a rollout that had actually succeeded.
    # Count only hosts that CAN converge. A host printed with
    # "** NO RUNNERS ALIVE **" has no agent running to apply anything, so
    # waiting on it is waiting on nothing: on the standalone box that is
    # server1/2/3, dead for weeks at v140, and counting them made every single
    # rollout exit non-zero with the deploy actually fine. A wrong failure every
    # time is worse than no signal — it trains you to ignore the one that matters.
    #
    # The 0/4-reads-as-success lesson still holds: dead hosts are EXCLUDED, not
    # forgiven. If nothing is alive, live_total is 0 and this cannot converge.
    LIVE="$(printf '%s' "$STATUS" | grep 'runner(s)' | grep -v 'NO RUNNERS ALIVE' || true)"
    DEAD="$(printf '%s' "$STATUS" | grep 'runner(s)' | grep 'NO RUNNERS ALIVE' || true)"
    total="$(printf '%s' "$LIVE" | grep -c 'runner(s)' || true)"
    onnew="$(printf '%s' "$LIVE" | grep -c 'up-to-date' || true)"
    ndead="$(printf '%s' "$DEAD" | grep -c 'runner(s)' || true)"
    echo "  ${onnew}/${total} live host(s) on v${NEWVER} (${elapsed}s)$([ "${ndead:-0}" -gt 0 ] && echo " — ${ndead} host(s) with no runners alive, not counted")"
    [ -n "$NEWVER" ] && [ "$onnew" -ge "$total" ] && [ "$total" -gt 0 ] && { echo "All live hosts converged."; break; }
    sleep 12; elapsed=$((elapsed+12))
done
"$FW_LIB/fleet/config" status --mongo "$MONGO" | grep -E 'runner\(s\)' || true
# `break` above means converged; falling out of the loop means the timeout won.
# Printing "Rollout complete" either way is how a 0/4-converged rollout read as a
# success on 2026-07-29 — say which one happened, and exit non-zero if unfinished.
if [ -n "$NEWVER" ] && [ "${onnew:-0}" -ge "${total:-0}" ] && [ "${total:-0}" -gt 0 ]; then
    echo "Rollout complete: $NEW_IMAGE (all $total live host(s) on v$NEWVER)"
    if [ "${ndead:-0}" -gt 0 ]; then
        # Named, not hidden: a host that stopped reporting is worth knowing about,
        # it is just not this rollout's failure. It will pick the image up when
        # its agent comes back.
        echo "" >&2
        echo "NOTE: ${ndead} host(s) have no runners alive and were not waited for:" >&2
        printf '%s\n' "$DEAD" | sed 's/^/       /' >&2
        echo "      They apply the new image when their fleet-agent next runs." >&2
    fi
else
    echo "" >&2
    if [ "${total:-0}" -eq 0 ]; then
        echo "ERROR: rollout NOT converged after ${TIMEOUT}s — NO host has a live runner." >&2
        echo "       The image is pushed and fleet_config points at it, but nothing is" >&2
        echo "       running to apply it. Start a fleet-agent, or check the infra." >&2
        exit 1
    fi
    echo "ERROR: rollout NOT converged after ${TIMEOUT}s — ${onnew:-0}/${total:-0} LIVE host(s) on v${NEWVER:-?}." >&2
    echo "       The image is pushed and fleet_config points at it, so agents keep retrying." >&2
    echo "       Check: fw fleet status; per-host \`docker ps\` image tags; a wedged" >&2
    echo "       \`docker compose\` (its fleet-agent log goes stale while it hangs)." >&2
    exit 1
fi
