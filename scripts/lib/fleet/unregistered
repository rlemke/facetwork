#!/usr/bin/env bash
# fw-summary: name the runner containers on this host that have no server record
#
# ⚠️ Exists because a count mismatch was UNDIAGNOSABLE. Every runner on a host
# registers with the same `server_name` and the same `service_name`
# ("afl-runner"), so "23 containers but 22 records" resolved to a number and
# nothing else. Three hosts showed it at once and none could be investigated.
#
# Runners now record their short container ID, which is the one identifier that
# maps 1:1 to `docker ps`. This compares the two sets and NAMES the difference.
#
# Exit: 0 all containers accounted for · 1 at least one is unregistered ·
#       2 could not tell (no docker, no Mongo, or an image predating the field —
#       kept distinct so "cannot verify" never reads as "all good").
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"

PY="$FW_ROOT/.venv/bin/python3"; [ -x "$PY" ] || PY="$FW_ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"

docker info >/dev/null 2>&1 || { echo "unregistered: docker not reachable here" >&2; exit 2; }

# Short IDs are what the runner records, so compare in that form.
# Image included: a container running a DIFFERENT image than the Python runner
# cannot carry this field at all (the gh-router is a Java agent registering
# through the polyglot protocol), and a container running an OLDER runner image is
# a separate, real finding rather than an unregistered one.
LOCAL="$(docker ps --format '{{.ID}} {{.Names}} {{.Image}}' | awk '$2 ~ /runner/ {print $1" "$2" "$3}')"
[ -z "$LOCAL" ] && { echo "no runner containers on this host"; exit 0; }

"$PY" - "$LOCAL" <<'PYEOF'
import os, socket, subprocess, sys, time

local = {}
for line in (sys.argv[1] if len(sys.argv) > 1 else "").splitlines():
    parts = line.split()
    if len(parts) >= 3:
        local[parts[0][:12]] = (parts[1], parts[2])

try:
    import pymongo
    from facetwork.servers import catalog
    infra = catalog.infra()
    ip = catalog.resolve_ip(infra) if infra else None
    url = os.environ.get("FW_MONGODB_URL") or (f"mongodb://{ip}:27017" if ip
                                               else "mongodb://afl-mongodb:27017")
    db = pymongo.MongoClient(url, serverSelectionTimeoutMS=6000)["facetwork"]
    now = int(time.time() * 1000)
    host = socket.gethostname().split(".")[0].lower()
    recs = [s for s in db.servers.find({"ping_time": {"$gt": now - 180_000}})
            if (s.get("server_name") or "").split(".")[0].lower() == host]
except Exception as exc:                                   # noqa: BLE001
    print(f"unregistered: cannot reach MongoDB ({type(exc).__name__})", file=sys.stderr)
    sys.exit(2)

registered = {(s.get("container") or "")[:12] for s in recs if s.get("container")}
print(f"  {len(local)} runner container(s), {len(recs)} live server record(s) for this host")

# The image fleet_config points at. Containers on a different image are a
# different KIND of runner and are exempt from this check.
try:
    cfg = db.fleet_config.find_one({}) or {}
    want_image = ((cfg.get("roles") or {}).get("osm-geocoder", {}) or {}).get("image") or ""
except Exception:                                          # noqa: BLE001
    want_image = ""
want_tag = want_image.rsplit(":", 1)[-1] if want_image else ""

# An image built before the field exists records nothing, and every container
# would then look unregistered. Report that as could-not-tell, not as a fault.
if recs and not registered:
    print("  none of the records carry a container ID — this host runs an image "
          "predating the field; roll out a newer one to enable this check",
          file=sys.stderr)
    sys.exit(2)

missing, foreign, stale = {}, {}, {}
for cid, (name, image) in local.items():
    tag = image.rsplit(":", 1)[-1]
    if want_tag and tag != want_tag:
        # Same repo, older tag = a container the last rollout did not recreate.
        # Different repo entirely = a different agent (the Java gh-router).
        same_repo = want_image.rsplit(":", 1)[0] == image.rsplit(":", 1)[0]
        (stale if same_repo else foreign)[cid] = (name, tag)
        continue
    if cid not in registered:
        missing[cid] = name

# ⚠️ GRACE PERIOD. Registration is not instant: the generalist seeds 21 domains and
# loads several hundred handlers before it registers, which takes tens of seconds.
# A container younger than that ALWAYS looks unregistered, so without this the
# check cries wolf on every fresh join and after every rollout — measured on
# macmini03, where a 7-second-old generalist was flagged and was fine 20s later.
# Only the flagged containers are inspected, so this costs one call per finding
# (usually zero).
GRACE_S = 120
if missing:
    import datetime
    still = {}
    for cid, name in missing.items():
        try:
            out = subprocess.run(["docker", "inspect", "-f",
                                  "{{.State.StartedAt}}", cid],
                                 capture_output=True, text=True, timeout=10).stdout.strip()
            started = datetime.datetime.fromisoformat(out.replace("Z", "+00:00"))
            age = (datetime.datetime.now(datetime.timezone.utc) - started).total_seconds()
        except Exception:                                   # noqa: BLE001
            age = GRACE_S + 1                               # cannot tell: report it
        if age < GRACE_S:
            print(f"  starting     {name}  ({int(age)}s old, still registering)")
        else:
            still[cid] = name
    missing = still

orphan = registered - set(local)
for cid, name in sorted(missing.items(), key=lambda kv: kv[1]):
    print(f"  UNREGISTERED  {name}  ({cid})")
for cid, (name, tag) in sorted(stale.items(), key=lambda kv: kv[1][0]):
    print(f"  STALE IMAGE   {name}  running {tag}, fleet is on {want_tag}")
for cid, (name, tag) in sorted(foreign.items(), key=lambda kv: kv[1][0]):
    print(f"  exempt        {name}  ({tag}) — a different agent image; it "
          f"registers through the polyglot protocol and carries no container id")
if orphan:
    print(f"  {len(orphan)} record(s) with no local container — stopped containers "
          f"whose records have not aged out (normal right after a rollout)")

rc = 0
if missing:
    print(f"\n  {len(missing)} container(s) are running but not registered — they "
          f"claim nothing. Check their logs:", file=sys.stderr)
    for name in sorted(missing.values()):
        print(f"      docker logs --tail 50 {name}", file=sys.stderr)
    rc = 1
if stale:
    print(f"\n  {len(stale)} container(s) run an OLD image and will never be updated "
          f"by a rollout — the agent only brings roles UP, it does not recreate a "
          f"role it is no longer asked to run. Remove them:", file=sys.stderr)
    for _, (name, _t) in sorted(stale.items()):
        print(f"      docker rm -f {name}", file=sys.stderr)
    rc = 1
if rc:
    sys.exit(rc)
print("  OK — every runner container has a live server record")
PYEOF
