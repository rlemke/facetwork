#!/usr/bin/env bash
# Compile FFL source files to JSON workflow definitions.
#
# Usage:
#   fw ffl compile input.ffl                    # print JSON to stdout
#   fw ffl compile input.ffl -o output.json     # write to file
#   fw ffl compile input.ffl --check            # syntax check only
#   fw ffl compile input.ffl --compact          # compact JSON output
#   fw ffl compile --help                       # show all options

source "$(dirname "${BASH_SOURCE[0]}")/../_helpers/_bootstrap.sh"
set -euo pipefail

REPO_ROOT="$FW_ROOT"

PYTHON="${REPO_ROOT}/.venv/bin/python3"
[[ -x "$PYTHON" ]] || PYTHON=python3

exec env PYTHONPATH="$REPO_ROOT" "$PYTHON" -m facetwork.cli "$@"
