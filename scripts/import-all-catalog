#!/usr/bin/env bash
# Import EVERY discoverable example package's FFL into the Claude workflow catalog.
#
# Each package is imported with `import-package` semantics: all its .ffl are
# merged (resolving cross-file `use` deps) into one shared library entry, plus
# one thin catalog entry per workflow. Handler-only packages (no .ffl) are
# skipped; a package that fails to compile is reported but does not abort the run.
#
# Usage:
#   scripts/import-all-catalog                      # import + publish every package
#   scripts/import-all-catalog --list               # show what would be imported, then exit
#   scripts/import-all-catalog --no-publish         # import as drafts
#   scripts/import-all-catalog --only osm-geocoder --only osm-lz
#   scripts/import-all-catalog --exclude genomics --tags batch1
#   scripts/import-all-catalog --dir ~/fw_handlers/fwh_osm/src/osm_geocoder/handlers/graphhopper/ffl
#
# Connects to MongoDB via .env (AFL_MONGODB_URL etc.).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Load shared env (.env sets AFL_MONGODB_URL etc.)
source "$(dirname "$0")/_env.sh"

PYTHON="${REPO_ROOT}/.venv/bin/python3"
[[ -x "$PYTHON" ]] || PYTHON=python3

exec env PYTHONPATH="$REPO_ROOT" "$PYTHON" -m facetwork.catalog.cli import-all "$@"
