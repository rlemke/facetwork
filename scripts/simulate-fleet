#!/usr/bin/env bash
# simulate-fleet — verify the multi-server fleet controller END-TO-END on one box.
#
# Spins up N "servers" as separate docker compose projects (distinct identities,
# own scratch), each brought up by `fleet-agent` reading the CENTRAL config +
# encrypted secret store from the shared MongoDB, with the shared MinIO as the
# durable store. Then runs a fan-out heat map across them and checks the leaves
# distributed across servers and the merge pulled everyone's output from MinIO.
#
#   scripts/simulate-fleet [--servers 3] [--regions "California,Nevada,Arizona"]
#   scripts/simulate-fleet --down            # tear down a previous simulation
#
# Uses the running full-stack's bundled MinIO+MongoDB as the shared infra,
# addressed by this host's LAN IP (reachable from host AND containers).
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${REPO}/.venv/bin/python3"; [[ -x "$PY" ]] || PY=python3
SERVERS=3
REGIONS="California,Nevada,Arizona"
DOWN=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --servers) SERVERS="$2"; shift 2 ;;
        --regions) REGIONS="$2"; shift 2 ;;
        --down) DOWN=1; shift ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

teardown() {
    echo "== tearing down sim servers =="
    for i in $(seq 1 6); do
        ids=$(docker ps -aq --filter "label=com.docker.compose.project=fleet-srv$i" 2>/dev/null)
        [[ -n "$ids" ]] && docker rm -f $ids >/dev/null 2>&1 || true
    done
    "$PY" -c "from pymongo import MongoClient; MongoClient('mongodb://localhost:27017')['facetwork'].fleet_agents.delete_many({'_id':{'\$regex':'^fleet-srv'}})" 2>/dev/null || true
    echo "  removed fleet-srv* containers + agent records"
}
if [[ "$DOWN" == "1" ]]; then teardown; exit 0; fi

IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')
MONGO="mongodb://$IP:27017"
MINIO="http://$IP:9000"
echo "== shared infra (this host, reachable from host + containers): MinIO=$MINIO  MongoDB=$MONGO =="

# Preconditions: the bundled infra must be up.
"$PY" - "$IP" <<'PY' || { echo "ERROR: shared MinIO/MongoDB not reachable — is the full stack up?"; exit 1; }
import socket, sys
for p in (9000, 27017):
    socket.create_connection((sys.argv[1], p), timeout=4).close()
PY

trap 'echo; echo "(leaving sim servers up; run: scripts/simulate-fleet --down)"' EXIT

echo "== 1) central config + encrypted secret (set ONCE) =="
"$REPO/scripts/fleet" set --mongo "$MONGO" --minio "$MINIO" --osm-replicas 1 --task-list osm >/dev/null
KEY=$("$REPO/scripts/fleet" secret gen-key 2>/dev/null)
export AFL_FLEET_KEY="$KEY"
"$REPO/scripts/fleet" secret set --mongo "$MONGO" --minio-access minioadmin --minio-secret minioadmin >/dev/null
echo "  fleet_config set; MinIO creds encrypted (fleet key generated)"

echo "== 2) bring up $SERVERS servers — each a fleet-agent reading the central config =="
for i in $(seq 1 "$SERVERS"); do
    echo "  -- server fleet-srv$i --"
    if out=$(COMPOSE_PROJECT_NAME="fleet-srv$i" \
             AFL_FLEET_HOST="fleet-srv$i" \
             AFL_FLEET_KEY="$KEY" \
             AFL_WORKER_EXTRA_COMPOSE="$REPO/docker-compose.sim.yml" \
             AFL_DATA_DIR="${AFL_DATA_DIR:-/Volumes/afl_data}/sim-srv$i" \
             "$REPO/scripts/fleet-agent" apply --mongo "$MONGO" 2>&1); then
        printf '%s\n' "$out" | grep -iE "applying|Started" | head -3 | sed 's/^/    /' || true
    else
        echo "    ERROR bringing up fleet-srv$i:"; printf '%s\n' "$out" | tail -6 | sed 's/^/    /'; exit 1
    fi
done

echo "== 3) wait for $SERVERS servers to register, then fleet status =="
for _t in $(seq 1 40); do
    n=$("$PY" -c "from pymongo import MongoClient; ss=MongoClient('$MONGO')['facetwork'].servers.find({'state':'running','server_name':{'\$regex':'^fleet-srv'}}); print(len(set(s['server_name'] for s in ss)))" 2>/dev/null || echo 0)
    [[ "$n" -ge "$SERVERS" ]] && break
    sleep 3
done
"$REPO/scripts/fleet" status --mongo "$MONGO"

echo "== done bringing up the fleet. Submit a fan-out next (run-fanout step in the parent). =="
echo "FLEET_SIM_READY mongo=$MONGO minio=$MINIO key=$KEY"
