#!/usr/bin/env bash
# fleet-env-migrate — split this server's .env.fleet into the shared base
# (.env.fleet, a clean copy of .env.fleet.preset) + per-server overrides
# (.env.fleet.override). Moves ONLY the known per-server keys into the override;
# everything else then comes from the committed preset, so a drifted SHARED value
# (e.g. AFL_MONGODB_URL pointing at a host-only name) can't survive the migration.
#
# Safe: it only rewrites the two env files (backing up what it replaces). It does
# NOT touch running containers — recreate yourself afterwards:
#     scripts/start-runner --fleet --recreate
#
# Usage:  scripts/fleet-env-migrate [--dry-run]
set -euo pipefail
cd "$(dirname "$0")/.."

DRY=0
[[ "${1:-}" == "--dry-run" || "${1:-}" == "--dry" ]] && DRY=1

[[ -f .env.fleet.preset ]] || { echo "ERROR: .env.fleet.preset not found (git pull?)" >&2; exit 1; }
[[ -f .env.fleet ]] || { echo "ERROR: no .env.fleet here — nothing to migrate." >&2; exit 1; }

# Keys that are legitimately per-server. Everything else is shared → preset.
PER_SERVER=(AFL_DATA_DIR AFL_OSM_REPLICAS AFL_RUNNER_NAME AFL_FLEET_HOST AFL_POSTGIS_URL)

OVR_FILE=".env.fleet.override"
# Existing override values WIN (they're the per-server source of truth); fall
# back to the current .env.fleet for any per-server key not already overridden.
_get_ovr()   { [[ -f "$OVR_FILE" ]] && sed -n "s/^$1=//p" "$OVR_FILE" | tail -1; }
_get_fleet() { sed -n "s/^$1=//p" .env.fleet | tail -1; }

OVR_BODY=""
for k in "${PER_SERVER[@]}"; do
    v="$(_get_ovr "$k")"; [[ -n "$v" ]] || v="$(_get_fleet "$k")"
    [[ -n "$v" ]] && OVR_BODY+="$k=$v"$'\n'
done

# Ensure this host names itself correctly (the server2-as-server3 class of bug):
# if neither AFL_RUNNER_NAME nor AFL_FLEET_HOST is set, pin AFL_RUNNER_NAME to
# this machine's short hostname so it can't inherit a clone's name.
if ! grep -qE '^AFL_(RUNNER_NAME|FLEET_HOST)=' <<<"$OVR_BODY"; then
    OVR_BODY+="AFL_RUNNER_NAME=$(hostname -s 2>/dev/null || hostname)"$'\n'
fi

HEADER="# .env.fleet.override — per-server values (generated by scripts/fleet-env-migrate)
# Shared values come from .env.fleet (a copy of .env.fleet.preset); these win on top.
"

echo "=== per-server values → $OVR_FILE ==="
printf '%s' "$OVR_BODY" | sed 's/^/  /'
echo "=== .env.fleet → reset to .env.fleet.preset (shared base) ==="
echo "  (drifted shared values in the old .env.fleet are dropped — preset wins)"

if [[ "$DRY" == "1" ]]; then
    echo
    echo "(dry-run — no files changed). Re-run without --dry-run to apply."
    exit 0
fi

# Back up whatever we replace, then write.
cp -p .env.fleet ".env.fleet.bak"
[[ -f "$OVR_FILE" ]] && cp -p "$OVR_FILE" "$OVR_FILE.bak"
printf '%s%s' "$HEADER" "$OVR_BODY" > "$OVR_FILE"
cp .env.fleet.preset .env.fleet

echo
echo "Done. Wrote $OVR_FILE and reset .env.fleet (backups: .env.fleet.bak"
[[ -f "$OVR_FILE.bak" ]] && echo -n ", $OVR_FILE.bak"
echo ")."
echo "Now recreate this host's runners to apply:"
echo "    scripts/start-runner --fleet --recreate"
