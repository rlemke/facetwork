#!/usr/bin/env python3
"""fleet-advertise — advertise this host's MongoDB + MinIO over mDNS so fleet
agents on the same LAN discover them with zero config (no /etc/hosts entry, no
--mongo). Run on the server hosting the shared MongoDB + MinIO.

  fleet-advertise [--ip A.B.C.D] [--mongo-port 27017] [--minio-port 9000]

Requires `zeroconf` (pip install zeroconf). If you'd rather not run mDNS, the
conventional `afl-mongodb` / `afl-minio` hostnames in DNS or /etc/hosts work just
as well — `fleet-agent` discovery falls back to them automatically.
"""
from __future__ import annotations

import argparse
import socket
import sys


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--ip", help="advertised IP (default: this host's primary IP)")
    p.add_argument("--mongo-port", type=int, default=27017)
    p.add_argument("--minio-port", type=int, default=9000)
    a = p.parse_args()

    try:
        from zeroconf import ServiceInfo, Zeroconf
    except ImportError:
        sys.exit("zeroconf not installed — `pip install zeroconf`, or use /etc/hosts entries "
                 "(afl-mongodb, afl-minio); fleet-agent discovery falls back to those.")

    ip = a.ip
    if not ip:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            s.connect(("8.8.8.8", 80))
            ip = s.getsockname()[0]
        finally:
            s.close()
    addr = socket.inet_aton(ip)

    infos = [
        ServiceInfo("_afl-mongo._tcp.local.", "facetwork-mongo._afl-mongo._tcp.local.",
                    addresses=[addr], port=a.mongo_port, properties={}),
        ServiceInfo("_afl-minio._tcp.local.", "facetwork-minio._afl-minio._tcp.local.",
                    addresses=[addr], port=a.minio_port, properties={}),
    ]
    zc = Zeroconf()
    for info in infos:
        zc.register_service(info)
    print(f"advertising MongoDB :{a.mongo_port} + MinIO :{a.minio_port} at {ip} via mDNS (Ctrl-C to stop)")
    try:
        import signal
        signal.pause()
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        for info in infos:
            zc.unregister_service(info)
        zc.close()
        print("\nstopped advertising.")


if __name__ == "__main__":
    main()
