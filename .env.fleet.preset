# .env.fleet.preset — READY-TO-USE SHARED config for joining THIS fleet.
# Copy to .env.fleet on each new server:  cp .env.fleet.preset .env.fleet
#
# LAYERING: keep ONLY fleet-wide values here. Put each server's specifics
# (FW_DATA_DIR, FW_OSM_REPLICAS, a per-host FW_INFRA_IP) in `.env.fleet.override`
# instead (see .env.fleet.override.example). `start-runner --fleet` loads
# .env.fleet then .env.fleet.override ON TOP (override wins), and the override is
# gitignored — so when this preset changes you just re-copy it and the per-server
# values survive:  git pull && cp .env.fleet.preset .env.fleet
#
# Shared MinIO + MongoDB run on the INFRA HOST below. USE THE INFRA HOST'S IP in
# the two URLs below — NOT a `.local`/mDNS name (e.g. server3.local). The runners
# run in Docker containers; Docker's DNS does NOT resolve mDNS/.local names and
# containers don't read the host's /etc/hosts, so a `.local` name works for
# `fleet status` (runs on the host) but the RUNNER CONTAINER can't reach it and
# never registers — the #1 "my runner doesn't show up" cause.
#
# You normally set NOTHING host-specific here for addressing: FW_INFRA_HOST (a
# stable NAME, default server3.local) is resolved to the infra host's CURRENT IP
# by `fw runner start` at launch and exported as FW_INFRA_IP for the container
# extra_hosts. So when the infra host's DHCP lease changes, the fleet follows the
# NAME automatically — no edit here, in the wrapper, or in fleet_config. Override
# the name with FW_INFRA_HOST=<name>, or pin an address with FW_INFRA_HOST="" +
# FW_INFRA_IP=<ip> (e.g. on a subnet where mDNS/.local doesn't resolve).
#
# Infra host: server3 (addressed by name server3.local)

# --- shared MongoDB (fleet coordinator) ---
FW_MONGODB_URL=mongodb://afl-mongodb:27017
FW_MONGODB_DATABASE=facetwork

# Infra host addressing for the afl-mongodb/afl-minio CONTAINER aliases.
# `fw runner start` resolves this NAME (mDNS/DNS) to the infra host's current IP
# and exports FW_INFRA_IP for the container extra_hosts — so the fleet tracks the
# infra host by name even when its address drifts. Containers can't resolve
# .local themselves, which is why the host resolves it for them.
FW_INFRA_HOST=server3.local

# --- shared object store (durable cache + outputs) — the fleet default ---
FW_STORAGE=s3
FW_DATA_ROOT=s3://afl-cache
FW_S3_ENDPOINT=http://afl-minio:9000
FW_S3_ACCESS_KEY=minioadmin
FW_S3_SECRET_KEY=minioadmin
FW_S3_BUCKET=afl-cache

# --- PER-SERVER values → set these in .env.fleet.override, NOT here ---------
# FW_DATA_DIR (this host's large local scratch disk) and FW_OSM_REPLICAS are
# server-specific. Putting them in .env.fleet.override (gitignored, loaded on top)
# keeps them out of the shared base so re-copying this preset never clobbers them.
# See .env.fleet.override.example. Left here only as inert fallbacks:
FW_DATA_DIR=
FW_OSM_REPLICAS=3
