# .env.fleet.preset — READY-TO-USE SHARED config for joining THIS fleet.
# Copy to .env.fleet on each new server:  cp .env.fleet.preset .env.fleet
#
# LAYERING: keep ONLY fleet-wide values here. Put each server's specifics
# (AFL_DATA_DIR, AFL_OSM_REPLICAS, a per-host AFL_INFRA_IP) in `.env.fleet.override`
# instead (see .env.fleet.override.example). `start-runner --fleet` loads
# .env.fleet then .env.fleet.override ON TOP (override wins), and the override is
# gitignored — so when this preset changes you just re-copy it and the per-server
# values survive:  git pull && cp .env.fleet.preset .env.fleet
#
# Shared MinIO + MongoDB run on the INFRA HOST below. USE THE INFRA HOST'S IP in
# the two URLs below — NOT a `.local`/mDNS name (e.g. server3.local). The runners
# run in Docker containers; Docker's DNS does NOT resolve mDNS/.local names and
# containers don't read the host's /etc/hosts, so a `.local` name works for
# `fleet status` (runs on the host) but the RUNNER CONTAINER can't reach it and
# never registers — the #1 "my runner doesn't show up" cause.
#
# If the infra host IP changes, update it here (one place). To use a stable NAME
# instead of an IP, set AFL_INFRA_IP=<infra host IP> below and switch the URLs to
# mongodb://afl-mongodb:27017 + http://afl-minio:9000 — docker-compose.fleet.yml
# maps those names inside the containers via extra_hosts.
#
# Infra host as of 2026-06-14: server3 @ 192.168.68.96

# --- shared MongoDB (fleet coordinator) ---
AFL_MONGODB_URL=mongodb://afl-mongodb:27017
AFL_MONGODB_DATABASE=facetwork

# Infra host IP for the afl-mongodb/afl-minio CONTAINER aliases (extra_hosts).
# This MUST be the infra host's IP (NOT a name) — it's what afl-mongodb/afl-minio
# resolve to inside the runner containers. docker-compose.fleet.yml also defaults
# this to 192.168.68.96, so a plain `git pull` + restart works without editing it.
AFL_INFRA_IP=192.168.68.96

# --- shared object store (durable cache + outputs) — the fleet default ---
AFL_STORAGE=s3
AFL_DATA_ROOT=s3://afl-cache
AFL_S3_ENDPOINT=http://afl-minio:9000
AFL_S3_ACCESS_KEY=minioadmin
AFL_S3_SECRET_KEY=minioadmin
AFL_S3_BUCKET=afl-cache

# --- PER-SERVER values → set these in .env.fleet.override, NOT here ---------
# AFL_DATA_DIR (this host's large local scratch disk) and AFL_OSM_REPLICAS are
# server-specific. Putting them in .env.fleet.override (gitignored, loaded on top)
# keeps them out of the shared base so re-copying this preset never clobbers them.
# See .env.fleet.override.example. Left here only as inert fallbacks:
AFL_DATA_DIR=
AFL_OSM_REPLICAS=3
