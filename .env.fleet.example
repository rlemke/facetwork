# .env.fleet — config for a RUNNER server joining an existing Facetwork fleet.
#
# This host runs runners ONLY. MinIO + MongoDB are SHARED, external services
# (one fleet-wide instance of each), reachable over the network from here. The
# runners coordinate through the shared MongoDB and read/write durable cache +
# outputs through the shared MinIO — so a leaf produced here, and the merge run
# anywhere, all see the same s3:// objects. No shared disk is needed.
#
# Copy to `.env.fleet`, edit the endpoints, then:  fw runner start --fleet
#   (default runners: osm-geocoder + osm-lz; add --example NAME for others)

# --- shared MongoDB (the fleet coordinator) — REQUIRED ---------------------
# Point at the server hosting MongoDB. Either a hostname in /etc/hosts
# (e.g. afl-mongodb -> 192.168.x.x) or an explicit host:port.
AFL_MONGODB_URL=mongodb://afl-mongodb:27017
AFL_MONGODB_DATABASE=facetwork

# --- shared object store (durable cache + outputs) — REQUIRED --------------
# The fleet default: durable cache + outputs go to the shared MinIO, so a leaf
# produced on any host and the merge run anywhere resolve the same s3:// objects.
# Endpoint must be reachable from this host (NOT localhost unless MinIO runs
# here too); for AWS S3 use the real endpoint + creds and drop AFL_S3_ENDPOINT.
AFL_STORAGE=s3
AFL_DATA_ROOT=s3://afl-cache
AFL_S3_ENDPOINT=http://afl-minio:9000
AFL_S3_ACCESS_KEY=minioadmin
AFL_S3_SECRET_KEY=minioadmin
AFL_S3_BUCKET=afl-cache

# --- this server's LOCAL scratch (large local disk) ------------------------
# REQUIRED, per-server: a large local POSIX path THIS server can write. Staging /
# in-flight downloads stay local here; only finalized objects go to the shared
# MinIO. Ships empty on purpose — set your own. Do NOT use /Volumes/afl_data
# (that's the infra host's disk; on macOS only root can mkdir under /Volumes).
#   macOS: e.g. $HOME/afl_data (mkdir -p first)   Linux: e.g. /var/lib/afl_data
AFL_DATA_DIR=

# --- how many osm runners to start on this server --------------------------
# Each runner is one concurrent leaf extraction. Size to this host's cores/RAM.
AFL_OSM_REPLICAS=4

# --- optional: external PostGIS (only for PostGIS imports; heatmaps don't
#     need it). Leave commented for a heatmap/extract worker.
# AFL_POSTGIS_URL=postgresql://afl:afl@afl-postgres:5432/afl_gis
