// Reproducing a DERIVED PRODUCT from the inputs it is documented to derive from.
//
// The GIAB study (examples/repro-giab) compared two published artifacts. This
// is the stronger claim: NOAA publishes both the raw daily observations
// (GHCN-Daily) and the 1991-2020 Climate Normals computed from them. Recomputing
// the normals tests the METHOD, not just whether two files differ.
//
//   fw ffl run --primary examples/repro-normals/noaa_normals_repro.ffl \
//              --workflow repro.normals.ReproduceStationNormals
//
// ⚠️ ABSOLUTE tolerance, not relative. Fahrenheit is an INTERVAL scale — its
// zero is arbitrary — so "within 2%" has no physical meaning. The first run
// used a 2% relative tolerance and Chicago's constant -0.9 degF TAVG error
// FAILED in January (2% of 25.2 = 0.50) and PASSED in July (2% of 77.5 = 1.55):
// same error, opposite verdict, purely seasonal. 0.2 degF is a claim about
// measurement agreement that means the same thing in every month.
//
// ⚠️ THE FINDING THIS STUDY EXISTS FOR. Every recomputed value lands inside a
// generous tolerance, so `agree` is true and the reproduction "succeeds" — yet
// TMAX is high in ALL 12 months and TMIN low in ALL 12, by a near-constant
// amount (measured at USW00094728: +0.24 and -0.51 degF). A tolerance is a
// per-value predicate and cannot see that. `systematic_bias` can, via an exact
// sign test per column, and BOTH results are reported: the reproduction met the
// stated tolerance AND the method demonstrably differs.
//
// ⚠️ The likely cause is a unit round-trip, not an error by either party. US
// first-order stations record whole degrees F; GHCN-Daily archives tenths of a
// degree C. NOAA computes normals from the original observations, we recompute
// from the round-tripped archive, and the rounding does not commute. That is
// exactly the kind of difference a reproduction study should surface and a
// pass/fail check cannot.
//
// ⚠️ NO HANDLER AND NO DOMAIN. The recomputation is a `script` bound to
// `fw.file.FileOps`, which supplies fsspec — a bare script block cannot open a
// file. The 18 MB input is read INSIDE the script rather than passed through a
// step payload, which would exceed Mongo's 16 MB document limit.
//
// ⚠️ PARSE CSV WITH `csv`, NEVER WITH A REGEX. The first version of this file
// used `re.findall(r'"([^"]*)"')` because `csv` was not on the sandbox
// allowlist. It SILENTLY produced wrong numbers: a GHCN row carries 124 fields
// of which only ~30 are quoted, so every unquoted empty was skipped and each
// subsequent field shifted. January TMAX came out 37.59 instead of 39.73 — a
// plausible temperature, no error raised. `csv` was added to the allowlist in
// the same change (it is pure stdlib parsing, exactly like `json`).

namespace repro.normals {

    /** Recompute monthly TMAX/TMIN/TAVG normals from daily observations.
      *
      * Reads GHCN-Daily, keeps the 1991-2020 window, averages per calendar
      * month, converts tenths-degC to degF, and writes month,TMAX,TMIN,TAVG. */
    event facet ComputeNormals(
        daily: String,
        dest: String,
        start_year: String = "1991",
        end_year: String = "2020"
    ) => (path: String, days: Long, months: Long) in environment fw.file.FileOps
    script {
        import csv
        import collections
        import statistics
        import fsspec

        with fsspec.open(params["daily"], "rt") as fh:
            rows = list(csv.DictReader(fh))

        lo, hi = params["start_year"], params["end_year"]
        buckets = collections.defaultdict(lambda: collections.defaultdict(list))
        days = 0
        for r in rows:
            date = r.get("DATE", "")
            if not (lo <= date[:4] <= hi):
                continue
            days += 1
            for fld in ("TMAX", "TMIN"):
                v = (r.get(fld) or "").strip()
                if v:
                    buckets[date[5:7]][fld].append(float(v))

        # tenths of a degree C -> degrees F
        def to_f(tenths_c):
            return (tenths_c / 10.0) * 9.0 / 5.0 + 32.0

        out = ["month,TMAX,TMIN,TAVG"]
        for m in sorted(buckets):
            b = buckets[m]
            if not b["TMAX"] or not b["TMIN"]:
                continue
            x = to_f(statistics.mean(b["TMAX"]))
            n = to_f(statistics.mean(b["TMIN"]))
            out.append("%s,%.2f,%.2f,%.2f" % (m, x, n, (x + n) / 2.0))

        with fsspec.open(params["dest"], "wt") as fh:
            fh.write("\n".join(out) + "\n")

        # ⚠️ MUTATE `result`, never rebind it. `result = {...}` creates a new
        # local and leaves the dict the worker serialises EMPTY — the script
        # completes, the step goes Complete, and every downstream reference
        # fails with "Attribute 'path' not found". Cost a full fleet run.
        result["path"] = params["dest"]
        result["days"] = days
        result["months"] = len(out) - 1
    }

    /** Project NOAA's published normals onto the same four columns.
      *
      * ⚠️ A PROJECTION, NOT A COMPUTATION. The published file carries 413
      * columns; this renames three of them and does no arithmetic, so the
      * comparison stays between OUR method and THEIR result. Any transformation
      * applied to the reference side would weaken the claim, so there is none. */
    event facet ExtractPublished(
        published: String,
        dest: String
    ) => (path: String, months: Long) in environment fw.file.FileOps
    script {
        import csv
        import fsspec

        with fsspec.open(params["published"], "rt") as fh:
            rows = list(csv.DictReader(fh))

        out = ["month,TMAX,TMIN,TAVG"]
        for r in rows:
            if not (r.get("MLY-TAVG-NORMAL") or "").strip():
                continue
            out.append("%s,%s,%s,%s" % (
                r["month"].strip(),
                r["MLY-TMAX-NORMAL"].strip(),
                r["MLY-TMIN-NORMAL"].strip(),
                r["MLY-TAVG-NORMAL"].strip()))

        with fsspec.open(params["dest"], "wt") as fh:
            fh.write("\n".join(out) + "\n")

        result["path"] = params["dest"]          # mutate, never rebind
        result["months"] = len(out) - 1
    }

    workflow ReproduceStationNormals(
        station: String = "USW00094728",
        daily_url: String = "https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/access/USW00094728.csv",
        normals_url: String = "https://www.ncei.noaa.gov/data/normals-monthly/1991-2020/access/USW00094728.csv",
        daily_dest: String = "s3://afl-cache/repro/normals/USW00094728-daily.csv",
        normals_dest: String = "s3://afl-cache/repro/normals/USW00094728-published.csv",
        ours_dest: String = "s3://afl-cache/repro/normals/USW00094728-recomputed.csv",
        theirs_dest: String = "s3://afl-cache/repro/normals/USW00094728-reference.csv",
        report_dest: String = "s3://afl-cache/repro/normals/USW00094728-report.md",
        abs_tolerance: Double = 0.2
    ) => (
        level: String, agree: Boolean, differing: Long,
        systematic_bias: Boolean, mean_residual: Double, report: String
    ) andThen {

        // 1. ACQUIRE both published artifacts, with provenance sidecars.
        //    ⚠️ s3:// on purpose — the steps may be claimed by different hosts.
        daily = fw.http.Fetch(url = $.daily_url, dest = $.daily_dest, max_age_hours = 168)
        published = fw.http.Fetch(url = $.normals_url, dest = $.normals_dest, max_age_hours = 168)

        // 2. RECOMPUTE from the raw observations, and project the published
        //    product onto the same shape.
        ours = repro.normals.ComputeNormals(daily = daily.path, dest = $.ours_dest)
        theirs = repro.normals.ExtractPublished(published = published.path, dest = $.theirs_dest)

        // 3. COMPARE. `tolerance` states what counts as reproduced; the sign
        //    test says whether what remains is noise or method.
        diff = fw.compare.Tabular(
            expected = theirs.path,
            actual = ours.path,
            key_columns = ["month"],
            abs_tolerance = $.abs_tolerance,
            max_examples = 12,
            report = $.report_dest
        )

        yield ReproduceStationNormals(
            level = diff.level,
            agree = diff.agree,
            differing = diff.differing,
            systematic_bias = diff.systematic_bias,
            mean_residual = diff.mean_residual,
            report = diff.report
        )
    }

    /** Build the per-station URLs and destinations.
      *
      * ⚠️ A plain `facet`, NOT an `event facet`. Pure computation with no
      * environment runs INLINE in the evaluator. Declared as `event facet` it
      * becomes a task stamped with neither `kind="script"` nor an environment
      * hash — claimable by neither the handler path nor the env-routed script
      * path — and sits pending forever. Verified: four such tasks stayed
      * pending across 85 runners. The canonical example
      * (11-environment-script.ffl) is a plain `facet` for the same reason. */
    facet StationPaths(station: String) => (
        daily_url: String, normals_url: String,
        daily_dest: String, normals_dest: String,
        ours_dest: String, theirs_dest: String, report_dest: String
    ) script {
        s = params["station"]
        ghcn = "https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/access/"
        norm = "https://www.ncei.noaa.gov/data/normals-monthly/1991-2020/access/"
        base = "s3://afl-cache/repro/normals/" + s
        result["daily_url"] = ghcn + s + ".csv"
        result["normals_url"] = norm + s + ".csv"
        result["daily_dest"] = base + "-daily.csv"
        result["normals_dest"] = base + "-published.csv"
        result["ours_dest"] = base + "-recomputed.csv"
        result["theirs_dest"] = base + "-reference.csv"
        result["report_dest"] = base + "-report.md"
    }

    /** Reproduce the normals for MANY stations and report where the bias holds.
      *
      * The single-station study showed TMAX high and TMIN low in all 12 months.
      * One station cannot distinguish a universal artifact of the archive from
      * something particular to that instrument or era — this fans out so the
      * answer is measured rather than assumed.
      *
      * ⚠️ `limit` bounds how many stations are in flight: each iteration pulls
      * an ~18 MB daily file and the whole set would otherwise hit NOAA at once.
      * Same elements, same result, only concurrency changes. */
    workflow ReproduceManyStations(
        stations: [String] = [
            "USW00094728", "USW00023174", "USW00094846", "USW00012960",
            "USW00023169", "USW00024233", "USW00013874", "USW00014922",
            "USW00012839", "USW00003017", "USW00013881", "USW00093814"
        ],
        abs_tolerance: Double = 0.2,
        width: Long = 4
    ) => (
        stations_done: [String], biased: [Boolean], mean_residuals: [Double]
    ) andThen foreach st in $.stations limit $.width {

        paths = repro.normals.StationPaths(station = $.st)

        daily = fw.http.Fetch(url = paths.daily_url, dest = paths.daily_dest, max_age_hours = 168)
        published = fw.http.Fetch(url = paths.normals_url, dest = paths.normals_dest, max_age_hours = 168)

        ours = repro.normals.ComputeNormals(daily = daily.path, dest = paths.ours_dest)
        theirs = repro.normals.ExtractPublished(published = published.path, dest = paths.theirs_dest)

        diff = fw.compare.Tabular(
            expected = theirs.path,
            actual = ours.path,
            key_columns = ["month"],
            abs_tolerance = $.abs_tolerance,
            report = paths.report_dest
        )

        // `+=` AGGREGATES across iterations. A bare `=` keeps only the LAST
        // station and would silently report a 12-station fan-out as one.
        yield ReproduceManyStations(
            stations_done += [$.st],
            biased += [diff.systematic_bias],
            mean_residuals += [diff.mean_residual]
        )
    }
}
