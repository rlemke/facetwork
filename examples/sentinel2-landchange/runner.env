# Runner tuning for the sentinel2-landchange example.
#
# Tasks for facets under the `s2` top-level namespace are routed to the `s2`
# task list (derived from the namespace, never configured), so a runner started
# with --example sentinel2-landchange polls `s2` and claims only its own work.
#
# COG window-reads + compositing are blocking I/O; once the real raster path
# lands, prefer the global execution timeout over per-step heartbeats for the
# fetch/composite facets. Generous timeouts here cover a real (non-mock) run.
AFL_TASK_EXECUTION_TIMEOUT_MS=1800000
AFL_STUCK_TIMEOUT_MS=3600000
