// A REAL reproduction study, composed entirely from built-in facets.
//
// Question: Genome in a Bottle is the reference truth set for validating
// variant callers. NIST has published several releases. If a lab validated its
// caller against HG001 v3.3.2, does that validation still hold on v4.2.1?
//
// Answering it needs no domain handlers at all — fw.http acquires, fw.compare
// compares, fw.compare.Summarise documents. That is the point: "retrieve a
// published dataset, rerun, compare, document discrepancies" is a SHAPE, and
// the shape ships with Facetwork.
//
//   fw ffl run --primary examples/repro-giab/giab_benchmark_diff.ffl \
//              --workflow repro.giab.CompareBenchmarkReleases
//
// ⚠️ dest paths are s3:// ON PURPOSE. The two fetches and the comparison are
// separate steps and may be claimed by DIFFERENT hosts; /scratch is host-local,
// so a local dest would leave the comparison looking for a file that exists on
// another machine. Portable URIs are what make a step boundary host-agnostic.
//
// ⚠️ The comparison keys on (CHROM, POS, REF, ALT) — the identity of a variant.
// Without a key, records would be matched BY POSITION IN THE FILE, and since
// the releases differ in which sites they contain, every record after the first
// difference would misalign and report as changed.
//
// ⚠️ VCF `##` metadata is not compared. It carries the producing command line
// and reference paths, which differ between any two runs without a single
// variant differing.

namespace repro.giab {

    workflow CompareBenchmarkReleases(
        old_url: String = "https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/release/NA12878_HG001/NISTv3.3.2/GRCh38/HG001_GRCh38_GIAB_highconf_CG-IllFB-IllGATKHC-Ion-10X-SOLID_CHROM1-X_v.3.3.2_highconf_PGandRTGphasetransfer.vcf.gz",
        new_url: String = "https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/release/NA12878_HG001/NISTv4.2.1/GRCh38/HG001_GRCh38_1_22_v4.2.1_benchmark.vcf.gz",
        old_dest: String = "s3://afl-cache/repro/giab/HG001_GRCh38_v3.3.2.vcf.gz",
        new_dest: String = "s3://afl-cache/repro/giab/HG001_GRCh38_v4.2.1.vcf.gz",
        report_dest: String = "s3://afl-cache/repro/giab/HG001_v332_vs_v421.md"
    ) => (level: String, agree: Boolean, differing: Long, report: String) andThen {

        // 1. ACQUIRE both published releases. Fetch writes a provenance sidecar
        //    (digest, source URL, validators, fetched_at) beside each, so the
        //    report can cite exactly which bytes were compared.
        old_release = fw.http.Fetch(url = $.old_url, dest = $.old_dest, max_age_hours = 168)
        new_release = fw.http.Fetch(url = $.new_url, dest = $.new_dest, max_age_hours = 168)

        // 2. COMPARE. The verdict is a LEVEL, not a boolean: two releases of the
        //    same benchmark are expected to differ, and the useful answer is
        //    WHERE on the ladder they stop agreeing.
        diff = fw.compare.Tabular(
            expected = old_release.path,
            actual = new_release.path,
            key_columns = ["CHROM", "POS", "REF", "ALT"],
            ignore_columns = ["QUAL", "INFO", "FORMAT", "ID"],
            max_examples = 12
        )

        // 3. DOCUMENT.
        summary = fw.compare.Summarise(
            verdicts = [],
            title = "GIAB HG001 GRCh38 — benchmark v3.3.2 vs v4.2.1",
            report = $.report_dest
        ) after diff

        yield CompareBenchmarkReleases(
            level = diff.level,
            agree = diff.agree,
            differing = diff.differing,
            report = summary.report
        )
    }
}
