// Nextflow settings for the state-capitals fan-out.

// Keep the work dir inside the run's own directory so `rm -rf runs/` is a
// complete reset. At the default it lands in the repo and survives a wipe,
// quietly turning the next "cold" run into a resumed one.
workDir = "${params.outdir}/work"

// Per-task timings — 50 fan-out tasks plus the fetch and the combine. This is
// what makes the fan-out's per-task cost visible rather than just its total.
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    fields = 'name,tag,status,exit,realtime,duration'
    overwrite = true
}

process {
    errorStrategy = 'terminate'
}
