// Nextflow settings for the nuclear-map comparison.

// Keep Nextflow's work dir inside the run's own directory so `rm -rf runs/` is
// a complete reset. Left at the default it lands in the repo and survives a
// wipe, which quietly turns the next "cold" run into a resumed one.
workDir = "${params.outdir}/work"

// Per-process timings — the counterpart of Snakemake's `benchmark:` directive,
// so the two engines can be compared stage by stage and not just end to end.
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
    fields = 'name,status,exit,realtime,duration,%cpu,peak_rss'
    overwrite = true
}

// Plain output: this is driven from a script, and the ANSI progress display
// rewrites lines in a way that makes captured logs unreadable.
process {
    errorStrategy = 'terminate'
}
